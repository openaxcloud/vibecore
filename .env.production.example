# VibeCore production environment template.
# Copy to your production secret store, not to a committed .env file.
# `pnpm run production:validate` must pass before release.

VALIDATE_PRODUCTION=1

# Core services
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/vibecore
REDIS_URL=rediss://REDIS_HOST:6379
JWT_SECRET=
COOKIE_SECRET=
CONFIG_ENCRYPTION_KEY=
WORKSPACE_AGENT_TOKEN_SECRET=

# Runtime
VITE_RUNTIME_MODE=remote-kubernetes
VITE_RUNTIME_API_BASE_URL=https://api.example.com/api/runtime
WORKSPACE_MANAGER_URL=https://workspace-manager.example.com
WORKSPACE_RUNTIME_NAMESPACE=workspaces
# Must stay unset or 0 in production. `1` disables sandbox node scheduling and
# fails `pnpm run production:validate`.
WORKSPACE_DISABLE_SANDBOX_SCHEDULING=0

# AI providers: at least one provider key/base URL is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
OLLAMA_BASE_URL=

# E-Code agent orchestration.
# The ai-gateway exposes `/v1/agent-runs`; production should route this through
# a private service URL protected by network policy and service auth.
ECODE_PARALLEL_SUBAGENTS_ENABLED=0
ECODE_SUBAGENT_EXECUTOR_URL=https://ai-gateway.example.com
ECODE_SUBAGENT_EXECUTOR_TOKEN=
ECODE_SUBAGENT_EXECUTOR_RATE_LIMIT_PER_MINUTE=30
ECODE_SUBAGENT_EXECUTOR_RATE_LIMIT_REDIS_PREFIX=vibecore

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.example.com/auth/oauth/google/callback
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://app.example.com/auth/oauth/github/callback
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_USERINFO_URL=https://api.github.com/user

# Microsoft Entra / generic OIDC
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://app.example.com/auth/oidc/callback
OIDC_ISSUER_URL=https://login.microsoftonline.com/TENANT_ID/v2.0
OIDC_AUTHORIZATION_URL=https://login.microsoftonline.com/TENANT_ID/oauth2/v2.0/authorize
OIDC_TOKEN_URL=https://login.microsoftonline.com/TENANT_ID/oauth2/v2.0/token
OIDC_USERINFO_URL=https://graph.microsoft.com/oidc/userinfo
OIDC_JWKS_URL=https://login.microsoftonline.com/TENANT_ID/discovery/v2.0/keys

# SAML SSO: configure either certificate-based SSO or metadata URL.
SAML_ENTITY_ID=https://app.example.com/auth/saml/metadata/ORG_ID
SAML_ACS_URL=https://app.example.com/auth/saml/ORG_ID/acs
SAML_SSO_URL=
SAML_X509_CERTIFICATE=
SAML_METADATA_URL=

# Transactional email: configure SMTP or HTTP email provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
EMAIL_FROM=no-reply@example.com
EMAIL_HTTP_ENDPOINT=
EMAIL_HTTP_TOKEN=
# Signing secret from the Resend dashboard for /webhooks/resend (whsec_<base64>).
# Without this the webhook returns 503 and delivery / bounce events are dropped.
RESEND_WEBHOOK_SECRET=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FREE_PRODUCT_ID=
STRIPE_FREE_PRICE_ID=
STRIPE_PRO_PRODUCT_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRODUCT_ID=
STRIPE_TEAM_PRICE_ID=
STRIPE_ENTERPRISE_PRODUCT_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# Deploy providers
# List only the providers enabled for beta/production traffic.
# static requires no external dispatch env; every non-static provider listed here
# must have the matching hook/token values below or production validation fails.
DEPLOYMENT_PROVIDERS_ENABLED=static
VERCEL_DEPLOY_HOOK_URL=
NETLIFY_BUILD_HOOK_URL=
CLOUDFLARE_DEPLOY_HOOK_URL=
GITHUB_DEPLOY_TOKEN=
GITHUB_PAGES_REPO=
GITHUB_PAGES_WORKFLOW=
GITHUB_PAGES_REF=main
CLOUD_RUN_BUILD_TRIGGER_URL=
CLOUD_RUN_SOURCE_BRANCH=main
DOCKER_BUILD_TRIGGER_URL=
DOCKER_SOURCE_BRANCH=main
DOCKER_REGISTRY_URL=
GCP_OAUTH_TOKEN=

# Durable provider-hook saga: every enabled non-static target must be dedicated
# to exactly one Vibecore project. Set only the pair for the enabled provider.
VERCEL_DEPLOY_TARGET_DEDICATED=false
VERCEL_DEPLOY_TARGET_VIBECORE_PROJECT_ID=
NETLIFY_DEPLOY_TARGET_DEDICATED=false
NETLIFY_DEPLOY_TARGET_VIBECORE_PROJECT_ID=
GITHUB_PAGES_TARGET_DEDICATED=false
GITHUB_PAGES_TARGET_VIBECORE_PROJECT_ID=
CLOUDFLARE_PAGES_TARGET_DEDICATED=false
CLOUDFLARE_PAGES_TARGET_VIBECORE_PROJECT_ID=
CLOUD_RUN_DEPLOY_TARGET_DEDICATED=false
CLOUD_RUN_DEPLOY_TARGET_VIBECORE_PROJECT_ID=
DOCKER_DEPLOY_TARGET_DEDICATED=false
DOCKER_DEPLOY_TARGET_VIBECORE_PROJECT_ID=

# SIEM and observability
SIEM_WEBHOOK_URL=
SIEM_SIGNING_SECRET=
OTEL_SERVICE_NAME=vibecore-api
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_REDACTION_ENABLED=true
SECURITY_CONTACT_EMAIL=security@example.com
INCIDENT_WEBHOOK_URL=

# Rotation, retention and compliance evidence
SECRET_ROTATION_OWNER=security@example.com
SECRET_ROTATION_CADENCE_DAYS=90
AUDIT_RETENTION_DAYS=730
SOC2_EVIDENCE_BUCKET=s3://example-soc2-evidence
BACKUP_ENCRYPTION_KEY=
PRODUCTION_RUNBOOK_OWNER=ops@example.com
