{
  "extends": "./tsconfig.package.node.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "~/*": ["app/*"] }
  },
  "include": [
    "playwright.config.ts",
    "playwright.config.preview.ts",
    "playwright.tpl-proof.config.ts",
    "scripts/**/*.ts",
    "app/lib/qa/tpl-proof-contract.spec.ts",
    "tests/e2e/tpl-proof-live.spec.ts"
  ],
  "exclude": [
    "**/.claude",
    "**/.claude/**",
    "**/.playwright-mcp",
    "**/.playwright-mcp/**",
    "**/.vibecore",
    "**/.vibecore/**",
    "**/.vibecore-project-storage",
    "**/.vibecore-project-storage/**",
    "**/.vibecore-static-deployments",
    "**/.vibecore-static-deployments/**",
    "build",
    "dist",
    "node_modules",
    "test-results",
    "tmp"
  ]
}
