{
  "rules": [
    {
      "selector": "html:has([data-ecode-static-shell]), html:has([data-ecode-static-shell]) body, html[data-ecode-public-chrome=\"homepage\"], html[data-ecode-public-chrome=\"homepage\"] body",
      "style": "overflow-x: clip;",
      "media": "",
