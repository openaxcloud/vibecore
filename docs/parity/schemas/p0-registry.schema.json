{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ecode/parity/p0-registry",
  "x-schemaVersion": 1,
  "x-repoCommit": "07ced1c56bdbcb3ce77e883704342b71a2ad0961",
  "title": "P0Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repoCommit",
    "p0s"
  ],
  "properties": {
    "schemaVersion": {},
    "repoCommit": {
      "type": "string"
    },
    "p0s": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "p0Id",
          "title",
          "priority",
          "owner",
          "status",
          "nextAction"
        ],
        "properties": {
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "status": {
            "enum": [
              "OPEN",
              "PROVEN",
              "CLOSED"
            ]
          }
        }
      }
    }
  }
}
