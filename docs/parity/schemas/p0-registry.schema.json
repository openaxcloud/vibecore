{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ecode/parity/p0-registry",
  "x-schemaVersion": 2,
  "x-repoCommit": "b774bfa38e881ebaa071fbf2c2fa9d72ab89efb5",
  "title": "P0Registry",
  "description": "v2 (2026-07-17, évaluation v5) : targetDate UNKNOWN INTERDIT — date ISO réelle obligatoire ; priority étendue pour tracer individuellement les 15 P0 du dernier audit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repoCommit",
    "p0s"
  ],
  "properties": {
    "schemaVersion": {},
    "repoCommit": {
      "type": "string"
    },
    "p0s": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "p0Id",
          "title",
          "priority",
          "owner",
          "status",
          "nextAction",
          "targetDate"
        ],
        "properties": {
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "status": {
            "enum": [
              "OPEN",
              "PROVEN",
              "CLOSED"
            ]
          },
          "targetDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Date ISO réelle. La valeur UNKNOWN est interdite (le validateur casse le build)."
          }
        }
      }
    }
  }
}
