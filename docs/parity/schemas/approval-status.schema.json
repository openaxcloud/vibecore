{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ecode/parity/approval-status",
  "x-schemaVersion": 4,
  "x-repoCommit": "19e48513",
  "title": "APPROVAL_STATUS",
  "description": "v4 (audit de réanalyse 2026-07-20) : échelle à 11 niveaux ; overallStatus ∈ {NOT_APPROVED, SCOPE_APPROVED} + highestPassedLevel (contigu) ; « approvalReady » ET « approved » interdits — une approbation vit dans APPROVALS.yaml avec périmètre + approbateur.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "generatedFrom",
    "algorithm",
    "overallStatus",
    "highestPassedLevel",
    "levels",
    "blocking",
    "conditions",
    "counts",
    "p0"
  ],
  "not": {
    "anyOf": [
      {
        "required": [
          "approvalReady"
        ]
      },
      {
        "required": [
          "approved"
        ]
      }
    ]
  },
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "algorithm": {
      "type": "string"
    },
    "levels": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "required": [
          "name",
          "passed",
          "reasons"
        ],
        "properties": {
          "name": {
            "enum": [
              "documentReconciled",
              "sourceBaselineReady",
              "registryUniverseReady",
              "contractsPresent",
              "contractsValidated",
              "implementationReady",
              "verticalBackendReady",
              "verticalUserJourneyReady",
              "betaReady",
              "publicLaunchReady",
              "parityBaselineReady"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "blocking": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conditions": {
      "description": "Les 6 signaux de base (audit v4 H) — conservés comme sous-calculs des niveaux.",
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "passed",
          "reasons"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "description": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "counts": {
      "type": "object"
    },
    "p0": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "p0Id",
          "derived"
        ],
        "properties": {
          "derived": {
            "enum": [
              "OPEN",
              "PROVEN",
              "CLOSED"
            ]
          }
        }
      }
    },
    "overallStatus": {
      "enum": [
        "NOT_APPROVED",
        "SCOPE_APPROVED"
      ]
    },
    "highestPassedLevel": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "documentReconciled",
            "sourceBaselineReady",
            "registryUniverseReady",
            "contractsPresent",
            "contractsValidated",
            "implementationReady",
            "verticalBackendReady",
            "verticalUserJourneyReady",
            "betaReady",
            "publicLaunchReady",
            "parityBaselineReady"
          ]
        }
      ]
    }
  }
}
