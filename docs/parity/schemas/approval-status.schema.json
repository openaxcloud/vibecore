{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ecode/parity/approval-status",
  "x-schemaVersion": 3,
  "x-repoCommit": "5ac64e52",
  "title": "APPROVAL_STATUS",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "generatedFrom",
    "algorithm",
    "readiness",
    "stages",
    "blocking",
    "conditions",
    "counts",
    "p0"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "algorithm": { "type": "string" },
    "approvalReady": {
      "not": {},
      "description": "FORBIDDEN — the blanket approvalReady was a coverage false positive. Use the 4-stage readiness."
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registryConformanceReady", "coreVerticalReady", "publicBetaReady", "parityBaselineReady"],
      "properties": {
        "registryConformanceReady": { "type": "boolean" },
        "coreVerticalReady": { "type": "boolean" },
        "publicBetaReady": { "type": "boolean" },
        "parityBaselineReady": { "type": "boolean" }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registryConformance", "coreVertical", "publicBeta", "parityBaseline"],
      "patternProperties": {
        "^(registryConformance|coreVertical|publicBeta|parityBaseline)$": {
          "type": "object",
          "required": ["ready", "conditions"],
          "properties": {
            "ready": { "type": "boolean" },
            "conditions": { "type": "array", "items": { "type": "object", "required": ["id", "description", "passed", "reasons"] } }
          }
        }
      }
    },
    "blocking": { "type": "array", "items": { "type": "string" } },
    "conditions": {
      "description": "All raw conditions (audit v4 H + 2026-07-17 hardening). Stage readiness = every stage condition passed.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "passed", "reasons"],
        "properties": {
          "id": { "type": "integer" },
          "description": { "type": "string" },
          "passed": { "type": "boolean" },
          "reasons": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "counts": { "type": "object" },
    "p0": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["p0Id", "derived"],
        "properties": { "derived": { "enum": ["OPEN", "PROVEN", "CLOSED"] } }
      }
    }
  }
}
