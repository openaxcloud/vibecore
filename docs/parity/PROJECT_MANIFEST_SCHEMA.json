{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ecode/parity/project-manifest",
  "x-schemaVersion": 3,
  "x-repoCommit": "0f668026",
  "title": "ProjectManifest",
  "description": "Source versionnée des composants, artifacts, bindings et scopes d'un Project (plan §5, P0-EX-08). Consommé par ProjectRevision (manifestDigest).",
  "type": "object",
  "required": [
    "manifestVersion",
    "projectId",
    "artifacts"
  ],
  "properties": {
    "manifestVersion": {
      "type": "integer",
      "minimum": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "artifactId",
          "kind",
          "sourceRoot"
        ],
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "WEB_APP",
              "MOBILE_APP",
              "DATA_VISUALIZATION",
              "SLIDE_DECK",
              "ANIMATION_VIDEO",
              "DESIGN",
              "EXPERIENCE_3D"
            ]
          },
          "sourceRoot": {
            "type": "string",
            "minLength": 1
          },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "componentId",
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "WEB_FRONTEND",
                    "API",
                    "SERVICE",
                    "WORKER",
                    "JOB",
                    "SHARED_PACKAGE",
                    "STATIC_SITE_COMPONENT"
                  ]
                },
                "componentId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "previewConfig": {
            "type": "object"
          },
          "publishConfig": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "sharedBackendBinding": {
      "type": "object"
    },
    "sharedDataBindings": {
      "type": "array"
    },
    "sharedStorageBindings": {
      "type": "array"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entitlementsRef": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "description": "au plus 1 MOBILE_APP par projet — CONTRAINTE EXÉCUTABLE (plus une simple description) ; le quota vit dans entitlementsRef, jamais codé en dur ailleurs",
      "properties": {
        "artifacts": {
          "contains": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "MOBILE_APP"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    }
  ],
  "x-reviewVerdict": "REFUSED — 0/14 contrats signés (lot 57febeab, OpenAI-Codex, 2026-07-20)",
  "x-reviewCloseCriterion": "v2 durci : additionalProperties false, allOf exécutable (≤1 MOBILE_APP via maxContains), minLength/minItems, PENDING_COMMIT purgé — re-soumettre à signature",
  "x-refusalReason": "accepte contre-exemples + PENDING_COMMIT (verbatim relecteur, transmis 20/07 — corrigé en v2 : x-repoCommit était littéralement la chaîne PENDING_COMMIT)",
  "additionalProperties": false,
  "x-contractId": "CTR-PROJECT-MANIFEST-SCHEMA",
  "x-contractVersion": 2,
  "x-expectedReviewer": "OpenAI-Codex",
  "x-signatureResult": "PENDING_REVIEW"
}
