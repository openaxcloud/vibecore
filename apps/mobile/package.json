{
  "name": "@vibecore/mobile",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "capacitor serve",
    "build": "vite build",
    "build:web": "vite build",
    "sync": "pnpm build:web && capacitor sync",
    "sync:android": "pnpm build:web && capacitor sync android",
    "sync:ios": "pnpm build:web && capacitor sync ios",
    "open:ios": "capacitor open ios",
    "open:android": "capacitor open android",
    "build:android": "pnpm sync:android && cd android && ./gradlew assembleDebug",
    "build:android:release": "pnpm sync:android && cd android && ./gradlew bundleRelease",
    "build:ios:docs": "node src/ios-build-docs.mjs",
    "validate": "node ../../scripts/validate-mobile-assets.mjs",
    "validate:release": "node ../../scripts/validate-mobile-assets.mjs --release",
    "release-assets": "node ../../scripts/generate-mobile-release-assets.mjs",
    "release-assets:check": "node ../../scripts/generate-mobile-release-assets.mjs --dry-run",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.3.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@vibecore/editor": "workspace:^"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
