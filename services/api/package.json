{
  "name": "@vibecore/api",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "@google-cloud/storage": "^7.14.0",
    "google-auth-library": "^9.15.1",
    "@vibecore/audit": "workspace:*",
    "@vibecore/auth": "workspace:*",
    "@vibecore/billing": "workspace:*",
    "@vibecore/database": "workspace:*",
    "@vibecore/k8s-client": "workspace:*",
    "@vibecore/observability": "workspace:*",
    "@vibecore/quota": "workspace:*",
    "@vibecore/rbac": "workspace:*",
    "@vibecore/security": "workspace:*",
    "@vibecore/template-catalog": "workspace:*",
    "@xmldom/xmldom": "^0.9.10",
    "bullmq": "^5.76.2",
    "gpt-tokenizer": "^3.4.0",
    "ioredis": "^5.10.1",
    "jszip": "^3.10.1",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "xml-crypto": "^6.1.2",
    "@e-code/sdk": "workspace:*"
  },
  "optionalDependencies": {
    "re2": "^1.24.1"
  },
  "scripts": {
    "predev": "pnpm --filter @vibecore/database db:deploy",
    "dev": "tsx watch --exclude '.vibecore/**' --exclude '.vibecore-project-storage/**' --exclude '.vibecore-static-deployments/**' src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest --run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo \"api lint covered by root\""
  }
}
