  risks        Json                 @default("[]")
  verification Json                 @default("[]")
  rawOutput    String?
  errorMessage String?
  startedAt    DateTime             @default(now())
  completedAt  DateTime?
  run          AgentRun             @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, roleId])
  @@index([runId])
