  framework          String?
  buildCommand       String?
  outputDirectory    String?
  branch             String?
  commitSha          String?
  customDomain       String?
  logs               Json                   @default("[]")
  metadata           Json                   @default("{}")
  rolledBackFromId   String?
  // P2d dev/prod split: when a preview/staging deployment is published to
  // production, the new production deployment links back to its source here.
  parentDeploymentId String?
  // Replit-parity deploy metering idempotency marker: set once the deployment is
  // metered (mirrors WorkspaceRuntime.lastMeteredAt) so a re-reconcile never
  // double-charges. Dormant/SHADOW until BILLING_CREDITS_ENABLED. See metering-service.ts.
  lastMeteredAt      DateTime?
  // Machine size the user picked at publish (rate-card key, e.g. 'dedicated-1').
  // Applied verbatim as the runtime pod's requests==limits and used to price
  // compute metering — the machine you picked is the machine you pay for.
  machineSize        String                 @default("shared-0.5")
  startedAt          DateTime?
  finishedAt         DateTime?
  canceledAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  project            Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment        DeploymentEnvironment? @relation(fields: [environmentId], references: [id])

  @@index([projectId])
  @@index([projectId, workspaceId])
  @@index([projectId, environmentName])
  @@index([projectId, status])
}

model DeploymentEnvironment {
  id          String       @id @default(cuid())
  name        String       @unique
  deployments Deployment[]
}

// P0-V3-08 deployment rollback manifest: one IMMUTABLE row appended per successful
// publish. It captures everything a DETERMINISTIC rollback needs so a published
// deployment can be restored to its previous version for real — independent of any
// live runtime/snapshot state. `deploymentId` is a plain pointer with NO FK on
// purpose: the manifest OUTLIVES the deployment row (a deployment can be pruned but
// its release must remain rollback-addressable). `version` is monotonic per
// (projectId, environment) so N-1 is unambiguous. A rollback that finds no previous
// manifest — or an artifact whose bytes no longer match `artifactDigest` — MUST fail
// closed rather than serve a blind/stale rollback.
model ReleaseManifest {
  id           String @id @default(cuid())
  projectId    String
  deploymentId String
  environment  String @default("preview")
  version      Int
  provider     String

  // 'static-snapshot' (artifactDigest = sha256 of the served bundle bytes) or
  // 'server-image' (artifactDigest = the image sha256, artifactRef = bare AR ref).
  artifactKind   String
  artifactRef    String
  artifactDigest String

  // Declared, never faked — NULL when the pipeline doesn't emit it:
  //  storeGeneration  = the ecode.lock Nix generation the release pinned (server)
  //  configDigest     = sha256 fingerprint of the effective env/config at publish
  //  dbMigrationPoint = latest applied DB migration marker at publish (RECORDED for
  //                     compatibility checks; image rollback never reverts the DB)
  storeGeneration  String?
  configDigest     String?
  dbMigrationPoint String?

  createdAt DateTime @default(now())

  @@unique([projectId, environment, version])
  @@index([projectId, environment])
  @@index([deploymentId])
}

// DURABLE idempotency for rollback requests (expert reserve P1).
//
// A rollback is NOT naturally idempotent: replaying it cuts a NEW release, so a client
// that loses the 201 (proxy timeout, pod restart, dropped connection) and retries makes
// the environment oscillate v1 → v2 → v1 … with no way back to a known state. An
// in-process map does not fix it — the retry commonly lands on a different API replica,
// and a restart forgets everything. Hence a table.
//
// `@@unique([projectId, environment, key])` is the whole mechanism: the INSERT is the
// claim. Winning it means "I own this execution"; losing it means the work is already
// done or in flight, and the stored response is replayed instead of re-executed.
model RollbackIdempotency {
  id          String @id @default(cuid())
  projectId   String
  environment String
  key         String

  // IN_FLIGHT while the owner executes; COMPLETED once the response is durable.
  // A replay of an IN_FLIGHT key is refused (409) rather than executed twice.
  state String @default("IN_FLIGHT")

  // The response to replay verbatim on retry — status code + JSON body, so a retried
  // call is byte-identical to the original instead of a fresh rollback.
  responseStatus Int?
  responseBody   Json?
  deploymentId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, environment, key])
  @@index([projectId, environment])
}

// Versioned Rate Card: the priced catalogue (machine sizes, compute-unit and
// request rates) served to the app and stamped on every metering event. A
// price change INSERTS a new version and flips `active` — history is never
// mutated, so past usage events stay auditable against the card that priced
// them. Seeded with version 1 (= packages/billing BUILTIN_RATE_CARD).
model RateCard {
  id          String   @id @default(cuid())
  version     Int      @unique
  active      Boolean  @default(false)
  data        Json
  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([active])
}

