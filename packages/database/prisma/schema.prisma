  featured            Boolean      @default(false)
  verified            Boolean      @default(false)
  featuredForIdePanel Boolean      @default(false)
  // Global admin kill-switch. false = hidden from the catalog, new installs
  // blocked, and existing installs soft-disabled (reversible on re-enable —
  // nothing is deleted). Defaults true so every existing row stays available.
  enabled             Boolean      @default(true)
  publishedAt         DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  installs            McpInstall[]

  @@index([domain])
  @@index([featured, verified])
  @@index([featuredForIdePanel])
  @@index([enabled])
}

model McpInstall {
  id             String          @id @default(cuid())
  catalogEntryId String
  userId         String
  organizationId String?
  alias          String
  configJson     Json
  enabled        Boolean         @default(true)
  installedAt    DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  catalogEntry   McpCatalogEntry @relation(fields: [catalogEntryId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, alias])
  @@index([organizationId])
  @@index([catalogEntryId])
}

// Server-side persistence for the MCP "Configuration" tab (manually authored
// `{ mcpServers: { … } }` JSON + the max sequential-LLM-step count). Replaces
// the previous localStorage-only storage (audit H5) so the chat/agent runtime
// can read a user's manually-configured servers — alongside their marketplace
// installs — when assembling the live MCP tool set. One row per user.
model McpUserConfig {
  id          String   @id @default(cuid())
  userId      String   @unique
  configJson  Json     @default("{}")
  maxLLMSteps Int      @default(5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Platform-wide (global) MCP policy — one tier ABOVE the per-org policy that
// reuses OrganizationConnectorPolicy. One row per catalog slug; `mode` is
// 'forced' | 'allowed' | 'blocked' (validated in the app, mirroring the org
// policy modes). Install resolution evaluates GLOBAL first, then the org
// policy. Absence of any row = default-open, so this is additive and inert
// until an admin sets a policy.
model McpGlobalPolicy {
  id        String   @id @default(cuid())
  slug      String   @unique
  mode      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mode])
}

// Server-side store for a shared conversation snapshot. Replaces embedding the
// full conversation in the share URL: a share mints a random, HMAC-signed
// token (stored here only as a hash) that the /share view redeems to fetch the
// snapshot. Standalone (no FK) so a share can outlive its project/author.
model ChatShare {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  conversationId String
  projectId      String
  authorUserId   String
  title          String?
  payloadJson    Json
  allowFork      Boolean   @default(false)
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([projectId])
  @@index([authorUserId])
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETE
  PARTIAL
  FAILED
}

enum AgentRunResultStatus {
  COMPLETE
  PARTIAL
  FAILED
}

model AgentRun {
  id             String           @id @default(cuid())
  organizationId String?
  userId         String?
  conversationId String?
  projectId      String?
  mode           String
  status         AgentRunStatus   @default(PENDING)
  reason         String?
  rolesPlanned   Json
  startedAt      DateTime         @default(now())
  completedAt    DateTime?
  metadata       Json             @default("{}")
  results        AgentRunResult[]
  consensus      ConsensusRecord?
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, startedAt])
  @@index([userId, startedAt])
  @@index([conversationId])
}

model AgentRunResult {
  id           String               @id @default(cuid())
  runId        String
  roleId       String
  status       AgentRunResultStatus
  summary      String
  files        Json                 @default("[]")
  risks        Json                 @default("[]")
  verification Json                 @default("[]")
  rawOutput    String?
  errorMessage String?
  startedAt    DateTime             @default(now())
  completedAt  DateTime?
  run          AgentRun             @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, roleId])
  @@index([runId])
}

enum ConsensusAlgorithm {
  QUORUM
  BYZANTINE_PBFT
  WEIGHTED_PLURALITY
}

enum ConsensusOutcome {
  ACCEPTED
  REJECTED
  PARTIAL
  ABSTAINED
}

model ConsensusRecord {
  id             String             @id @default(cuid())
  runId          String             @unique
  algorithm      ConsensusAlgorithm
  threshold      Float
  outcome        ConsensusOutcome
  agreementScore Float
  claimVotes     Json
  conflicts      Json               @default("[]")
  consolidated   Json
  rounds         Int                @default(1)
  durationMs     Int
  createdAt      DateTime           @default(now())
  run            AgentRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
}

/// Runtime/K8s orchestration state owned by services/workspace-manager.
/// Distinct from the user-facing Workspace model (which carries projectId
/// and runtimeMode for the IDE): this row tracks the actual pod, PVC,
/// service and agent-token-secret names allocated to the workspace, plus
/// the lifecycle status and the last-active timestamp used by the GC sweep.
/// The id matches the workspaceId used by services/api and the K8s object
/// names ("workspace-${id}", "pvc-${id}", "agent-token-${id}"), so this row
/// is effectively the canonical state shared between workspace-manager
/// replicas — replacing the file-backed JsonWorkspaceStore.
model WorkspaceRuntime {
  id                   String    @id
  orgId                String
  projectId            String
  plan                 Json
  status               String
  pvcName              String
  podName              String
  serviceName          String
  agentTokenSecretName String
  error                String?
  createdAt            DateTime  @default(now())
  lastActiveAt         DateTime  @default(now())
  // Last time this runtime's active compute was metered to the billing usage
  // ledger (P4 metering emitter). The GC meters the window from here (or
  // createdAt) to lastActiveAt on stop, then advances this marker — idempotent
  // across manager restarts. Null until first metered.
  lastMeteredAt        DateTime?
  updatedAt            DateTime  @updatedAt

  @@index([orgId])
  @@index([projectId])
  @@index([status, lastActiveAt])
}

// --- Integrations panel: connector catalog, user-scoped connections,
// per-project links, enterprise overrides, reconnection alerts,
// integration feature requests. See docs/INTEGRATIONS_MASTER_PLAN.md.

model ConnectorCatalog {
  id          String @id @default(cuid())
  provider    String @unique
  displayName String
  description String
  category    String
  authType    String
  section     String
  logoUrl     String

  defaultClientId        String?
  defaultClientSecretEnc String?
  authorizeUrl           String?
  tokenUrl               String?
  revokeUrl              String?
  userInfoUrl            String?
  defaultScopes          String[]
  availableScopes        String[]

  apiKeyFields       Json?
  apiKeyTestEndpoint String?

  triggersSupported   String[]
  triggerDescriptions Json     @default("{}")

  webhookSupport          Boolean @default(false)
  webhookSignatureScheme  String?
  webhookSigningSecretEnc String?

  minPlanTier         String  @default("free")
  forAgentUse         Boolean @default(true)
  displayOrder        Int     @default(0)
  featuredForIdePanel Boolean @default(false)
  enabled             Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section, enabled])
  @@index([category])
}

model UserConnection {
  id                   String @id @default(cuid())
  userId               String
  provider             String
  externalAccountId    String
  externalAccountLabel String

  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  apiKeyFieldsEncrypted Json?

  scopes            String[]
  tokenExpiresAt    DateTime?
  status            String    @default("active")
  lastUsedAt        DateTime?
  // Cursor for the background token health-check sweep, kept separate from the
  // user-facing lastUsedAt so the sweep no longer clobbers "last used".
  lastHealthCheckAt DateTime?
  forAgentUse       Boolean   @default(true)

  oauthAppSource     String  @default("e_code_default")
  oauthAppOverrideId String?

  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  revokedAt       DateTime?

  user               User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthAppOverride   OrganizationOAuthAppOverride? @relation(fields: [oauthAppOverrideId], references: [id])
  projectLinks       ProjectConnectionLink[]
  reconnectionAlerts ReconnectionAlert[]

  @@unique([userId, provider, externalAccountId])
  @@index([userId, provider])
  @@index([status])
  // Background token-health sweep cursors on lastHealthCheckAt; was a full-scan.
  @@index([lastHealthCheckAt])
}

model ProjectConnectionLink {
  id               String    @id @default(cuid())
  projectId        String
  userConnectionId String
  linkedByUserId   String
  linkedAt         DateTime  @default(now())
  unlinkedAt       DateTime?

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userConnection UserConnection @relation(fields: [userConnectionId], references: [id], onDelete: Cascade)
  linkedByUser   User           @relation("LinkedByUser", fields: [linkedByUserId], references: [id])

  @@unique([projectId, userConnectionId])
  @@index([projectId])
  @@index([userConnectionId])
  // "who linked this" lookups + future user-offboarding scans; was a full-scan.
  @@index([linkedByUserId])
}

model OrganizationOAuthAppOverride {
  id                    String    @id @default(cuid())
  organizationId        String
  provider              String
  clientId              String
  clientSecretEncrypted String
  scopes                String[]
  configuredByUserId    String
  testedAt              DateTime?
  testStatus            String?
  testError             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  configuredByUser User             @relation("ConfiguredByUser", fields: [configuredByUserId], references: [id])
  userConnections  UserConnection[]

  @@unique([organizationId, provider])
}

model OrganizationConnectorPolicy {
  id                String   @id @default(cuid())
  organizationId    String
  provider          String
  enabled           Boolean  @default(true)
  allowedRoleKeys   String[]
  rateLimitOverride Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

model ReconnectionAlert {
  id               String    @id @default(cuid())
  userConnectionId String
  reason           String
  detectedAt       DateTime  @default(now())
  resolvedAt       DateTime?
  notifiedAt       DateTime?

  userConnection UserConnection @relation(fields: [userConnectionId], references: [id], onDelete: Cascade)

  @@index([userConnectionId, resolvedAt])
}

/// Per-user in-app notification feed (2026-07-02). A durable, user-scoped
/// inbox surfaced in the SaaS account area: producers write a row, the user
/// lists unread + recent and marks items read. Distinct from ReconnectionAlert
/// (a connector-domain resolve queue) — this is the general feed. The first
/// real producer is the connector reconnection alert: when one is raised the
/// API also drops a Notification so the feed is non-empty in reality.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// Coarse routing/tone bucket, aligned with the preferences surfaces:
  /// "security" | "billing" | "deployments" | "team" | "system".
  category  String    @default("system")
  title     String
  body      String?
  /// Stable i18n descriptor for newly-produced notifications. Nullable keeps
  /// every historical row and older producer compatible with title/body.
  messageKey    String?
  messageParams Json?
  /// Optional in-app link the notification points at (e.g. /account/connections).
  linkUrl   String?
  /// Free-form producer metadata (e.g. the source alert id / provider) so the
  /// feed can be traced back to its origin without extra columns.
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Feed query is "this user's rows, unread first / newest first"; the partial
  // shape is covered well enough by the composite index below.
  @@index([userId, readAt, createdAt])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  /// Normalized (lowercased, trimmed) address; unique so re-subscribing is an
  /// idempotent upsert rather than a duplicate row.
  email          String    @unique
  /// Where the subscription came from ("footer", "newsletter-page", ...).
  source         String    @default("footer")
  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
}

/// Sales-contact leads submitted through the public /contact-sales form.
/// The row id doubles as the reference number quoted back to the prospect
/// (first 8 chars, uppercased), so sales can locate the lead from the
/// reference alone.
model ContactRequest {
  id        String   @id @default(cuid())
  email     String
  name      String?
  company   String
  teamSize  String?
  message   String
  /// Marketing page the form was submitted from ("/contact-sales", ...).
  pagePath  String?
  createdAt DateTime @default(now())
}

model IntegrationFeatureRequest {
  id                 String   @id @default(cuid())
  userId             String
  organizationId     String?
  integrationName    String
  useCaseDescription String
  status             String   @default("pending")
  createdAt          DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
}

/// Delivery / bounce / complaint notifications received from transactional
/// email providers. The recipient is stored verbatim (not joined to User) so
/// we can keep history for addresses that don't have an account — password
/// reset and email-verification flows fire before the user exists.
model EmailDeliveryEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String
  type            String
  email           String
  emailMessageId  String?
  subject         String?
  fromAddress     String?
  payload         Json
  receivedAt      DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([email])
  @@index([type])
  @@index([emailMessageId])
}

// ===========================================================================
// Replit-parity billing: credit wallet, effort-based checkpoints, and the
// admin-owned provider/model registry. All additive and dormant until the
// `BILLING_CREDITS_ENABLED` / `MODEL_REGISTRY_DB` flags are turned on, so the
// existing flat-rate Stripe billing path is unaffected. See
// docs/REPLIT_PARITY_SPEC.md.
// ===========================================================================

/// One USD-cent credit balance per organization. `balanceCents` is a
/// materialized cache of the sum of `CreditLedger.deltaCents`; the ledger is
/// the source of truth. `budgetCapCents` null = pay-as-you-go disabled.
model CreditWallet {
  id                        String         @id @default(cuid())
  organizationId            String         @unique
  balanceCents              Int            @default(0)
  currency                  String         @default("usd")
  // Replit "Usage Limit": cap on usage-based spend past included credits.
  budgetCapCents            Int?
  // Replit "Service Shutdown Limit": suspend usage-based services when reached.
  serviceShutdownCents      Int?
  autoTopupCents            Int?
  // Replit usage-based spend alerts (50/80/100%). De-dup marker: the highest
  // alert rung sent in the current billing period, and that period's start, so
  // each rung fires once and the ladder resets every period. Dormant until
  // BILLING_CREDITS_ENABLED. See spend-alerts.ts.
  lastSpendAlertPct         Int?
  lastSpendAlertPeriodStart DateTime?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  organization              Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries                   CreditLedger[]
}

/// Purchased credit pack (Replit). Credits expire 6 months after purchase, are
/// consumed earliest-expiring-first, and do NOT roll over after expiry.
/// `remainingCents` is decremented as the pack is drawn down.
model CreditPack {
  id                    String       @id @default(cuid())
  organizationId        String
  purchasedCents        Int
  remainingCents        Int
  expiresAt             DateTime
  stripePaymentIntentId String?
  createdAt             DateTime     @default(now())
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt])
}

enum CreditEntryKind {
  GRANT
  CONSUMPTION
  PAYG_CHARGE
  REFUND
  ADJUSTMENT
  EXPIRY
}

/// Append-only credit movements. Positive deltas are grants/refunds, negative
/// are consumption/charges. `checkpointId` links a CONSUMPTION to the agent
/// request that produced it. `expiresAt` supports daily/monthly grants that do
/// not roll over (Starter plan).
model CreditLedger {
  id             String          @id @default(cuid())
  walletId       String
  organizationId String
  deltaCents     Int
  kind           CreditEntryKind
  reason         String
  checkpointId   String?
  expiresAt      DateTime?
  metadata       Json?
  createdAt      DateTime        @default(now())
  wallet         CreditWallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // NOTE: a PARTIAL UNIQUE index "CreditLedger_org_checkpoint_payg_key" on
  // (organizationId, checkpointId) WHERE kind='PAYG_CHARGE' is defined in raw SQL
  // (migration 0045) — Prisma's schema can't express a WHERE-filtered unique index.
  // It backs recordPaygCharge's atomic create+catch-P2002 dedup. Do not drop it.

  @@index([organizationId, createdAt])
  @@index([walletId, createdAt])
  @@index([checkpointId])
  @@index([kind, expiresAt])
  // Org-scoped credit-expiry sweep filters organizationId + kind + expiresAt
  // together; the kind/expiresAt-only index wasn't org-scoped.
  @@index([organizationId, kind, expiresAt])
}

enum CheckpointStatus {
  PENDING
  COMPLETED
  FAILED
}

/// Effort-based checkpoint: exactly one per agent request. Bundles the real
/// effort (tokens + wall-time + attributed compute) into a single user-visible
/// credit charge (proof-of-work). `creditCents` is always >= the real provider
/// cost (`rawProviderCents`) by the configured margin.
model AgentCheckpoint {
  id               String           @id @default(cuid())
  organizationId   String
  userId           String?
  projectId        String?
  conversationId   String?
  runId            String?
  status           CheckpointStatus @default(PENDING)
  highPowerModel   Boolean          @default(false)
  extendedThinking Boolean          @default(false)
  // Replit Agent build tier (lite | economy | power) and Turbo mode (Pro:
  // ~2.5x faster, up to ~6x cost). Both feed the effort-based estimate.
  buildTier        String           @default("power")
  turboMode        Boolean          @default(false)
  inputTokens      Int              @default(0)
  outputTokens     Int              @default(0)
  wallMs           Int              @default(0)
  computeCents     Int              @default(0)
  rawProviderCents Int              @default(0)
  creditCents      Int              @default(0)
  startedAt        DateTime         @default(now())
  completedAt      DateTime?
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
  @@index([projectId])
  @@index([runId])
}

/// Replit-parity per-user spend limit (Enterprise). An admin can cap an
/// individual member's usage-based spend below the org/workspace default; the
/// per-member override takes precedence over the org budget cap.
model UserSpendLimit {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  limitCents     Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
}

/// Admin-owned AI provider registry. `apiKeySecret` is the *name* of a secret
/// in the platform secret manager — never the key material itself.
model ProviderConfig {
  id           String        @id @default(cuid())
  provider     String        @unique
  displayName  String
  enabled      Boolean       @default(false)
  apiKeySecret String?
  /// Admin-set platform API key for this provider, encrypted with encryptJson
  /// (write-only, never returned). Distinct from `apiKeySecret`, which holds only
  /// the NAME of a secret. Runtime resolves DB-first → *_API_KEY env fallback.
  apiKeyEnc    String?
  baseUrl      String?
  byokAllowed  Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  models       ModelConfig[]
}

/// Admin-owned model registry. Users may only see/use models with
/// `enabled = true` whose `enabledPlans` include their plan. Pricing here drives
/// effort-based credit cost.
model ModelConfig {
  id               String         @id @default(cuid())
  providerConfigId String
  modelId          String
  displayName      String
  enabled          Boolean        @default(false)
  enabledPlans     Json
  isHighPower      Boolean        @default(false)
  supportsThinking Boolean        @default(false)
  inputCentsPerM   Int
  outputCentsPerM  Int
  contextWindow    Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  providerConfig   ProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)

  @@unique([providerConfigId, modelId])
  @@index([enabled])
}

enum DatabaseInstanceStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  DELETED
}

/// Managed Postgres database for a project (Replit "Database" tab). Phase-1
/// scaffold for point-in-time rollback: the row models the instance and its
/// retention window; provisioning + WAL-based PITR are wired in later phases and
/// gated behind DB_ROLLBACK_ENABLED, so this table is dormant until then.
/// `retentionDays` is the plan-derived PITR window (Pro = 28).
model DatabaseInstance {
  id             String                 @id @default(cuid())
  projectId      String
  organizationId String
  // P2d dev/prod split: a project has a `development` instance (its workspace
  // DB) and, once published, a separate `production` instance. Existing rows
  // backfill to 'development', preserving the prior one-per-project behaviour.
  environment    String                 @default("development")
  status         DatabaseInstanceStatus @default(PROVISIONING)
  engine         String                 @default("postgres")
  region         String?
  sizeBytes      BigInt                 @default(0)
  retentionDays  Int                    @default(7)
  pitrEnabled    Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshots      DatabaseSnapshot[]
  restores       DatabaseRestore[]

  @@unique([projectId, environment])
  @@index([organizationId])
  @@index([status])
}

/// A recovery point for a DatabaseInstance — either a scheduled automatic
/// snapshot or a user-requested manual one. `lsn` records the Postgres WAL
/// position so a restore can target an exact point in time; `expiresAt` is the
/// retention horizon (older snapshots are pruned). Dormant until PITR ships.
model DatabaseSnapshot {
  id                 String           @id @default(cuid())
  databaseInstanceId String
  kind               String           @default("auto")
  label              String?
  lsn                String?
  sizeBytes          BigInt           @default(0)
  storageKey         String?
  createdByUserId    String?
  createdAt          DateTime         @default(now())
  expiresAt          DateTime?
  databaseInstance   DatabaseInstance @relation(fields: [databaseInstanceId], references: [id], onDelete: Cascade)

  @@index([databaseInstanceId, createdAt])
  @@index([expiresAt])
}

enum DatabaseRestoreStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// A point-in-time restore request for a DatabaseInstance. Targets either a
/// specific snapshot or an arbitrary `targetTimestamp` within the retention
/// window (true PITR). Status moves PENDING → RUNNING → COMPLETED/FAILED. The
/// restore executor is a later phase; rows can be created dormant for the UI.
model DatabaseRestore {
  id                 String                @id @default(cuid())
  databaseInstanceId String
  snapshotId         String?
  targetTimestamp    DateTime?
  status             DatabaseRestoreStatus @default(PENDING)
  requestedByUserId  String?
  error              String?
  createdAt          DateTime              @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  databaseInstance   DatabaseInstance      @relation(fields: [databaseInstanceId], references: [id], onDelete: Cascade)

  @@index([databaseInstanceId, createdAt])
  @@index([status])
  // "restores requested by user" lookups; was a full-scan (no FK on this column).
  @@index([requestedByUserId])
}

// ---------------------------------------------------------------------------
// Scheduled tasks (cron). Backs BOTH the Workflows panel schedules AND the
// Replit-parity "Scheduled" deployment type: a command that runs on a cron,
// exits, and is billed for its RUN TIME (duration x machine size) rather than
// 24/7. Before this, cron expressions were validated and a nextRunAt was
// computed, but nothing ever fired them — the feature was dead.
// ---------------------------------------------------------------------------

enum ScheduledTaskKind {
  /// Runs an existing Workflows-panel workflow (its ordered steps).
  WORKFLOW
  /// Replit "Scheduled Deployment": one shell command, on a cron.
  DEPLOYMENT
}

enum ScheduledTaskRunStatus {
  RUNNING
  SUCCESS
  FAILED
  TIMED_OUT
  /// The previous run was still RUNNING when this tick fired (concurrencyPolicy=FORBID).
  SKIPPED
  CANCELED
}

/// One cron-scheduled unit of work owned by a project. `nextRunAt` is the claim
/// token: the scheduler advances it inside a conditional UPDATE, so exactly one
/// api replica can ever own a given tick (no distributed lock needed).
model ScheduledTask {
  id             String            @id @default(cuid())
  organizationId String
  projectId      String
  kind           ScheduledTaskKind @default(DEPLOYMENT)
  name           String
  /// Shell command for DEPLOYMENT tasks (run as `sh -lc <command>` in the project sandbox).
  command        String            @default("")
  /// For WORKFLOW tasks: the workflow id inside VIBECORE_WORKFLOWS_STATE.
  workflowId     Int?
  /// 5-field cron expression, already normalized.
  cron           String
  /// IANA timezone the cron fields are interpreted in.
  timezone       String            @default("UTC")
  /// Machine size key. The size catalogue itself is owned elsewhere; this is the field only.
  machineSize    String            @default("shared-0.5")
  enabled        Boolean           @default(true)
  /// Hard kill after this many seconds.
  timeoutSeconds Int               @default(900)
  /// FORBID (skip if the previous run is still going) | ALLOW.
  concurrency    String            @default("FORBID")
  /// Replit parity: a failed scheduled run is NOT retried by default.
  maxRetries     Int               @default(0)
  notifyOnFailure Boolean          @default(true)
  lastRunAt      DateTime?
  lastStatus     String?
  /// Next fire time (UTC). NULL when disabled.
  nextRunAt      DateTime?
  createdByUserId String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  runs           ScheduledTaskRun[]

  /// The scheduler's hot query: enabled tasks whose nextRunAt is due.
  @@index([enabled, nextRunAt])
  @@index([projectId])
  @@index([organizationId])
  @@unique([projectId, kind, workflowId])
}

/// One execution. Holds the FULL captured stdout+stderr, the real exit code, the
/// real duration, and the billing outcome for that duration.
model ScheduledTaskRun {
  id             String                 @id @default(cuid())
  taskId         String
  organizationId String
  projectId      String
  status         ScheduledTaskRunStatus @default(RUNNING)
  /// "schedule" | "manual"
  trigger        String                 @default("schedule")
  attempt        Int                    @default(1)
  /// The cron instant this run is for (may differ from startedAt under load).
  scheduledFor   DateTime
  startedAt      DateTime               @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  exitCode       Int?
  /// Full captured output (stdout + stderr), not a tail.
  logs           String                 @default("")
  error          String?
  machineSize    String?
  /// Billed compute units for this run (duration x size). NULL until metered.
  computeUnits   Float?
  costCents      Float?
  meteredAt      DateTime?
  task           ScheduledTask          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, startedAt])
  @@index([projectId, startedAt])
  @@index([status])
}

/// Versioned Agent Routing Card: maps agent modes (Lite/Economy/Power) and
/// switches (High effort/Turbo) + the harness classifier to concrete provider
/// models with cost-of-revenue and user pricing. `data` is the serialized
/// AgentRoutingCard document (packages/billing agent-routing.ts). A config
/// change inserts a NEW version and closes the previous one (effectiveTo) —
/// never a deployment, never a mutation of history.
model AgentRoutingCard {
  id              String    @id @default(cuid())
  version         Int       @unique
  active          Boolean   @default(false)
  data            Json
  effectiveFrom   DateTime  @default(now())
  effectiveTo     DateTime?
  /// Date the cost-of-revenue figures were sourced from provider pricing.
  sourceDate      String?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  createdBy       User?     @relation("AgentRoutingCardAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([active])
}

/// One row per routed agent LLM call (admin-only, never shown to the client):
/// who called, which mode/switches, whether high-effort escalated, the REAL
/// provider+model used, tokens, cost-of-revenue, credits billed and margin.
/// Cents are stored as millicents (Int) to keep fractional cost exact.
model AgentCallLog {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  userId             String?
  organizationId     String?
  projectId          String?
  /// lite | economy | power
  mode               String
  highEffort         Boolean  @default(false)
  /// true when high-effort actually escalated this call to the escalation line
  escalated          Boolean  @default(false)
  turbo              Boolean  @default(false)
  /// Routing line that priced the call: mode key, high-effort, turbo or classifier.
  lineKey            String
  provider           String
  model              String
  tokensIn           Int      @default(0)
  tokensOut          Int      @default(0)
  /// Coût de revient in millicents (1/1000 cent).
  costMillicents     Int      @default(0)
  /// Credits billed to the user, in cents (0 when billedToUser=false).
  creditCents        Int      @default(0)
  /// creditCents*1000 - costMillicents (negative = platform absorbed cost).
  marginMillicents   Int      @default(0)
  billedToUser       Boolean  @default(true)
  routingCardVersion Int
  /// chat | classifier | continuation…
  source             String   @default("chat")

  @@index([createdAt])
  @@index([lineKey, createdAt])
  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
}

/// A secure project remix (fork) run. Tracks the normative state machine
/// (SNAPSHOT_PINNED → CREDENTIALS_DETACHED → CLONING → DB_FORKING →
/// STORAGE_POLICY_APPLIED → SCANNING → INDEXING → COMPLETED) so the
/// credentials-detached-before-cloning invariant is auditable. `detachedKeys`
/// holds ONLY secret/env KEYS (references) — never a value. `scanFindings`
/// records materialized-secret hits (key + location, never the value).
model RemixJob {
  id              String   @id @default(cuid())
  sourceProjectId String
  targetProjectId String?
  organizationId  String
  actorUserId     String?
  state           String   @default("SNAPSHOT_PINNED")
  /// IMMUTABLE source release the clone reproduces. When set, CLONING reads the
  /// files from this pinned ProjectSnapshot archive (not the live source), so a
  /// gallery remix is reproducible from the exact published release. NULL for a
  /// legacy live-source remix. This is the provenance pin (I-RMX-PIN).
  sourceSnapshotId String?
  /// The gallery listing this remix was launched from, if any (provenance).
  sourceListingId  String?
  /// { secretKeys: string[], envVarKeys: string[] } — references only.
  detachedKeys    Json?
  /// DETACH | CLONE | SHARE_WITH_CONSENT
  storagePolicy   String   @default("DETACH")
  /// SecretScanFinding[] { path, secretKey, line } — never the value.
  scanFindings    Json?
  /// Count of value-lines scrubbed out of the clone during CLONING.
  scrubbedCount   Int      @default(0)
  /// VERSIONED license captured at remix time from the source listing —
  /// { licenseId, licenseTextSha256, sourceListingId, capturedAt }. Immutable on
  /// the job: later edits to the listing's license never rewrite what THIS remix
  /// was accepted under (I-RMX-3, P0-V3-05). Null for a same-org self-remix.
  licenseSnapshot Json?
  /// Version of the remix consent text the REMIXER explicitly accepted before
  /// the clone ran (REMIX_CONSENT_VERSION at accept time). Null = no consent
  /// captured (same-org self-remix only — a gallery remix REQUIRES it).
  consentVersion  String?
  /// PiiFinding[] { path, kind, line } — kind of PII masked, never the value.
  piiFindings     Json?
  /// Count of PII spans masked out of the clone during SOURCE_SANITIZED.
  piiMaskedCount  Int      @default(0)
  /// Honest marker: was a physical isolated DB provisioned, or deferred?
  dbForked        Boolean  @default(false)
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sourceProjectId])
  @@index([organizationId, createdAt])
}

/// A secure project import run (DOMAIN_MODEL §2). Tracks the normative state
/// machine (RECEIVED → STAGING_ISOLATED → SCANNING → QUARANTINED →
/// AWAITING_USER_ACTION → COMMITTING → COMMITTED, with ROLLING_BACK / EXPIRED /
/// CANCELLED cleanup branches). `findings` holds REDACTED secret findings only
/// (never a raw value); `consent` records the per-finding keep/redact decision.
/// `targetProjectId` is set ONLY at the atomic COMMIT — it is null on every
/// non-committed terminal state (proving the target was never touched).
model ImportJob {
  id              String   @id @default(cuid())
  organizationId  String
  actorUserId     String?
  /// One of the 12 hub tiles (github|bitbucket|vercel|figma|claude|bolt|lovable|base44|zip|spreadsheet|previous-agent-export|empty)
  provider        String
  state           String   @default("RECEIVED")
  sourceRef       String?
  /// ImportSecretFinding[] { path, line, kind, preview } — redacted, no value.
  findings        Json?
  /// ConsentDecision { "path:line": "keep"|"redact" }.
  consent         Json?
  /// Set only at COMMITTED. Null everywhere else = target never mounted.
  targetProjectId String?
  stagedFileCount Int      @default(0)
  redactedCount   Int      @default(0)
  /// E-CODE DECISION (not Replit parity): idempotent credit reservation marker.
  creditsReserved Boolean  @default(false)
  error           String?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([state])
}

/// A curated public Gallery listing (TPL-02). Mirrors the CONFIRMED
/// replit.com/gallery surface: a browsable grid of published apps with an
/// author, public stats (views / uses), a category, a detail page, an outbound
/// "View App" link, and a Remix CTA.
///
/// CURATION, NOT SELF-SERVICE. Per DEC-GALLERY-NO-SELF-PUBLISH (Replit's
/// "Submit your App" is an external Typeform → human intake), rows are created
/// by a curator/seed, never by an in-product self-service Publish button. The
/// `status` gate is the curation boundary; only PUBLISHED rows are shown.
///
/// `sourceSnapshotId` pins the IMMUTABLE release a Remix reproduces — a
/// ProjectSnapshot archive of the source project taken at curation time. Remix
/// clones from THAT snapshot, so what a user forks matches the published
/// listing regardless of later edits to the source project.
model GalleryListing {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  description      String
  category         String
  /// Free-form display tags (["react","stripe"]). Not a taxonomy.
  tags             String[]  @default([])
  /// PUBLISHED (visible) | PENDING_REVIEW (curated, not yet live) | UNPUBLISHED.
  status           String    @default("PUBLISHED")
  featured         Boolean   @default(false)
  sourceProjectId  String
  /// Immutable release pin — the ProjectSnapshot a Remix reproduces.
  sourceSnapshotId String
  /// Curated author display (denormalized so a listing survives author changes).
  authorName       String
  authorUserId     String?
  /// Outbound "View App" link to the deployed app (may be null pre-deploy).
  appUrl           String?
  /// Card preview image (a real rendered screenshot). Root-relative static
  /// asset (/gallery-apps/<id>/thumbnail.png) or an https URL; null renders
  /// the text-only card.
  thumbnailUrl     String?
  /// FAIL-CLOSED (directive 20/07) : un projet publié ordinaire est
  /// ALL_RIGHTS_RESERVED, non-remixable. remixAllowed ne passe true qu'avec
  /// une licence EXPLICITE + confirmation des droits + politique PII acceptée.
  remixAllowed     Boolean   @default(false)
  /// License identifier declared at curation (e.g. an SPDX id like "MIT").
  /// Null = the author declared no license (surfaced as such — never invented).
  licenseId        String?
  /// VERSIONED license text snapshot captured at curation. What a remixer
  /// accepts is THIS text, pinned by its sha256 onto the RemixJob.
  licenseText      String?
  /// sha256 of licenseText — the version pin recorded on every remix.
  licenseTextSha256 String?
  /// Version of the PII-sharing consent the AUTHOR explicitly gave at curation
  /// (data ships unmasked). Null = no consent → PII is masked on every remix.
  piiConsentVersion String?
  /// TRACE AUDITABLE des confirmations exigées pour rendre un listing remixable
  /// (P0-V3-05, réserve #8). Avant la migration 0081 elles étaient validées à la
  /// curation puis JAMAIS écrites : la confirmation des droits par le curateur
  /// était inauditable a posteriori. Horodatage + acteur (userId de l'admin qui
  /// a curé). Null = jamais confirmé.
  rightsConfirmedAt DateTime?
  rightsConfirmedBy String?
  piiPolicyAcceptedAt DateTime?
  piiPolicyAcceptedBy String?
  viewCount        Int       @default(0)
  useCount         Int       @default(0)
  createdAt        DateTime  @default(now())
  publishedAt      DateTime?

  sourceProject Project @relation("ProjectGalleryListings", fields: [sourceProjectId], references: [id], onDelete: Cascade)
  author        User?   @relation("UserGalleryListings", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([status, category])
  @@index([status, featured])
  @@index([status, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// CANONICAL DOUBLE-ENTRY LEDGER (C1 / P0-V3-12)
// Supersedes the single-entry CreditWallet.balanceCents "porte-monnaie". Every
// posted transaction balances per currency (Σ debits == Σ credits); posted
// transactions + entries are IMMUTABLE (DB triggers in migration 0078) — a
// correction is a NEW reversing transaction, never a mutation. Amounts are exact
// integer minor units (BigInt); FX is exact rational (num/den). No relation to
// Organization is declared (plain organizationId, like UsageReservation) to keep
// the migration self-contained.
// ─────────────────────────────────────────────────────────────────────────────

enum LedgerAccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
  EQUITY
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

enum LedgerReservationStatus {
  ACTIVE
  COMMITTED
  COMPENSATED
  RELEASED
  EXPIRED
}

enum LedgerReconciliationStatus {
  OK
  DISCREPANCY
}

model LedgerAccount {
  id             String            @id @default(cuid())
  organizationId String
  /// Stable account key: user_credits | reserved | revenue | provider_cost |
  /// fx_clearing | fx_rounding | tax_payable | refunds | budget_hold ...
  key            String
  type           LedgerAccountType
  currency       String
  createdAt      DateTime          @default(now())
  entries        LedgerEntry[]

  @@unique([organizationId, key, currency])
  @@index([organizationId])
}

model LedgerTransaction {
  id              String              @id @default(cuid())
  organizationId  String
  reason          String
  /// Idempotency key (unique per org when set). NULL rows are not deduped.
  idempotencyKey  String?
  /// Compensation: points at the original transaction this one reverses.
  reversalOfId    String?
  rateCardVersion Int?
  postedAt        DateTime            @default(now())
  metadata        Json?
  entries         LedgerEntry[]
  reversalOf      LedgerTransaction?  @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals       LedgerTransaction[] @relation("LedgerReversal")

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, postedAt])
  @@index([reversalOfId])
}

model LedgerEntry {
  id            String               @id @default(cuid())
  transactionId String
  accountId     String
  direction     LedgerEntryDirection
  /// Exact positive integer minor units (e.g. USD cents / micro-credits).
  amountMinor   BigInt
  currency      String
  transaction   LedgerTransaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account       LedgerAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([accountId, currency])
}

model LedgerReservation {
  id              String                  @id @default(cuid())
  organizationId  String
  userId          String?
  /// Idempotency key, unique per org: a replay returns the SAME reservation.
  idempotencyKey  String
  operation       String
  status          LedgerReservationStatus @default(ACTIVE)
  currency        String                  @default("usd")
  /// Authorized ceiling (hold, not a debit).
  maxAmountMinor  BigInt
  /// Actually settled at COMMIT (≤ maxAmountMinor).
  committedMinor  BigInt?
  rateCardVersion Int?
  importJobId     String?
  /// Correlated ledger transactions across the lifecycle.
  reserveTxId     String?
  settleTxId      String?
  compensateTxId  String?
  expiresAt       DateTime
  committedAt     DateTime?
  releasedAt      DateTime?
  releaseReason   String?
  metadata        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([status, expiresAt])
  @@index([importJobId])
}

model LedgerFxRate {
  id           String    @id @default(cuid())
  fromCurrency String
  toCurrency   String
  /// Exact rational rate = rateNum / rateDen (no float).
  rateNum      BigInt
  rateDen      BigInt
  effectiveAt  DateTime
  /// Exclusive upper bound this rate is valid for (cutoff).
  cutoffAt     DateTime?
  createdAt    DateTime  @default(now())

  @@index([fromCurrency, toCurrency, effectiveAt])
}

model LedgerReconciliationRun {
  id               String                     @id @default(cuid())
  organizationId   String?
  /// GCP | STRIPE | LEDGER — the external source compared against the ledger.
  source           String
  status           LedgerReconciliationStatus
  discrepancyCount Int                        @default(0)
  discrepancies    Json?
  runAt            DateTime                   @default(now())
  metadata         Json?

  @@index([source, runAt])
}

// BLOCKER #5 — honest preview readiness. The in-preview reporter script detects a
// blank DOM / console error the server can never see and beacons it. Persisting
// it (vs the old fire-and-forget log) lets `/ports` readiness be honest across
// API replicas: a fresh blank/error beacon vetoes `ready` even when the port
// probe passed. `status`: 'ok' | 'blank' | 'error'. One row per (workspace,port),
// upserted; readiness only honours beacons newer than a short TTL.
model PreviewReadinessBeacon {
  id          String    @id @default(cuid())
  workspaceId String
  port        Int
  status      String
  detail      String?
  reportedAt  DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, port])
  @@index([workspaceId])
}

// BLOCKER #6 — timestamped workspace lifecycle machine. Append-only trail of
// PENDING->STARTING->RUNNING->STOPPING->STOPPED/FAILED transitions so a workspace
// that died can be reconstructed after the fact (vs Workspace.status, a single
// overwritten value). `state` is a WorkspaceLifecycleState; transitions are
// validated by assertWorkspaceLifecycleTransition before write.
model WorkspaceLifecycleEvent {
  id          String    @id @default(cuid())
  workspaceId String
  state       String
  reason      String?
  detail      Json?
  at          DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, at])
}

// BLOCKER #6 — post-mortem snapshot captured when a workspace stops/fails: the
// last-known ports, processes, Problems (beacons/diagnostics) and a tail of the
// runtime logs, frozen at shutdown. Append-only (one per stop), so a support
// operator can see WHY a preview was blank/dead after the pod is gone.
model WorkspacePostMortem {
  id          String    @id @default(cuid())
  workspaceId String
  reason      String
  finalState  String
  ports       Json?
  processes   Json?
  problems    Json?
  logsTail    String?
  capturedAt  DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, capturedAt])
}
