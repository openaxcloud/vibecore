generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceStatus {
  PENDING
  STARTING
  RUNNING
  STOPPED
  FAILED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  READY
  FAILED
  CANCELED
}

enum SupportTicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

model User {
  id                          String                         @id @default(cuid())
  email                       String                         @unique
  name                        String?
  passwordHash                String?
  emailVerifiedAt             DateTime?
  mfaEnabled                  Boolean                        @default(false)
  mfaSecretCiphertext         String?
  platformAdmin               Boolean                        @default(false)
  // BCP-47 primary language tag (e.g. "en", "fr"). Null when the user
  // hasn't set a preference; the client falls back to navigator.language
  // and finally to "en". Drives SSR language selection via a cookie set
  // on session create.
  language                    String?
  // IANA timezone name (e.g. "Europe/Paris"). Null until the user sets it
  // in account/IDE settings; the client falls back to
  // Intl.DateTimeFormat().resolvedOptions().timeZone.
  timezone                    String?
  // Free-form per-user preferences blob set from the in-IDE settings panel
  // (notifications, event logs, feature toggles, profile fields). Shallow
  // -merged on PATCH so partial updates never clobber unrelated keys.
  // language/timezone stay first-class columns above because SSR + the SaaS
  // account-settings route read them directly.
  preferences                 Json?
  // Last time the user was active (throttled touch on authenticated requests +
  // session create). Drives Replit-parity inactivity GC (free accounts inactive
  // >= 1 year are eligible for deletion; paid exempt). Null until first touch. P8.
  lastActiveAt                DateTime?
  createdAt                   DateTime                       @default(now())
  updatedAt                   DateTime                       @updatedAt
  accounts                    Account[]
  sessions                    Session[]
  memberships                 OrganizationMember[]
  apiKeys                     ApiKey[]
  auditLogs                   AuditLog[]
  adminAuditLogs              AdminAuditLog[]
  conversations               AiConversation[]
  supportTickets              SupportTicket[]
  oauthConnections            OAuthConnection[]
  emailVerificationTokens     EmailVerificationToken[]
  passwordResetTokens         PasswordResetToken[]
  recoveryCodes               MfaRecoveryCode[]
  projectCollaborations       ProjectCollaborator[]
  projectActivity             ProjectActivity[]
  projectSnapshots            ProjectSnapshot[]
  galleryListings             GalleryListing[]        @relation("UserGalleryListings")
  projectIdeStateUpdates      ProjectIdeState[]
  collaborationPresence       CollaborationPresence[]
  collaborationComments       CollaborationComment[]
  collaborationShareLinks     ProjectShareLink[]
  agentMemories               AgentMemory[]
  agentMemoryPreferences      AgentMemoryPreference[]
  mcpInstalls                 McpInstall[]
  mcpUserConfig               McpUserConfig?
  agentRuns                   AgentRun[]
  userConnections             UserConnection[]
  linkedProjectConnections    ProjectConnectionLink[]        @relation("LinkedByUser")
  configuredOauthAppOverrides OrganizationOAuthAppOverride[] @relation("ConfiguredByUser")
  integrationFeatureRequests  IntegrationFeatureRequest[]
  notifications               Notification[]
  aiMessageFeedback           AiMessageFeedback[]
  spendLimits                 UserSpendLimit[]
  agentRoutingCards           AgentRoutingCard[]             @relation("AgentRoutingCardAuthor")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  refreshHash    String?   @unique
  expiresAt      DateTime
  rotatedAt      DateTime?
  revokedAt      DateTime?
  lastReauthAt   DateTime?
  // When set, this session is an admin impersonating another user; value = the
  // impersonating admin's user id (for audit / UI banner / traceability). P8.
  impersonatedBy String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id                         String                          @id @default(cuid())
  slug                       String                          @unique
  name                       String
  /// Optional CC address for billing notifications (spend alerts, invoices).
  billingEmail               String?
  createdAt                  DateTime                        @default(now())
  updatedAt                  DateTime                        @updatedAt
  members                    OrganizationMember[]
  invites                    OrganizationInvite[]
  projects                   Project[]
  billingCustomer            BillingCustomer?
  subscriptions              Subscription[]
  usageEvents                UsageEvent[]
  quotaLedger                QuotaLedger[]
  quotaOverrides             QuotaOverride[]
  stripeEvents               StripeEvent[]
  aiCostLedger               AiCostLedger[]
  auditLogs                  AuditLog[]
  abuseEvents                AbuseEvent[]
  supportTickets             SupportTicket[]
  featureFlags               FeatureFlag[]
  apiKeys                    ApiKey[]
  enterpriseSettings         EnterpriseOrganizationSettings?
  domains                    VerifiedDomain[]
  ssoConfigurations          SsoConfiguration[]
  scimTokens                 ScimToken[]
  customRoles                CustomRole[]
  siemWebhooks               SiemWebhook[]
  projectTemplates           ProjectTemplate[]
  agentMemories              AgentMemory[]
  agentMemoryPreferences     AgentMemoryPreference[]
  mcpInstalls                McpInstall[]
  agentRuns                  AgentRun[]
  oauthAppOverrides          OrganizationOAuthAppOverride[]
  connectorPolicies          OrganizationConnectorPolicy[]
  integrationFeatureRequests IntegrationFeatureRequest[]
  creditWallet               CreditWallet?
  creditLedger               CreditLedger[]
  creditPacks                CreditPack[]
  agentCheckpoints           AgentCheckpoint[]
  userSpendLimits            UserSpendLimit[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([roleId])
}

model OrganizationInvite {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  roleId         String
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])

  @@index([organizationId])
}

model Role {
  id          String               @id @default(cuid())
  key         String               @unique
  name        String
  system      Boolean              @default(false)
  permissions RolePermission[]
  members     OrganizationMember[]
  invites     OrganizationInvite[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Project {
  id                     String                  @id @default(cuid())
  organizationId         String
  name                   String
  slug                   String
  description            String?
  sourceType             String                  @default("blank")
  templateName           String?
  gitRepositoryUrl       String?
  gitDefaultBranch       String?
  persistentVolumeClaim  String?
  thumbnailUrl           String?
  thumbnailUpdatedAt     DateTime?
  deletedAt              DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environments           ProjectEnvironment[]
  envVars                ProjectEnvVar[]
  secrets                ProjectSecret[]
  collaborators          ProjectCollaborator[]
  activity               ProjectActivity[]
  templates              ProjectTemplate[]       @relation("ProjectTemplates")
  galleryListings        GalleryListing[]        @relation("ProjectGalleryListings")
  workspaces             Workspace[]
  snapshots              ProjectSnapshot[]
  storageObjects         ProjectStorageObject[]
  deployments            Deployment[]
  fileSnapshots          FileSnapshot[]
  conversations          AiConversation[]
  ideState               ProjectIdeState?
  collaborationPresence  CollaborationPresence[]
  collaborationComments  CollaborationComment[]
  shareLinks             ProjectShareLink[]
  agentMemories          AgentMemory[]
  agentMemoryPreferences AgentMemoryPreference[]
  agentPatchProposals    AgentPatchProposal[]
  connectionLinks        ProjectConnectionLink[]
  databaseInstances      DatabaseInstance[]
  skills                 ProjectSkill[]
  repairEvents           AgentRepairEvent[]
  slugRedirects          ProjectSlugRedirect[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

// F13: preserves an old project slug after a rename so the previous canonical
// URL keeps redirecting to the current one until `expiresAt` (30 days). Purely
// additive: an `oldSlug` snapshot with an FK back to the project so rows cascade
// away when the project is hard-deleted.
model ProjectSlugRedirect {
  id        String   @id @default(cuid())
  projectId String
  oldSlug   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, oldSlug])
  @@index([oldSlug])
}

model AgentMemory {
  id                  String                @id @default(cuid())
  userId              String
  organizationId      String?
  projectId           String?
  sessionId           String?
  scope               String
  content             String
  summary             String
  embedding           Unsupported("vector")
  embeddingModel      String
  embeddingDimensions Int                   @default(1536)
  metadata            Json                  @default("{}")
  memoryType          String                @default("semantic")
  tags                String[]              @default([])
  references          String[]              @default([])
  importance          Float                 @default(0.5)
  source              String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  lastUsedAt          DateTime?
  expiresAt           DateTime?
  archivedAt          DateTime?
  accessCount         Int                   @default(0)
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization        Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project?              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, scope, updatedAt])
  @@index([memoryType, updatedAt])
  @@index([organizationId, updatedAt])
  @@index([projectId, updatedAt])
  @@index([sessionId, updatedAt])
}

model AgentMemoryPreference {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  projectId      String?
  enabled        Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([organizationId, updatedAt])
  @@index([projectId, updatedAt])
}

model ProjectIdeState {
  projectId       String   @id
  state           Json
  version         Int      @default(1)
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedBy       User?    @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

// Persists the AI-generated patch review queue across workbench reloads.
// Terminal status proposals (accepted, rejected, reverted) are hard-deleted
// because the audit trail lives in ProjectActivity; this table only holds
// proposals the user still has to decide on. The id is the existing
// "artifactId:actionId" composite the streaming runner already uses, so the
// nanostore key and the row id line up 1:1.
model AgentPatchProposal {
  id              String   @id
  projectId       String
  artifactId      String
  messageId       String
  actionId        String
  filePath        String
  relativePath    String
  originalContent String
  proposedContent String
  hunks           Json
  status          String
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([projectId, updatedAt])
}

// Durable history of the agent's AST self-repair pipeline: each time a streamed
// file fails validation and the agent retries (regenerates) it, the outcome is
// recorded here so the IDE can show a review UI of auto-repairs/errors. Unlike
// AgentPatchProposal (a transient working queue, hard-deleted on decision), this
// is an append-only audit log. Additive + inert until the IDE records/reads it.
model AgentRepairEvent {
  id              String   @id @default(cuid())
  projectId       String
  messageId       String?
  artifactId      String?
  actionId        String?
  relativePath    String
  attempt         Int      @default(1)
  // 'repaired' (validation passed after retry) | 'failed' (this attempt failed) |
  // 'gave_up' (retry budget exhausted, original written best-effort)
  outcome         String
  validationError String?
  repairError     String?
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// Per-project enable/disable overrides for the builtin Skills catalog (Replit
// parity). The catalog itself is a static, code-owned list (skills-catalog.ts);
// this table only stores the sparse set of projects that toggled a skill away
// from its default. Absent row => the skill is at its catalog default. skillId
// is the catalog slug. Unique per (project, skill).
model ProjectSkill {
  id        String   @id @default(cuid())
  projectId String
  skillId   String
  enabled   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, skillId])
  @@index([projectId])
}

// Installable GitHub-repo skills (F#27). A row records a PUBLIC GitHub skill repo
// that a project or its workspace has installed, plus the instructions fetched
// from the repo at install time. Polymorphic scope: scope='project' => scopeId is
// a projectId; scope='workspace' => scopeId is a workspaceId. No FK (polymorphic),
// so orphan cleanup is by the owning route. Layered ON TOP of the builtin catalog
// (ProjectSkill) — that table is untouched. Unique per (scope, scopeId, ownerRepo).
model InstalledSkill {
  id                String   @id @default(cuid())
  scope             String
  scopeId           String
  ownerRepo         String
  name              String
  description       String
  instructions      String
  homepageUrl       String?
  enabled           Boolean  @default(true)
  installedByUserId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // RPL-SK-001.3/.4 — provenance + security-audit + revoke state.
  // origin: where the skill came from ('catalog' | 'github' | 'workspace-file' | 'builtin').
  origin          String  @default("github")
  // sha256 of the audited disclosed surface (body + resources) — provenance integrity.
  contentHash     String?
  // Latest audit verdict: 'approved' | 'quarantined' | 'rejected'. A 'rejected' skill
  // is never persisted enabled; a 'quarantined' one is disabled pending approval.
  auditVerdict    String?
  // JSON array of AuditFinding for the UI's audit panel.
  auditFindings   String?
  auditedAt       DateTime?
  // Parsed interop-manifest fields (agentskills.io) when the skill is a real SKILL.md.
  manifestName    String?
  // JSON array of {path, kind, bytes} for progressive-disclosure L3 resources.
  resourcesJson   String?
  // Revoke is distinct from uninstall: the row stays for audit but is hard-disabled
  // and cannot be re-enabled until re-installed.
  revokedAt       DateTime?
  revokedByUserId String?
  revokeReason    String?

  @@unique([scope, scopeId, ownerRepo])
  @@index([scope, scopeId])
  @@index([ownerRepo])
}

// Append-only audit journal for interoperable Agent Skills (RPL-SK-001.3). Every
// consequential skill event — an install being approved/quarantined/REJECTED, a
// manual approval, an enable/disable, a revoke, an uninstall — writes one immutable
// row here so the security history of a project's skills is fully reconstructable.
// No FK (polymorphic scope like InstalledSkill); never updated after insert.
model SkillAuditEvent {
  id           String   @id @default(cuid())
  scope        String
  scopeId      String
  ownerRepo    String
  // 'install-approved' | 'install-quarantined' | 'install-rejected' | 'approve'
  // | 'revoke' | 'enable' | 'disable' | 'uninstall'
  action       String
  verdict      String?
  findingsJson String?
  contentHash  String?
  actorUserId  String?
  createdAt    DateTime @default(now())

  @@index([scope, scopeId])
  @@index([ownerRepo])
  @@index([createdAt])
}

model ProjectEnvironment {
  id        String   @id @default(cuid())
  projectId String
  name      String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

model ProjectSecret {
  id             String   @id @default(cuid())
  projectId      String
  key            String
  valueHash      String
  valueEncrypted String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
}

model ProjectEnvVar {
  id        String   @id @default(cuid())
  projectId String
  key       String
  value     String
  // Deployment scope this value applies to: development | preview | production.
  // Defaults to "production" so every pre-scope row keeps its existing meaning.
  scope     String   @default("production")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key, scope])
}

model ProjectCollaborator {
  id        String    @id @default(cuid())
  projectId String
  userId    String
  roleKey   String
  // When set, the grant is ignored after this instant. A time-limited share
  // link writes its own expiry here so redeeming it no longer confers permanent
  // access. Null = no expiry (direct invites).
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectActivity {
  id          String   @id @default(cuid())
  projectId   String
  actorUserId String?
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([actorUserId])
}

model CollaborationPresence {
  id             String   @id @default(cuid())
  projectId      String
  userId         String
  sessionId      String
  status         String   @default("online")
  filePath       String?
  cursor         Json?
  selection      Json?
  mode           String   @default("editing")
  terminalAccess Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, sessionId])
  @@index([projectId, updatedAt])
  @@index([userId])
}

model CollaborationComment {
  id         String    @id @default(cuid())
  projectId  String
  userId     String
  filePath   String?
  line       Int?
  selection  Json?
  body       String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId])
}

model ProjectShareLink {
  id              String    @id @default(cuid())
  projectId       String
  tokenHash       String    @unique
  roleKey         String
  expiresAt       DateTime
  createdByUserId String?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, expiresAt])
}

model ProjectTemplate {
  id              String       @id @default(cuid())
  sourceProjectId String
  organizationId  String
  name            String
  description     String?
  createdAt       DateTime     @default(now())
  sourceProject   Project      @relation("ProjectTemplates", fields: [sourceProjectId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Workspace {
  id               String             @id @default(cuid())
  projectId        String
  name             String
  status           WorkspaceStatus    @default(PENDING)
  runtimeMode      String
  // P2d dev/prod split: 'development' (the editable workspace) or 'production'
  // (the checkout created when a deployment is published). Existing rows
  // backfill to 'development'. Not unique — a project keeps multiple dev
  // workspaces (primary + secondary agent-run checkouts); the prod checkout
  // is the single workspace with environment='production'.
  environment      String             @default("development")
  // Filesystem path (relative to the project storage root) for this
  // workspace's isolated git working tree. Allocated when the workspace
  // is created so each branch / agent run can have its own checkout
  // without colliding with other workspaces of the same project.
  gitPath          String?
  // Remote URL for this workspace's git working tree. Workspaces can point
  // at different remotes (e.g. an agent run targets a personal fork while
  // the primary workspace tracks the upstream project), so we store the
  // remote here instead of falling back to Project.gitRepositoryUrl for
  // every workspace. Nullable: a fresh workspace inherits the project-level
  // remote until the user explicitly configures one.
  gitRepositoryUrl String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessions         WorkspaceSession[]
  ports            WorkspacePort[]
  snapshots        FileSnapshot[]
  ideState         WorkspaceIdeState?
  readinessBeacons PreviewReadinessBeacon[]
  lifecycleEvents  WorkspaceLifecycleEvent[]
  postMortems      WorkspacePostMortem[]

  @@index([projectId])
}

// Workspace-scoped IDE state (open tabs, file manifest, scroll positions, …).
// Mirrors ProjectIdeState 1:1 but keyed by workspace so each working tree can
// keep its own editor cursor, file tree, and unsaved buffers. listFiles falls
// back to the project-level state when a workspace has no entry yet, which
// keeps backward compatibility with workspaces created before this table
// existed.
model WorkspaceIdeState {
  workspaceId     String    @id
  state           Json
  version         Int       @default(1)
  updatedByUserId String?
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceSession {
  id          String          @id @default(cuid())
  workspaceId String
  userId      String?
  status      WorkspaceStatus @default(STARTING)
  startedAt   DateTime        @default(now())
  stoppedAt   DateTime?
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  // Presence-cleanup sweeps by userId (nullable); without this it full-scanned.
  @@index([userId])
}

model WorkspacePort {
  id          String    @id @default(cuid())
  workspaceId String
  port        Int
  url         String?
  protocol    String    @default("http")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, port])
}

model FileSnapshot {
  id          String     @id @default(cuid())
  projectId   String
  workspaceId String?
  path        String
  contentHash String
  sizeBytes   Int
  metadata    Json?
  createdAt   DateTime   @default(now())
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([projectId, path])
}

model ProjectSnapshot {
  id              String   @id @default(cuid())
  projectId       String
  label           String?
  kind            String   @default("manual")
  manifest        Json
  storageKey      String?
  byteLength      Int?
  createdByUserId String?
  // Association used to pair a snapshot to the chat checkpoint that produced it.
  // Populated for AI "before-ai-change" snapshots; NULL for manual/legacy rows.
  // turnIndex is the assistant-turn ordinal within the conversation at the time
  // the snapshot was taken (the first snapshot of a turn has the smallest
  // createdAt). See migration 0046_snapshot_checkpoint_assoc.
  conversationId  String?
  turnIndex       Int?
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([projectId])
