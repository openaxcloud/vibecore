generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceStatus {
  PENDING
  STARTING
  RUNNING
  STOPPED
  FAILED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  READY
  FAILED
  CANCELED
}

enum SupportTicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

model User {
  id                          String                         @id @default(cuid())
  email                       String                         @unique
  name                        String?
  passwordHash                String?
  emailVerifiedAt             DateTime?
  mfaEnabled                  Boolean                        @default(false)
  mfaSecretCiphertext         String?
  platformAdmin               Boolean                        @default(false)
  // BCP-47 primary language tag (e.g. "en", "fr"). Null when the user
  // hasn't set a preference; the client falls back to navigator.language
  // and finally to "en". Drives SSR language selection via a cookie set
  // on session create.
  language                    String?
  // IANA timezone name (e.g. "Europe/Paris"). Null until the user sets it
  // in account/IDE settings; the client falls back to
  // Intl.DateTimeFormat().resolvedOptions().timeZone.
  timezone                    String?
  // Free-form per-user preferences blob set from the in-IDE settings panel
  // (notifications, event logs, feature toggles, profile fields). Shallow
  // -merged on PATCH so partial updates never clobber unrelated keys.
  // language/timezone stay first-class columns above because SSR + the SaaS
  // account-settings route read them directly.
  preferences                 Json?
  // Last time the user was active (throttled touch on authenticated requests +
  // session create). Drives Replit-parity inactivity GC (free accounts inactive
  // >= 1 year are eligible for deletion; paid exempt). Null until first touch. P8.
  lastActiveAt                DateTime?
  createdAt                   DateTime                       @default(now())
  updatedAt                   DateTime                       @updatedAt
  accounts                    Account[]
  sessions                    Session[]
  memberships                 OrganizationMember[]
  apiKeys                     ApiKey[]
  auditLogs                   AuditLog[]
  adminAuditLogs              AdminAuditLog[]
  conversations               AiConversation[]
  supportTickets              SupportTicket[]
  oauthConnections            OAuthConnection[]
  emailVerificationTokens     EmailVerificationToken[]
  passwordResetTokens         PasswordResetToken[]
  recoveryCodes               MfaRecoveryCode[]
  projectCollaborations       ProjectCollaborator[]
  projectActivity             ProjectActivity[]
  projectSnapshots            ProjectSnapshot[]
  projectIdeStateUpdates      ProjectIdeState[]
  collaborationPresence       CollaborationPresence[]
  collaborationComments       CollaborationComment[]
  collaborationShareLinks     ProjectShareLink[]
  agentMemories               AgentMemory[]
  agentMemoryPreferences      AgentMemoryPreference[]
  mcpInstalls                 McpInstall[]
  mcpUserConfig               McpUserConfig?
  agentRuns                   AgentRun[]
  userConnections             UserConnection[]
  linkedProjectConnections    ProjectConnectionLink[]        @relation("LinkedByUser")
  configuredOauthAppOverrides OrganizationOAuthAppOverride[] @relation("ConfiguredByUser")
  integrationFeatureRequests  IntegrationFeatureRequest[]
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  refreshHash  String?   @unique
  expiresAt    DateTime
  rotatedAt    DateTime?
  revokedAt    DateTime?
  lastReauthAt DateTime?
  // When set, this session is an admin impersonating another user; value = the
  // impersonating admin's user id (for audit / UI banner / traceability). P8.
  impersonatedBy String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id                         String                          @id @default(cuid())
  slug                       String                          @unique
  name                       String
  createdAt                  DateTime                        @default(now())
  updatedAt                  DateTime                        @updatedAt
  members                    OrganizationMember[]
  invites                    OrganizationInvite[]
  projects                   Project[]
  billingCustomer            BillingCustomer?
  subscriptions              Subscription[]
  usageEvents                UsageEvent[]
  quotaLedger                QuotaLedger[]
  quotaOverrides             QuotaOverride[]
  stripeEvents               StripeEvent[]
  aiCostLedger               AiCostLedger[]
  auditLogs                  AuditLog[]
  abuseEvents                AbuseEvent[]
  supportTickets             SupportTicket[]
  featureFlags               FeatureFlag[]
  apiKeys                    ApiKey[]
  enterpriseSettings         EnterpriseOrganizationSettings?
  domains                    VerifiedDomain[]
  ssoConfigurations          SsoConfiguration[]
  scimTokens                 ScimToken[]
  customRoles                CustomRole[]
  siemWebhooks               SiemWebhook[]
  projectTemplates           ProjectTemplate[]
  agentMemories              AgentMemory[]
  agentMemoryPreferences     AgentMemoryPreference[]
  mcpInstalls                McpInstall[]
  agentRuns                  AgentRun[]
  oauthAppOverrides          OrganizationOAuthAppOverride[]
  connectorPolicies          OrganizationConnectorPolicy[]
  integrationFeatureRequests IntegrationFeatureRequest[]
  creditWallet               CreditWallet?
  creditLedger               CreditLedger[]
  creditPacks                CreditPack[]
  agentCheckpoints           AgentCheckpoint[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([roleId])
}

model OrganizationInvite {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  roleId         String
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])

  @@index([organizationId])
}

model Role {
  id          String               @id @default(cuid())
  key         String               @unique
  name        String
  system      Boolean              @default(false)
  permissions RolePermission[]
  members     OrganizationMember[]
  invites     OrganizationInvite[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Project {
  id                     String                  @id @default(cuid())
  organizationId         String
  name                   String
  slug                   String
  description            String?
  sourceType             String                  @default("blank")
  templateName           String?
  gitRepositoryUrl       String?
  gitDefaultBranch       String?
  persistentVolumeClaim  String?
  deletedAt              DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environments           ProjectEnvironment[]
  envVars                ProjectEnvVar[]
  secrets                ProjectSecret[]
  collaborators          ProjectCollaborator[]
  activity               ProjectActivity[]
  templates              ProjectTemplate[]       @relation("ProjectTemplates")
  workspaces             Workspace[]
  snapshots              ProjectSnapshot[]
  storageObjects         ProjectStorageObject[]
  deployments            Deployment[]
  fileSnapshots          FileSnapshot[]
  conversations          AiConversation[]
  ideState               ProjectIdeState?
  collaborationPresence  CollaborationPresence[]
  collaborationComments  CollaborationComment[]
  shareLinks             ProjectShareLink[]
  agentMemories          AgentMemory[]
  agentMemoryPreferences AgentMemoryPreference[]
  agentPatchProposals    AgentPatchProposal[]
  connectionLinks        ProjectConnectionLink[]
  databaseInstance       DatabaseInstance?

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model AgentMemory {
  id                  String                @id @default(cuid())
  userId              String
  organizationId      String?
  projectId           String?
  sessionId           String?
  scope               String
  content             String
  summary             String
  embedding           Unsupported("vector")
  embeddingModel      String
  embeddingDimensions Int                   @default(1536)
  metadata            Json                  @default("{}")
  memoryType          String                @default("semantic")
  tags                String[]              @default([])
  references          String[]              @default([])
  importance          Float                 @default(0.5)
  source              String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  lastUsedAt          DateTime?
  expiresAt           DateTime?
  archivedAt          DateTime?
  accessCount         Int                   @default(0)
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization        Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project?              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, scope, updatedAt])
  @@index([memoryType, updatedAt])
  @@index([organizationId, updatedAt])
  @@index([projectId, updatedAt])
  @@index([sessionId, updatedAt])
}

model AgentMemoryPreference {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  projectId      String?
  enabled        Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([organizationId, updatedAt])
  @@index([projectId, updatedAt])
}

model ProjectIdeState {
  projectId       String   @id
  state           Json
  version         Int      @default(1)
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedBy       User?    @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

// Persists the AI-generated patch review queue across workbench reloads.
// Terminal status proposals (accepted, rejected, reverted) are hard-deleted
// because the audit trail lives in ProjectActivity; this table only holds
// proposals the user still has to decide on. The id is the existing
// "artifactId:actionId" composite the streaming runner already uses, so the
// nanostore key and the row id line up 1:1.
model AgentPatchProposal {
  id              String   @id
  projectId       String
  artifactId      String
  messageId       String
  actionId        String
  filePath        String
  relativePath    String
  originalContent String
  proposedContent String
  hunks           Json
  status          String
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([projectId, updatedAt])
}

model ProjectEnvironment {
  id        String   @id @default(cuid())
  projectId String
  name      String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

model ProjectSecret {
  id             String   @id @default(cuid())
  projectId      String
  key            String
  valueHash      String
  valueEncrypted String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
}

model ProjectEnvVar {
  id        String   @id @default(cuid())
  projectId String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
}

model ProjectCollaborator {
  id        String    @id @default(cuid())
  projectId String
  userId    String
  roleKey   String
  // When set, the grant is ignored after this instant. A time-limited share
  // link writes its own expiry here so redeeming it no longer confers permanent
  // access. Null = no expiry (direct invites).
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectActivity {
  id          String   @id @default(cuid())
  projectId   String
  actorUserId String?
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([actorUserId])
}

model CollaborationPresence {
  id             String   @id @default(cuid())
  projectId      String
  userId         String
  sessionId      String
  status         String   @default("online")
  filePath       String?
  cursor         Json?
  selection      Json?
  mode           String   @default("editing")
  terminalAccess Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, sessionId])
  @@index([projectId, updatedAt])
  @@index([userId])
}

model CollaborationComment {
  id         String    @id @default(cuid())
  projectId  String
  userId     String
  filePath   String?
  line       Int?
  selection  Json?
  body       String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId])
}

model ProjectShareLink {
  id              String    @id @default(cuid())
  projectId       String
  tokenHash       String    @unique
  roleKey         String
  expiresAt       DateTime
  createdByUserId String?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, expiresAt])
}

model ProjectTemplate {
  id              String       @id @default(cuid())
  sourceProjectId String
  organizationId  String
  name            String
  description     String?
  createdAt       DateTime     @default(now())
  sourceProject   Project      @relation("ProjectTemplates", fields: [sourceProjectId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Workspace {
  id               String             @id @default(cuid())
  projectId        String
  name             String
  status           WorkspaceStatus    @default(PENDING)
  runtimeMode      String
  // Filesystem path (relative to the project storage root) for this
  // workspace's isolated git working tree. Allocated when the workspace
  // is created so each branch / agent run can have its own checkout
  // without colliding with other workspaces of the same project.
  gitPath          String?
  // Remote URL for this workspace's git working tree. Workspaces can point
  // at different remotes (e.g. an agent run targets a personal fork while
  // the primary workspace tracks the upstream project), so we store the
  // remote here instead of falling back to Project.gitRepositoryUrl for
  // every workspace. Nullable: a fresh workspace inherits the project-level
  // remote until the user explicitly configures one.
  gitRepositoryUrl String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessions         WorkspaceSession[]
  ports            WorkspacePort[]
  snapshots        FileSnapshot[]
  ideState         WorkspaceIdeState?

  @@index([projectId])
}

// Workspace-scoped IDE state (open tabs, file manifest, scroll positions, …).
// Mirrors ProjectIdeState 1:1 but keyed by workspace so each working tree can
// keep its own editor cursor, file tree, and unsaved buffers. listFiles falls
// back to the project-level state when a workspace has no entry yet, which
// keeps backward compatibility with workspaces created before this table
// existed.
model WorkspaceIdeState {
  workspaceId     String   @id
  state           Json
  version         Int      @default(1)
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceSession {
  id          String          @id @default(cuid())
  workspaceId String
  userId      String?
  status      WorkspaceStatus @default(STARTING)
  startedAt   DateTime        @default(now())
  stoppedAt   DateTime?
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WorkspacePort {
  id          String    @id @default(cuid())
  workspaceId String
  port        Int
  url         String?
  protocol    String    @default("http")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, port])
}

model FileSnapshot {
  id          String     @id @default(cuid())
  projectId   String
  workspaceId String?
  path        String
  contentHash String
  sizeBytes   Int
  metadata    Json?
  createdAt   DateTime   @default(now())
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([projectId, path])
}

model ProjectSnapshot {
  id              String   @id @default(cuid())
  projectId       String
  label           String?
  kind            String   @default("manual")
  manifest        Json
  storageKey      String?
  byteLength      Int?
  createdByUserId String?
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([createdByUserId])
}

model ProjectStorageObject {
  id            String   @id @default(cuid())
  projectId     String?
  key           String   @unique
  kind          String
  contentBase64 String
  byteLength    Int
  contentHash   String
  createdAt     DateTime @default(now())
  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([kind])
  @@index([createdAt])
}

model Deployment {
  id               String                 @id @default(cuid())
  projectId        String
  workspaceId      String?
  environmentId    String?
  environmentName  String                 @default("preview")
  status           DeploymentStatus       @default(QUEUED)
  provider         String
  url              String?
  previewUrl       String?
  productionUrl    String?
  framework        String?
  buildCommand     String?
  outputDirectory  String?
  branch           String?
  commitSha        String?
  customDomain     String?
  logs             Json                   @default("[]")
  metadata         Json                   @default("{}")
  rolledBackFromId String?
  // Replit-parity deploy metering idempotency marker: set once the deployment is
  // metered (mirrors WorkspaceRuntime.lastMeteredAt) so a re-reconcile never
  // double-charges. Dormant/SHADOW until BILLING_CREDITS_ENABLED. See metering-service.ts.
  lastMeteredAt    DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?
  canceledAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment      DeploymentEnvironment? @relation(fields: [environmentId], references: [id])

  @@index([projectId])
  @@index([projectId, workspaceId])
  @@index([projectId, environmentName])
  @@index([projectId, status])
}

model DeploymentEnvironment {
  id          String       @id @default(cuid())
  name        String       @unique
  deployments Deployment[]
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorUserId])
  // SIEM delivery keyset-paginates WHERE organizationId ORDER BY (createdAt, id)
  // every 5 min; without this composite it full-scanned + sorted the org's logs.
  @@index([organizationId, createdAt, id])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
}

model BillingCustomer {
  id             String       @id @default(cuid())
  organizationId String       @unique
  provider       String
  externalId     String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String
  planId             String
  externalId         String?            @unique
  status             SubscriptionStatus
  cancelAtPeriodEnd  Boolean            @default(false)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  // Stripe `event.created` of the latest applied subscription event. Used to drop
  // out-of-order webhook deliveries (Stripe does not guarantee ordering) that
  // would otherwise overwrite newer plan/seat/status state with stale data.
  lastStripeEventAt  DateTime?
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id])

  @@index([organizationId])
}

model Plan {
  id              String         @id @default(cuid())
  key             String         @unique
  name            String
  monthlyCents    Int
  limits          Json
  // Replit-parity additions (nullable → no behaviour change until populated):
  // annual price (effective discount) and the per-plan monthly credit grant in
  // USD cents. `stripePriceId` stays = the monthly price for backward compat;
  // the new *MonthlyId/*AnnualId columns are populated once annual products exist.
  annualCents          Int?
  includedCreditCents  Int?
  stripeProductId      String?
  stripePriceId        String?
  stripePriceMonthlyId String?
  stripePriceAnnualId  String?
  subscriptions        Subscription[]
}

model UsageEvent {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  type           String
  quantity       Int          @default(1)
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
}

model QuotaLedger {
  id             String       @id @default(cuid())
  organizationId String
  key            String
  delta          Int
  reason         String
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, key])
}

model QuotaOverride {
  id              String       @id @default(cuid())
  organizationId  String
  key             String
  limit           Int
  reason          String
  createdByUserId String?
  expiresAt       DateTime?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, key])
}

model StripeEvent {
  id             String        @id
  organizationId String?
  type           String
  processedAt    DateTime      @default(now())
  payload        Json
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([type])
}

model AiConversation {
  id        String      @id @default(cuid())
  projectId String?
  userId    String
  title     String?
  createdAt DateTime    @default(now())
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([projectId])
  @@index([userId])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolCalls      AiToolCall[]
  tokenUsage     AiTokenUsage?

  // listAiMessages runs WHERE conversationId = ? ORDER BY createdAt DESC on the
  // highest-volume table in the product (one row per chat message) on every
  // conversation open — without this it was a full table scan + sort.
  @@index([conversationId, createdAt])
}

