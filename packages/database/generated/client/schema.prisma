generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceStatus {
  PENDING
  STARTING
  RUNNING
  STOPPED
  FAILED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  READY
  FAILED
  CANCELED
}

enum SupportTicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum OrganizationMembershipState {
  ACTIVE
  SUSPENDED
}

enum CollaborationGroupSource {
  MANUAL
  SCIM
}

enum AccessGrantSubjectType {
  USER
  GROUP
}

enum AccessGrantResourceType {
  PROJECT
  ARTIFACT
  DEPLOYMENT
  DATASET
}

enum AccessGrantStatus {
  PENDING_CONSENT
  ACTIVE
  REVOKED
}

model User {
  id                          String                         @id @default(cuid())
  email                       String                         @unique
  name                        String?
  passwordHash                String?
  emailVerifiedAt             DateTime?
  mfaEnabled                  Boolean                        @default(false)
  mfaSecretCiphertext         String?
  platformAdmin               Boolean                        @default(false)
  // BCP-47 primary language tag (e.g. "en", "fr"). Null when the user
  // hasn't set a preference; the client falls back to navigator.language
  // and finally to "en". Drives SSR language selection via a cookie set
  // on session create.
  language                    String?
  // IANA timezone name (e.g. "Europe/Paris"). Null until the user sets it
  // in account/IDE settings; the client falls back to
  // Intl.DateTimeFormat().resolvedOptions().timeZone.
  timezone                    String?
  // Free-form per-user preferences blob set from the in-IDE settings panel
  // (notifications, event logs, feature toggles, profile fields). Shallow
  // -merged on PATCH so partial updates never clobber unrelated keys.
  // language/timezone stay first-class columns above because SSR + the SaaS
  // account-settings route read them directly.
  preferences                 Json?
  // Last time the user was active (throttled touch on authenticated requests +
  // session create). Drives Replit-parity inactivity GC (free accounts inactive
  // >= 1 year are eligible for deletion; paid exempt). Null until first touch. P8.
  lastActiveAt                DateTime?
  createdAt                   DateTime                       @default(now())
  updatedAt                   DateTime                       @updatedAt
  accounts                    Account[]
  sessions                    Session[]
  memberships                 OrganizationMember[]
  apiKeys                     ApiKey[]
  auditLogs                   AuditLog[]
  adminAuditLogs              AdminAuditLog[]
  conversations               AiConversation[]
  supportTickets              SupportTicket[]
  oauthConnections            OAuthConnection[]
  emailVerificationTokens     EmailVerificationToken[]
  passwordResetTokens         PasswordResetToken[]
  recoveryCodes               MfaRecoveryCode[]
  projectCollaborations       ProjectCollaborator[]
  projectActivity             ProjectActivity[]
  projectSnapshots            ProjectSnapshot[]
  galleryListings             GalleryListing[]               @relation("UserGalleryListings")
  projectIdeStateUpdates      ProjectIdeState[]
  collaborationPresence       CollaborationPresence[]
  collaborationComments       CollaborationComment[]
  collaborationShareLinks     ProjectShareLink[]
  agentMemories               AgentMemory[]
  agentMemoryPreferences      AgentMemoryPreference[]
  mcpInstalls                 McpInstall[]
  mcpUserConfig               McpUserConfig?
  agentRuns                   AgentRun[]
  userConnections             UserConnection[]
  linkedProjectConnections    ProjectConnectionLink[]        @relation("LinkedByUser")
  configuredOauthAppOverrides OrganizationOAuthAppOverride[] @relation("ConfiguredByUser")
  integrationFeatureRequests  IntegrationFeatureRequest[]
  notifications               Notification[]
  aiMessageFeedback           AiMessageFeedback[]
  spendLimits                 UserSpendLimit[]
  agentRoutingCards           AgentRoutingCard[]             @relation("AgentRoutingCardAuthor")
  runtimeWebSocketTickets     RuntimeWebSocketTicket[]
  importJobs                  ImportJob[]                    @relation("ImportJobActor")
  remixStorageSharesConsented RemixStorageShare[]            @relation("RemixStorageShareConsentedBy")
  rollbackOperations          RollbackIdempotencyRequest[]   @relation("RollbackOperationActor")
  reservedVmOperations        ReservedVmOperation[]          @relation("ReservedVmOperationActor")
  reservedVmBillingPeriods    ReservedVmBillingPeriod[]      @relation("ReservedVmBillingPeriodActor")
  cloudOperations             CloudOperation[]
  projectCheckpoints          ProjectCheckpoint[]            @relation("ProjectCheckpointCreator")
  invitedOrganizationMembers  OrganizationMember[]           @relation("OrganizationMemberInviter")
  createdOrganizationInvites  OrganizationInvite[]           @relation("OrganizationInviteCreator")
  accessGrantSubjects         ResourceAccessGrant[]          @relation("AccessGrantSubjectUser")
  accessGrantsCreated         ResourceAccessGrant[]          @relation("AccessGrantCreator")
  accessGrantsRevoked         ResourceAccessGrant[]          @relation("AccessGrantRevoker")
  loginLockout                AccountLockout?
}

/**
 * Per-account brute-force / credential-stuffing lock (defence-in-depth on top of
 * the per-IP login rate limit). One row per user; the failed-login counter is
 * incremented atomically in a row-locked transaction so concurrent attempts can't
 * race it. See login-throttle.ts for the pure state machine.
 */
model AccountLockout {
  userId        String    @id
  failedCount   Int       @default(0)
  firstFailedAt DateTime?
  lockedUntil   DateTime?
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lockedUntil])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  refreshHash    String?   @unique
  expiresAt      DateTime
  rotatedAt      DateTime?
  revokedAt      DateTime?
  lastReauthAt   DateTime?
  // Last authenticated activity on this session; drives the idle/inactivity
  // timeout (see session-idle.ts). Null on rows created before this column —
  // treated as the session's createdAt for the idle check.
  lastActiveAt   DateTime?
  // When set, this session is an admin impersonating another user; value = the
  // impersonating admin's user id (for audit / UI banner / traceability). P8.
  impersonatedBy String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id                         String                          @id @default(cuid())
  slug                       String                          @unique
  name                       String
  /// Optional CC address for billing notifications (spend alerts, invoices).
  billingEmail               String?
  createdAt                  DateTime                        @default(now())
  updatedAt                  DateTime                        @updatedAt
  members                    OrganizationMember[]
  invites                    OrganizationInvite[]
  projects                   Project[]
  billingCustomer            BillingCustomer?
  subscriptions              Subscription[]
  usageEvents                UsageEvent[]
  quotaLedger                QuotaLedger[]
  quotaOverrides             QuotaOverride[]
  stripeEvents               StripeEvent[]
  aiCostLedger               AiCostLedger[]
  auditLogs                  AuditLog[]
  abuseEvents                AbuseEvent[]
  supportTickets             SupportTicket[]
  featureFlags               FeatureFlag[]
  apiKeys                    ApiKey[]
  enterpriseSettings         EnterpriseOrganizationSettings?
  domains                    VerifiedDomain[]
  ssoConfigurations          SsoConfiguration[]
  scimTokens                 ScimToken[]
  customRoles                CustomRole[]
  siemWebhooks               SiemWebhook[]
  projectTemplates           ProjectTemplate[]
  agentMemories              AgentMemory[]
  agentMemoryPreferences     AgentMemoryPreference[]
  mcpInstalls                McpInstall[]
  agentRuns                  AgentRun[]
  oauthAppOverrides          OrganizationOAuthAppOverride[]
  connectorPolicies          OrganizationConnectorPolicy[]
  integrationFeatureRequests IntegrationFeatureRequest[]
  creditWallet               CreditWallet?
  creditLedger               CreditLedger[]
  creditPacks                CreditPack[]
  agentCheckpoints           AgentCheckpoint[]
  userSpendLimits            UserSpendLimit[]
  importJobs                 ImportJob[]
  remixStorageSharesAsSource RemixStorageShare[]             @relation("RemixStorageShareSourceOrganization")
  remixStorageSharesAsTarget RemixStorageShare[]             @relation("RemixStorageShareTargetOrganization")
  cloudTenant                CloudTenant?
  collaborationGroups        CollaborationGroup[]
  resourceAccessGrants       ResourceAccessGrant[]
}

model OrganizationMember {
  id               String                      @id @default(cuid())
  organizationId   String
  userId           String
  roleId           String
  state            OrganizationMembershipState @default(ACTIVE)
  invitedByUserId  String?
  joinedAt         DateTime                    @default(now())
  createdAt        DateTime                    @default(now())
  organization     Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy        User?                       @relation("OrganizationMemberInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  role             Role                        @relation(fields: [roleId], references: [id])
  groupMemberships CollaborationGroupMember[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId])
  @@index([roleId])
  @@index([invitedByUserId])
}

model OrganizationInvite {
  id              String       @id @default(cuid())
  organizationId  String
  email           String
  roleId          String
  tokenHash       String       @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdByUserId String?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role            Role         @relation(fields: [roleId], references: [id])
  createdBy       User?        @relation("OrganizationInviteCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdByUserId])
}

model Role {
  id          String               @id @default(cuid())
  key         String               @unique
  name        String
  system      Boolean              @default(false)
  permissions RolePermission[]
  members     OrganizationMember[]
  invites     OrganizationInvite[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

/// Provider-facing object-storage work is a durable saga. The kind is kept as
/// an enum so an unknown producer cannot silently create an unrecoverable job;
/// `payload.command` carries the extensible command inside each coarse kind.
enum ObjectStorageOperationKind {
  TENANT_MUTATION
  SIGNED_UPLOAD_CAPABILITY
  SIGNED_DOWNLOAD_CAPABILITY
  PROJECT_TRANSFER
  PROJECT_PERMANENT_DELETE
  PROJECT_REMIX_CLONE
  PROJECT_VERSION_GC
  ACCOUNT_PURGE_ERASURE
}

/// PREPARED/FAILED_SAFE may be retried without assuming a provider effect.
/// EFFECT_STARTED and VERIFYING are deliberately ambiguous after lease loss and
/// may only enter recovery through a verify-first claim. MANUAL_RECOVERY is a
/// durable freeze, never an automatic retry/unfreeze state.
enum ObjectStorageOperationStatus {
  PREPARED
  EFFECT_STARTED
  VERIFYING
  COMMITTED
  FAILED_SAFE
  MANUAL_RECOVERY
}

enum ObjectStorageCapabilityReservationStatus {
  RESERVED
  ISSUED
}

enum ObjectStorageVersionGcStatus {
  PENDING
  CLAIMED
  MANUAL_RECOVERY
}

enum ProjectPermanentDeletionArtifactState {
  PLANNED
  DELETED
  RETAINED
}

model Project {
  id                               String                               @id @default(cuid())
  organizationId                   String
  // Monotonic authority epoch. The database advances it exactly once whenever
  // organizationId changes, so an idempotency key from an earlier ownership
  // cycle can never authorize a later transfer round-trip.
  ownershipEpoch                   Int                                  @default(0)
  name                             String
  slug                             String
  description                      String?
  sourceType                       String                               @default("blank")
  templateName                     String?
  gitRepositoryUrl                 String?
  gitDefaultBranch                 String?
  persistentVolumeClaim            String?
  thumbnailUrl                     String?
  thumbnailUpdatedAt               DateTime?
  // Upper bound of every signed GCS capability ever returned for this project.
  // Tenant transfer must wait until it is in the past before bucket-name reuse.
  objectStorageCapabilityExpiresAt DateTime?
  // Durable write/transfer freeze installed before permanent provider erasure.
  // It is cleared automatically only while the exact pre-effect fences still
  // match; an ambiguous provider outcome requires verification or manual work.
  permanentDeletionStartedAt       DateTime?
  deletedAt                        DateTime?
  createdAt                        DateTime                             @default(now())
  updatedAt                        DateTime                             @updatedAt
  organization                     Organization                         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environments                     ProjectEnvironment[]
  envVars                          ProjectEnvVar[]
  secrets                          ProjectSecret[]
  collaborators                    ProjectCollaborator[]
  activity                         ProjectActivity[]
  templates                        ProjectTemplate[]                    @relation("ProjectTemplates")
  galleryListings                  GalleryListing[]                     @relation("ProjectGalleryListings")
  workspaces                       Workspace[]
  snapshots                        ProjectSnapshot[]
  manifestRevisions                ProjectManifestRevision[]
  storageObjects                   ProjectStorageObject[]
  deployments                      Deployment[]
  reservedVmOperations             ReservedVmOperation[]
  reservedVmBillingPeriods         ReservedVmBillingPeriod[]
  rollbackOperations               RollbackIdempotencyRequest[]
  fileSnapshots                    FileSnapshot[]
  conversations                    AiConversation[]
  ideState                         ProjectIdeState?
  collaborationPresence            CollaborationPresence[]
  collaborationComments            CollaborationComment[]
  shareLinks                       ProjectShareLink[]
  agentMemories                    AgentMemory[]
  agentMemoryPreferences           AgentMemoryPreference[]
  agentPatchProposals              AgentPatchProposal[]
  connectionLinks                  ProjectConnectionLink[]
  databaseInstances                DatabaseInstance[]
  skills                           ProjectSkill[]
  repairEvents                     AgentRepairEvent[]
  slugRedirects                    ProjectSlugRedirect[]
  runtimeWebSocketTickets          RuntimeWebSocketTicket[]
  importJobs                       ImportJob[]                          @relation("ImportJobTarget")
  targetRemixJobs                  RemixJob[]                           @relation("RemixJobTarget")
  sourceRemixShares                RemixStorageShare[]                  @relation("RemixStorageShareSourceProject")
  targetRemixShares                RemixStorageShare[]                  @relation("RemixStorageShareTargetProject")
  cloudBinding                     CloudProjectBinding?
  checkpoints                      ProjectCheckpoint[]
  releaseManifests                 ReleaseManifest[]
  objectStorageOperationScopes     ObjectStorageOperationProjectScope[]
  objectStorageVersionGcSchedule   ObjectStorageVersionGcSchedule?

  @@unique([organizationId, slug])
  @@index([organizationId])
}

/// Cross-replica idempotency, ownership, and evidence ledger for every
/// provider-facing object-storage effect. The scope hash is computed from the
/// canonical sorted (projectId, expectedOrganizationId, expectedDeletedAt)
/// tuples. idempotencyScopeHash omits mutable delete state so the same key with
/// a changed observation conflicts instead of creating a second operation.
model ObjectStorageOperation {
  id                          String                                   @id @default(cuid())
  kind                        ObjectStorageOperationKind
  status                      ObjectStorageOperationStatus             @default(PREPARED)
  scopeHash                   String
  idempotencyScopeHash        String
  idempotencyKey              String
  requestHash                 String
  payload                     Json
  preconditions               Json
  evidence                    Json?
  result                      Json?
  reservedCapabilityExpiresAt DateTime?
  ownerToken                  String?
  fencingToken                BigInt                                   @default(1)
  leaseExpiresAt              DateTime?
  attempts                    Int                                      @default(1)
  lastErrorCode               String?
  lastErrorMessage            String?
  preparedAt                  DateTime                                 @default(now())
  effectStartedAt             DateTime?
  verificationStartedAt       DateTime?
  committedAt                 DateTime?
  failedSafeAt                DateTime?
  manualRecoveryAt            DateTime?
  createdAt                   DateTime                                 @default(now())
  updatedAt                   DateTime                                 @updatedAt
  scopes                      ObjectStorageOperationProjectScope[]
  pinnedObjects               ObjectStorageOperationPinnedObject[]
  pinnedGenerations           ObjectStorageOperationPinnedGeneration[]
  permanentDeletionArtifacts  ProjectPermanentDeletionArtifactPlan[]
  capabilityReservations      ObjectStorageCapabilityReservation[]
  permanentDeletionReceipt    ProjectPermanentDeletionReceipt?
  versionGcSchedules          ObjectStorageVersionGcSchedule[]         @relation("ObjectStorageVersionGcLastOperation")

  @@unique([idempotencyScopeHash, idempotencyKey])
  @@index([scopeHash])
  @@index([status, leaseExpiresAt])
  @@index([kind, status, createdAt])
  @@index([reservedCapabilityExpiresAt])
}

/// Exact immutable source inventory for a clone. Normalized rows avoid the
/// operation JSON size ceiling and remain available for verify-first recovery.
model ObjectStorageOperationPinnedObject {
  operationId String
  ordinal     Int
  key         String
  size        BigInt
  generation  String
  contentHash String
  operation   ObjectStorageOperation @relation(fields: [operationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([operationId, ordinal])
  @@unique([operationId, key])
}

/// Exact provider generations selected for one bounded version-history GC
/// operation. Multiple generations of the same key are valid and are retained
/// for verify-first crash recovery until the operation history is removed.
model ObjectStorageOperationPinnedGeneration {
  operationId String
  ordinal     Int
  key         String
  generation  String
  size        BigInt
  contentHash String?
  operation   ObjectStorageOperation @relation(fields: [operationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([operationId, ordinal])
  @@unique([operationId, key, generation], map: "OSPinnedGeneration_operation_key_generation_key")
  @@index([operationId, key], map: "OSPinnedGeneration_operation_key_idx")
}

/// Durable, unbounded-by-project artifact preimage for permanent deletion.
/// Rows are populated in keyset batches before EFFECT_STARTED and become
/// immutable with the receipted operation, preserving the disposition digest's
/// forensic preimage after Project/ReleaseManifest cascade.
model ProjectPermanentDeletionArtifactPlan {
  operationId                String
  ordinal                    Int
  artifactRef                String
  artifactDigest             String
  projectReferenceCount      Int
  plannedOtherReferenceCount Int
  state                      ProjectPermanentDeletionArtifactState @default(PLANNED)
  finalOtherReferenceCount   Int?
  processedAt                DateTime?
  createdAt                  DateTime                              @default(now())
  operation                  ObjectStorageOperation                @relation(fields: [operationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([operationId, ordinal])
  @@unique([operationId, artifactRef], map: "PPDArtifactPlan_operation_artifact_key")
  @@index([operationId, state, ordinal], map: "PPDArtifactPlan_operation_state_ordinal_idx")
  @@index([artifactDigest], map: "PPDArtifactPlan_digest_idx")
}

/// Non-secret authorization ledger for signed URL issuance. The signature and
/// URL never enter PostgreSQL: a committed reservation only proves that the
/// project capability upper-bound was advanced before the provider was asked
/// to sign. A lost HTTP response safely creates another monotonic reservation.
model ObjectStorageCapabilityReservation {
  id                     String                                   @id @default(cuid())
  operationId            String
  attempt                Int
  fencingToken           BigInt
  authorizationTokenHash String
  method                 String
  objectKeyHash          String
  reservedExpiresAt      DateTime
  status                 ObjectStorageCapabilityReservationStatus @default(RESERVED)
  evidence               Json?
  reservedAt             DateTime                                 @default(now())
  issuedAt               DateTime?
  operation              ObjectStorageOperation                   @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([operationId, attempt])
  @@unique([operationId, fencingToken])
  @@index([status, reservedExpiresAt])
  @@index([objectKeyHash, reservedAt])
}

/// Historical scope snapshot. `projectIdSnapshot` and
/// `expectedOrganizationId` intentionally have no FK: evidence must remain
/// queryable after either tenant or project deletion. The nullable Project FK
/// exists only for efficient live fencing and becomes NULL on hard deletion.
model ObjectStorageOperationProjectScope {
  operationId                        String
  ordinal                            Int
  projectIdSnapshot                  String
  projectId                          String?
  expectedOrganizationId             String
  expectedDeletedAt                  DateTime?
  expectedPermanentDeletionStartedAt DateTime?
  deletionFenceDeletedAt             DateTime?
  createdAt                          DateTime               @default(now())
  operation                          ObjectStorageOperation @relation(fields: [operationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  project                            Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@id([operationId, ordinal])
  @@unique([operationId, projectIdSnapshot])
  @@index([projectId])
  @@index([projectIdSnapshot, createdAt])
  @@index([expectedOrganizationId, createdAt])
}

/// Durable project-level queue for noncurrent object-generation collection.
/// Claiming this row only chooses work; provider effects are represented by a
/// separate PROJECT_VERSION_GC ObjectStorageOperation and normalized generation
/// rows. The queue survives process loss and carries bounded retry/backoff state.
model ObjectStorageVersionGcSchedule {
  projectId              String                       @id
  expectedOrganizationId String
  status                 ObjectStorageVersionGcStatus @default(PENDING)
  notBefore              DateTime
  nextAttemptAt          DateTime
  ownerToken             String?
  fencingToken           BigInt                       @default(1)
  leaseExpiresAt         DateTime?
  attempts               Int                          @default(0)
  lastOperationId        String?
  lastErrorCode          String?
  lastErrorMessage       String?
  requestedAt            DateTime                     @default(now())
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  project                Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  lastOperation          ObjectStorageOperation?      @relation("ObjectStorageVersionGcLastOperation", fields: [lastOperationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, nextAttemptAt, projectId], map: "OSVersionGc_status_due_project_idx")
  @@index([lastOperationId], map: "OSVersionGc_last_operation_idx")
  @@index([expectedOrganizationId, requestedAt], map: "OSVersionGc_org_requested_idx")
}

/// Immutable replay receipt for permanent deletion. `projectId` is a snapshot,
/// not a Project FK, so the receipt is inserted alongside the final Project
/// deletion and remains independently queryable after every child cascade. Its
/// compact proof is a tamper-evident commitment; cascaded rows are not retained
/// as a receipt-side forensic preimage.
model ProjectPermanentDeletionReceipt {
  projectId              String                       @id
  operationId            String                       @unique
  organizationId         String
  scopeHash              String
  idempotencyScopeHash   String
  idempotencyKey         String
  requestHash            String
  capabilityUpperBoundAt DateTime?
  projectSnapshot        Json
  state                  ObjectStorageOperationStatus @default(COMMITTED)
  proof                  Json
  result                 Json
  deletedAt              DateTime
  completedAt            DateTime
  createdAt              DateTime                     @default(now())
  operation              ObjectStorageOperation       @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([idempotencyScopeHash, idempotencyKey])
  @@index([organizationId, deletedAt])
  @@index([requestHash])
}

// F13: preserves an old project slug after a rename so the previous canonical
// URL keeps redirecting to the current one until `expiresAt` (30 days). Purely
// additive: an `oldSlug` snapshot with an FK back to the project so rows cascade
// away when the project is hard-deleted.
model ProjectSlugRedirect {
  id        String   @id @default(cuid())
  projectId String
  oldSlug   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, oldSlug])
  @@index([oldSlug])
}

model AgentMemory {
  id                  String                @id @default(cuid())
  userId              String
  organizationId      String?
  projectId           String?
  sessionId           String?
  scope               String
  content             String
  summary             String
  embedding           Unsupported("vector")
  embeddingModel      String
  embeddingDimensions Int                   @default(1536)
  metadata            Json                  @default("{}")
  memoryType          String                @default("semantic")
  tags                String[]              @default([])
  references          String[]              @default([])
  importance          Float                 @default(0.5)
  source              String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  lastUsedAt          DateTime?
  expiresAt           DateTime?
  archivedAt          DateTime?
  accessCount         Int                   @default(0)
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization        Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project?              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, scope, updatedAt])
  @@index([memoryType, updatedAt])
  @@index([organizationId, updatedAt])
  @@index([projectId, updatedAt])
  @@index([sessionId, updatedAt])
}

model AgentMemoryPreference {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  projectId      String?
  enabled        Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([organizationId, updatedAt])
  @@index([projectId, updatedAt])
}

model ProjectIdeState {
  projectId       String   @id
  state           Json
  version         Int      @default(1)
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedBy       User?    @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

// Persists the AI-generated patch review queue across workbench reloads.
// Terminal status proposals (accepted, rejected, reverted) are hard-deleted
// because the audit trail lives in ProjectActivity; this table only holds
// proposals the user still has to decide on. The id is the existing
// "artifactId:actionId" composite the streaming runner already uses, so the
// nanostore key and the row id line up 1:1.
model AgentPatchProposal {
  id              String   @id
  projectId       String
  artifactId      String
  messageId       String
  actionId        String
  filePath        String
  relativePath    String
  originalContent String
  proposedContent String
  hunks           Json
  status          String
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([projectId, updatedAt])
}

// Durable history of the agent's AST self-repair pipeline: each time a streamed
// file fails validation and the agent retries (regenerates) it, the outcome is
// recorded here so the IDE can show a review UI of auto-repairs/errors. Unlike
// AgentPatchProposal (a transient working queue, hard-deleted on decision), this
// is an append-only audit log. Additive + inert until the IDE records/reads it.
model AgentRepairEvent {
  id              String   @id @default(cuid())
  projectId       String
  messageId       String?
  artifactId      String?
  actionId        String?
  relativePath    String
  attempt         Int      @default(1)
  // 'repaired' (validation passed after retry) | 'failed' (this attempt failed) |
  // 'gave_up' (retry budget exhausted, original written best-effort)
  outcome         String
  validationError String?
  repairError     String?
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// Per-project enable/disable overrides for the builtin Skills catalog (Replit
// parity). The catalog itself is a static, code-owned list (skills-catalog.ts);
// this table only stores the sparse set of projects that toggled a skill away
// from its default. Absent row => the skill is at its catalog default. skillId
// is the catalog slug. Unique per (project, skill).
model ProjectSkill {
  id        String   @id @default(cuid())
  projectId String
  skillId   String
  enabled   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, skillId])
  @@index([projectId])
}

// Installable GitHub-repo skills (F#27). A row records a PUBLIC GitHub skill repo
// that a project or its workspace has installed, plus the instructions fetched
// from the repo at install time. Polymorphic scope: scope='project' => scopeId is
// a projectId; scope='workspace' => scopeId is a workspaceId. No FK (polymorphic),
// so orphan cleanup is by the owning route. Layered ON TOP of the builtin catalog
// (ProjectSkill) — that table is untouched. Unique per (scope, scopeId, ownerRepo).
model InstalledSkill {
  id                String   @id @default(cuid())
  scope             String
  scopeId           String
  ownerRepo         String
  name              String
  description       String
  instructions      String
  homepageUrl       String?
  enabled           Boolean  @default(true)
  installedByUserId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // RPL-SK-001.3/.4 — provenance + security-audit + revoke state.
  // origin: where the skill came from ('catalog' | 'github' | 'workspace-file' | 'builtin').
  origin          String    @default("github")
  // sha256 of the audited disclosed surface (body + resources) — provenance integrity.
  contentHash     String?
  // Latest audit verdict: 'approved' | 'quarantined' | 'rejected'. A 'rejected' skill
  // is never persisted enabled; a 'quarantined' one is disabled pending approval.
  auditVerdict    String?
  // JSON array of AuditFinding for the UI's audit panel.
  auditFindings   String?
  auditedAt       DateTime?
  // Parsed interop-manifest fields (agentskills.io) when the skill is a real SKILL.md.
  manifestName    String?
  // JSON array of {path, kind, bytes} for progressive-disclosure L3 resources.
  resourcesJson   String?
  // Revoke is distinct from uninstall: the row stays for audit but is hard-disabled
  // and cannot be re-enabled until re-installed.
  revokedAt       DateTime?
  revokedByUserId String?
  revokeReason    String?

  @@unique([scope, scopeId, ownerRepo])
  @@index([scope, scopeId])
  @@index([ownerRepo])
}

// Append-only audit journal for interoperable Agent Skills (RPL-SK-001.3). Every
// consequential skill event — an install being approved/quarantined/REJECTED, a
// manual approval, an enable/disable, a revoke, an uninstall — writes one immutable
// row here so the security history of a project's skills is fully reconstructable.
// No FK (polymorphic scope like InstalledSkill); never updated after insert.
model SkillAuditEvent {
  id           String   @id @default(cuid())
  scope        String
  scopeId      String
  ownerRepo    String
  // 'install-approved' | 'install-quarantined' | 'install-rejected' | 'approve'
  // | 'revoke' | 'enable' | 'disable' | 'uninstall'
  action       String
  verdict      String?
  findingsJson String?
  contentHash  String?
  actorUserId  String?
  createdAt    DateTime @default(now())

  @@index([scope, scopeId])
  @@index([ownerRepo])
  @@index([createdAt])
}

model ProjectEnvironment {
  id        String   @id @default(cuid())
  projectId String
  name      String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

model ProjectSecret {
  id             String   @id @default(cuid())
  projectId      String
  key            String
  valueHash      String
  valueEncrypted String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
}

model ProjectEnvVar {
  id        String   @id @default(cuid())
  projectId String
  key       String
  value     String
  // Deployment scope this value applies to: development | preview | production.
  // Defaults to "production" so every pre-scope row keeps its existing meaning.
  scope     String   @default("production")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key, scope])
}

model ProjectCollaborator {
  id        String    @id @default(cuid())
  projectId String
  userId    String
  roleKey   String
  // When set, the grant is ignored after this instant. A time-limited share
  // link writes its own expiry here so redeeming it no longer confers permanent
  // access. Null = no expiry (direct invites).
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectActivity {
  id          String   @id @default(cuid())
  projectId   String
  actorUserId String?
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([actorUserId])
}

model CollaborationPresence {
  id             String   @id @default(cuid())
  projectId      String
  userId         String
  sessionId      String
  status         String   @default("online")
  filePath       String?
  cursor         Json?
  selection      Json?
  mode           String   @default("editing")
  terminalAccess Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, sessionId])
  @@index([projectId, updatedAt])
  @@index([userId])
}

model CollaborationComment {
  id         String    @id @default(cuid())
  projectId  String
  userId     String
  filePath   String?
  line       Int?
  selection  Json?
  body       String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId])
}

model ProjectShareLink {
  id              String    @id @default(cuid())
  projectId       String
  tokenHash       String    @unique
  roleKey         String
  expiresAt       DateTime
  createdByUserId String?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, expiresAt])
}

/// A tenant-scoped group. SCIM groups are written only through the authenticated
/// SCIM surface; interactive routes may only create and mutate MANUAL groups.
/// Deletion is soft so grants and the audit trail remain explainable.
model CollaborationGroup {
  id             String                     @id @default(cuid())
  organizationId String
  name           String
  normalizedName String
  source         CollaborationGroupSource   @default(MANUAL)
  externalId     String?
  deletedAt      DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        CollaborationGroupMember[]
  accessGrants   ResourceAccessGrant[]

  @@unique([organizationId, id])
  @@index([organizationId, deletedAt, id])
}

/// The composite foreign keys make cross-tenant group membership impossible at
/// the database boundary: both the group and the OrganizationMember must belong
/// to this exact organization.
model CollaborationGroupMember {
  id             String             @id @default(cuid())
  organizationId String
  groupId        String
  membershipId   String
  createdAt      DateTime           @default(now())
  group          CollaborationGroup @relation(fields: [organizationId, groupId], references: [organizationId, id], onDelete: Cascade)
  membership     OrganizationMember @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)

  @@unique([groupId, membershipId])
  @@index([organizationId, membershipId])
}

/// A resource-scoped authorization edge. External USER subjects start in
/// PENDING_CONSENT and confer no access until the subject accepts. Every grant
/// expires, every revocation is retained, and retry identity is request-hashed.
model ResourceAccessGrant {
  id               String                  @id @default(cuid())
  organizationId   String
  subjectType      AccessGrantSubjectType
  subjectUserId    String?
  subjectGroupId   String?
  resourceType     AccessGrantResourceType
  resourceId       String
  roleKey          String
  status           AccessGrantStatus
  expiresAt        DateTime
  acceptedAt       DateTime?
  consentVersion   String?
  grantedByUserId  String
  revokedAt        DateTime?
  revokedByUserId  String?
  revocationReason String?
  idempotencyKey   String?
  requestHash      String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subjectUser      User?                   @relation("AccessGrantSubjectUser", fields: [subjectUserId], references: [id], onDelete: Cascade)
  subjectGroup     CollaborationGroup?     @relation(fields: [organizationId, subjectGroupId], references: [organizationId, id], onDelete: Restrict)
  grantedBy        User                    @relation("AccessGrantCreator", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  revokedBy        User?                   @relation("AccessGrantRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([resourceType, resourceId, status, expiresAt])
  @@index([subjectUserId, status, expiresAt])
  @@index([subjectGroupId, status, expiresAt])
  @@index([organizationId, createdAt, id])
}

model ProjectTemplate {
  id              String       @id @default(cuid())
  sourceProjectId String
  organizationId  String
  name            String
  description     String?
  createdAt       DateTime     @default(now())
  sourceProject   Project      @relation("ProjectTemplates", fields: [sourceProjectId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Workspace {
  id               String                    @id @default(cuid())
  projectId        String
  name             String
  status           WorkspaceStatus           @default(PENDING)
  runtimeMode      String
  // P2d dev/prod split: 'development' (the editable workspace) or 'production'
  // (the checkout created when a deployment is published). Existing rows
  // backfill to 'development'. Not unique — a project keeps multiple dev
  // workspaces (primary + secondary agent-run checkouts); the prod checkout
  // is the single workspace with environment='production'.
  environment      String                    @default("development")
  // Filesystem path (relative to the project storage root) for this
  // workspace's isolated git working tree. Allocated when the workspace
  // is created so each branch / agent run can have its own checkout
  // without colliding with other workspaces of the same project.
  gitPath          String?
  // Remote URL for this workspace's git working tree. Workspaces can point
  // at different remotes (e.g. an agent run targets a personal fork while
  // the primary workspace tracks the upstream project), so we store the
  // remote here instead of falling back to Project.gitRepositoryUrl for
  // every workspace. Nullable: a fresh workspace inherits the project-level
  // remote until the user explicitly configures one.
  gitRepositoryUrl String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  project          Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessions         WorkspaceSession[]
  ports            WorkspacePort[]
  snapshots        FileSnapshot[]
  ideState         WorkspaceIdeState?
  readinessBeacons PreviewReadinessBeacon[]
  lifecycleEvents  WorkspaceLifecycleEvent[]
  postMortems      WorkspacePostMortem[]

  @@index([projectId])
}

// Workspace-scoped IDE state (open tabs, file manifest, scroll positions, …).
// Mirrors ProjectIdeState 1:1 but keyed by workspace so each working tree can
// keep its own editor cursor, file tree, and unsaved buffers. listFiles falls
// back to the project-level state when a workspace has no entry yet, which
// keeps backward compatibility with workspaces created before this table
// existed.
model WorkspaceIdeState {
  workspaceId     String    @id
  state           Json
  version         Int       @default(1)
  updatedByUserId String?
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceSession {
  id          String          @id @default(cuid())
  workspaceId String
  userId      String?
  status      WorkspaceStatus @default(STARTING)
  startedAt   DateTime        @default(now())
  stoppedAt   DateTime?
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  // Presence-cleanup sweeps by userId (nullable); without this it full-scanned.
  @@index([userId])
}

model WorkspacePort {
  id          String    @id @default(cuid())
  workspaceId String
  port        Int
  url         String?
  protocol    String    @default("http")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, port])
}

model FileSnapshot {
  id          String     @id @default(cuid())
  projectId   String
  workspaceId String?
  path        String
  contentHash String
  sizeBytes   Int
  metadata    Json?
  createdAt   DateTime   @default(now())
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([projectId, path])
}

model ProjectSnapshot {
  id              String   @id @default(cuid())
  projectId       String
  label           String?
  kind            String   @default("manual")
  manifest        Json
  storageKey      String?
  byteLength      Int?
  createdByUserId String?
  // Association used to pair a snapshot to the chat checkpoint that produced it.
  // Populated for AI "before-ai-change" snapshots; NULL for manual/legacy rows.
  // turnIndex is the assistant-turn ordinal within the conversation at the time
  // the snapshot was taken (the first snapshot of a turn has the smallest
  // createdAt). See migration 0046_snapshot_checkpoint_assoc.
  conversationId  String?
  turnIndex       Int?
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([createdByUserId])
  @@index([conversationId, turnIndex])
}

// P0-EX-08: append-only, integrity-bound ProjectManifest history. The latest
// manifestVersion is the project's component/artifact/scope source of truth;
// consumers re-canonicalize `manifest` and verify `digest` before acting.
model ProjectManifestRevision {
  id              String   @id @default(cuid())
  projectId       String
  schemaVersion   Int
  manifestVersion Int
  digest          String
  manifest        Json
  createdByUserId String?
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, manifestVersion])
  @@unique([projectId, digest])
  @@index([projectId, createdAt])
}

model ProjectStorageObject {
  id            String   @id @default(cuid())
  projectId     String?
  key           String   @unique
  kind          String
  contentBase64 String
  byteLength    Int
  contentHash   String
  createdAt     DateTime @default(now())
  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([kind])
  @@index([createdAt])
}

model Deployment {
  id                             String                    @id @default(cuid())
  projectId                      String
  workspaceId                    String?
  environmentId                  String?
  environmentName                String                    @default("preview")
  status                         DeploymentStatus          @default(QUEUED)
  provider                       String
  url                            String?
  previewUrl                     String?
  productionUrl                  String?
  framework                      String?
  buildCommand                   String?
  outputDirectory                String?
  branch                         String?
  commitSha                      String?
  customDomain                   String?
  logs                           Json                      @default("[]")
  metadata                       Json                      @default("{}")
  rolledBackFromId               String?
  // P2d dev/prod split: when a preview/staging deployment is published to
  // production, the new production deployment links back to its source here.
  parentDeploymentId             String?
  // Replit-parity deploy metering idempotency marker: set once the deployment is
  // metered (mirrors WorkspaceRuntime.lastMeteredAt) so a re-reconcile never
  // double-charges. Dormant/SHADOW until BILLING_CREDITS_ENABLED. See metering-service.ts.
  lastMeteredAt                  DateTime?
  // Machine size the user picked at publish (rate-card key, e.g. 'dedicated-1').
  // Applied verbatim as the runtime pod's requests==limits and used to price
  // compute metering — the machine you picked is the machine you pay for.
  machineSize                    String                    @default("shared-0.5")
  // Reserved VM is a distinct always-on lifecycle, not an Autoscale size.
  // runtimeVersion fences every in-place lifecycle/tier change.
  runtimeKind                    String                    @default("autoscale")
  runtimeVersion                 Int                       @default(0)
  // Monotonic external side-effect fence. Unlike an operation-local lease
  // counter, this never resets when a new runtime operation is created.
  runtimeFencingToken            Int                       @default(0)
  reservedVmTier                 String?
  reservedVmPriceCents           Int?
  reservedVmTermsVersion         String?
  reservedVmRateCardVersion      Int?
  reservedVmBillingReservationId String?                   @unique
  // Calendar-month renewal state. All deadlines are derived from PostgreSQL
  // time; STOP_REQUIRED is a durable instruction to stop compute only and
  // SUSPENDED means compute was proved stopped while the PVC/config remain.
  reservedVmBillingState         String?
  reservedVmCurrentPeriodStart   DateTime?
  reservedVmNextChargeAt         DateTime?
  reservedVmGraceEndsAt          DateTime?
  reservedVmStopRequestedAt      DateTime?
  // Stable claim retained across image, tier and runtime-kind changes.
  persistentStorageClaim         String?
  // Exact immutable DeploymentAccessPolicy version enforced by both s-* and
  // d-* edge paths. The database default exists only for rolling compatibility;
  // the edge resolves the matching policy row and denies when it is absent.
  accessPolicyVersion            Int                       @default(1)
  startedAt                      DateTime?
  finishedAt                     DateTime?
  canceledAt                     DateTime?
  createdAt                      DateTime                  @default(now())
  updatedAt                      DateTime                  @updatedAt
  project                        Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment                    DeploymentEnvironment?    @relation(fields: [environmentId], references: [id])
  reservedVmBillingReservation   LedgerReservation?        @relation("DeploymentReservedVmBillingReservation", fields: [reservedVmBillingReservationId], references: [id], onDelete: Restrict)
  reservedVmOperations           ReservedVmOperation[]
  reservedVmBillingPeriods       ReservedVmBillingPeriod[]

  @@index([projectId])
  @@index([projectId, workspaceId])
  @@index([projectId, environmentName])
  @@index([projectId, status])
}

// Durable saga for Reserved VM create/change/redeploy/decommission. PostgreSQL clock leases and the
// expected runtimeVersion fence make a crashed worker resumable without two
// callers billing or applying the same transition concurrently.
model ReservedVmOperation {
  id                     String    @id @default(cuid())
  projectId              String
  deploymentId           String
  organizationId         String
  actorUserId            String?
  idempotencyKey         String
  requestHash            String
  kind                   String
  status                 String    @default("PENDING")
  phase                  String    @default("RESERVED")
  fromRuntimeKind        String?
  fromTier               String?
  targetRuntimeKind      String
  targetTier             String?
  targetMachineSize      String
  targetCpuMillicores    Int
  targetMemoryMb         Int
  targetPriceCents       Int
  billingAmountCents     Int
  termsVersion           String
  rateCardVersion        Int
  expectedRuntimeVersion Int
  leaseOwner             String?
  leaseExpiresAt         DateTime?
  fencingToken           Int       @default(0)
  billingReservationId   String?   @unique
  response               Json?
  errorCode              String?
  errorMessage           String?
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployment         Deployment         @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  actorUser          User?              @relation("ReservedVmOperationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  billingReservation LedgerReservation? @relation("ReservedVmOperationBillingReservation", fields: [billingReservationId], references: [id], onDelete: Restrict)

  @@unique([projectId, idempotencyKey])
  @@index([deploymentId, createdAt])
  @@index([status, leaseExpiresAt])
}

// One immutable price snapshot per Reserved VM calendar-month period. A worker
// may retry a DUE/PAST_DUE row, but (deploymentId, periodStart), the fenced
// lease, and the canonical LedgerReservation make settlement exactly-once.
model ReservedVmBillingPeriod {
  id                    String             @id @default(cuid())
  projectId             String
  deploymentId          String
  organizationId        String
  // Nullable only for rolling compatibility; workers fail closed when absent.
  actorUserId           String?
  periodStart           DateTime
  periodEnd             DateTime
  tier                  String
  priceCents            Int
  termsVersion          String
  rateCardVersion       Int
  status                String             @default("DUE")
  attemptCount          Int                @default(0)
  reservationGeneration Int                @default(0)
  leaseOwner            String?
  leaseExpiresAt        DateTime?
  fencingToken          Int                @default(0)
  billingReservationId  String?            @unique
  graceEndsAt           DateTime?
  stopRequestedAt       DateTime?
  settledAt             DateTime?
  lastErrorCode         String?
  lastErrorMessage      String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  project               Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployment            Deployment         @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  actorUser             User?              @relation("ReservedVmBillingPeriodActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  billingReservation    LedgerReservation? @relation("ReservedVmBillingPeriodLedgerReservation", fields: [billingReservationId], references: [id], onDelete: Restrict)

  @@unique([deploymentId, periodStart])
  @@index([actorUserId, status])
  @@index([status, leaseExpiresAt])
  @@index([organizationId, status])
  @@index([deploymentId, status])
}

model DeploymentEnvironment {
  id          String       @id @default(cuid())
  name        String       @unique
  deployments Deployment[]
}

// P0-V3-08 deployment rollback manifest: one IMMUTABLE row appended per successful
// publish. It captures everything a DETERMINISTIC rollback needs so a published
// deployment can be restored to its previous version for real — independent of any
// live runtime/snapshot state. `deploymentId` is a plain pointer with NO FK on
// purpose: the manifest OUTLIVES the deployment row (a deployment can be pruned but
// its release must remain rollback-addressable). `version` is monotonic per
// (projectId, environment) so N-1 is unambiguous. A rollback that finds no previous
// manifest — or an artifact whose bytes no longer match `artifactDigest` — MUST fail
// closed rather than serve a blind/stale rollback.
model ReleaseManifest {
  id           String @id @default(cuid())
  projectId    String
  deploymentId String
  environment  String @default("preview")
  version      Int
  provider     String

  // 'static-snapshot' (artifactDigest = sha256 of the served bundle bytes) or
  // 'server-image' (artifactDigest = the image sha256, artifactRef = bare AR ref).
  artifactKind   String
  artifactRef    String
  artifactDigest String

  // Declared, never faked — NULL when the pipeline doesn't emit it:
  //  storeGeneration  = the ecode.lock Nix generation the release pinned (server)
  //  configDigest     = sha256 fingerprint of the effective env/config at publish
  //  dbMigrationPoint = latest applied DB migration marker at publish (RECORDED for
  //                     compatibility checks; image rollback never reverts the DB)
  storeGeneration  String?
  configDigest     String?
  dbMigrationPoint String?

  // Nullable only for rows created before migration 0100. New server-image
  // releases fail closed unless both strict, self-hashed envelopes are present.
  // runtimeSpec pins the exact machine/network/env/secret/database contract.
  // promotionEvidence stores server promotion provenance OR the tagged,
  // self-hashed static-rollback-routing edge proof; both survive Deployment and
  // AdminAuditLog pruning.
  runtimeSpec       Json?
  promotionEvidence Json?

  // I-AUTH-1: the access policy is part of release identity. Rollback restores
  // this exact version rather than inheriting a later/less restrictive mode.
  accessPolicyVersion Int @default(1)

  // P1-COV-05: immutable, versioned plan authority. Nullable only for legacy
  // rows created before 0099; all new publish/rollback paths reject null.
  planEntitlements      Json?
  projectManifestDigest String?

  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([projectId, environment, version])
  @@index([projectId, environment])
  @@index([deploymentId])
}

// Durable execution + response ledger for POST
// /projects/:projectId/deployments/rollback-to-previous. The row is both the
// project-scoped idempotency authority and the DB-clock lease/fencing authority
// for every rollback side effect. A replica may steal an orphan only after the
// lease expires; the old fence can no longer mutate or publish afterwards.
model RollbackIdempotencyRequest {
  id                      String    @id @default(cuid())
  projectId               String
  actorUserId             String?
  idempotencyKey          String
  requestFingerprint      String
  environment             String
  status                  String    @default("IN_PROGRESS")
  phase                   String    @default("CLAIMED")
  leaseOwner              String?
  leaseExpiresAt          DateTime?
  fencingToken            Int       @default(1)
  effectFencingToken      Int?
  deploymentId            String?   @unique
  expectedHeadVersion     Int?
  previousManifestId      String?
  projectManifestDigest   String?
  responseStatus          Int?
  responseContentLanguage String?
  responseBody            Json?
  completedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  project                 Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor                   User?     @relation("RollbackOperationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([projectId, idempotencyKey])
  @@index([actorUserId, status])
  @@index([status, leaseExpiresAt])
  @@index([projectId, environment, status])
  @@index([previousManifestId])
}

// Immutable, monotonic access policy history per project/environment. A change
// inserts a new row and atomically advances Deployment.accessPolicyVersion.
model DeploymentAccessPolicy {
  id              String   @id @default(cuid())
  projectId       String
  environment     String
  version         Int
  mode            String
  revision        String   @unique
  passwordHash    String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@unique([projectId, environment, version])
  @@index([projectId, environment, createdAt])
}

// One-shot capability used to move an already-authorized identity from the web
// origin to a dedicated deployment origin. Only tokenHash is persisted.
model DeploymentAccessExchangeTicket {
  id             String    @id @default(cuid())
  deploymentId   String
  userId         String
  policyVersion  Int
  policyRevision String
  tokenHash      String    @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([deploymentId, expiresAt])
  @@index([userId, expiresAt])
}

// Versioned Rate Card: the priced catalogue (machine sizes, compute-unit and
// request rates) served to the app and stamped on every metering event. A
// price change INSERTS a new version and flips `active` — history is never
// mutated, so past usage events stay auditable against the card that priced
// them. Seeded with version 1 (= packages/billing BUILTIN_RATE_CARD).
model RateCard {
  id          String   @id @default(cuid())
  version     Int      @unique
  active      Boolean  @default(false)
  data        Json
  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([active])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorUserId])
  // SIEM delivery keyset-paginates WHERE organizationId ORDER BY (createdAt, id)
  // every 5 min; without this composite it full-scanned + sorted the org's logs.
  @@index([organizationId, createdAt, id])
}

/// F23: operator resolution overlay for security events. Security events are
/// DERIVED from immutable AuditLog rows (auth/security/mfa actions); this table
/// carries the mutable resolution state (resolved + an operator note) keyed by
/// the audit-log id, without mutating the append-only audit trail. Additive-only.
model SecurityEventResolution {
  id               String   @id @default(cuid())
  auditLogId       String   @unique
  resolved         Boolean  @default(true)
  note             String?
  resolvedByUserId String?
  resolvedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([auditLogId])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
}

model BillingCustomer {
  id             String       @id @default(cuid())
  organizationId String       @unique
  provider       String
  externalId     String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String
  planId             String
  externalId         String?            @unique
  status             SubscriptionStatus
  cancelAtPeriodEnd  Boolean            @default(false)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  // Stripe `event.created` of the latest applied subscription event. Used to drop
  // out-of-order webhook deliveries (Stripe does not guarantee ordering) that
  // would otherwise overwrite newer plan/seat/status state with stale data.
  lastStripeEventAt  DateTime?
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id])

  @@index([organizationId])
}

model Plan {
  id                   String         @id @default(cuid())
  key                  String         @unique
  name                 String
  monthlyCents         Int
  limits               Json
  // Replit-parity additions (nullable → no behaviour change until populated):
  // annual price (effective discount) and the per-plan monthly credit grant in
  // USD cents. `stripePriceId` stays = the monthly price for backward compat;
  // the new *MonthlyId/*AnnualId columns are populated once annual products exist.
  annualCents          Int?
  includedCreditCents  Int?
  stripeProductId      String?
  stripePriceId        String?
  stripePriceMonthlyId String?
  stripePriceAnnualId  String?
  subscriptions        Subscription[]
}

/**
 * Admin-managed Stripe configuration (singleton row, id = "singleton"). Lets a
 * platform admin paste the live secret key + webhook signing secret in the admin
 * console instead of editing values-prod.yaml. Both secrets are encrypted at rest
 * (encryptJson) and write-only (never returned to the browser — only a hasX flag).
 * Per-plan price IDs are NOT secrets and live in Plan.* ; they are edited via the
 * same admin page. Billing reads this DB config FIRST and falls back to env, so an
 * empty row keeps the current env-based behaviour with zero regression.
 */
model StripeConfig {
  id               String   @id @default("singleton")
  secretKeyEnc     String?
  webhookSecretEnc String?
  updatedByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/**
 * Admin-managed social-login provider config (2026-06-30): a platform admin can
 * paste each sign-in provider's (GitHub / Google) OAuth client_id + client_secret
 * in /admin/oauth-providers instead of editing the platform Secret + redeploying.
 * One row per provider (provider key is the PK). The secret is stored encrypted
 * (encryptJson) and is write-only. The login flow reads this row DB-first and
 * falls back to the *_CLIENT_ID/*_CLIENT_SECRET env vars, so an absent row keeps
 * the current env-based behaviour with zero regression. `enabled = false`
 * disables the provider's sign-in button without clearing the stored credentials.
 */
model LoginProviderConfig {
  provider        String   @id // 'github' | 'google'
  clientId        String?
  clientSecretEnc String?
  scopes          String[]
  enabled         Boolean  @default(true)
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UsageEvent {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  type           String
  quantity       Int          @default(1)
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
  // Per-user usage reporting filters by userId over time; was a full-scan.
  @@index([userId, createdAt])
}

model QuotaLedger {
  id             String       @id @default(cuid())
  organizationId String
  key            String
  delta          Int
  reason         String
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, key])
}

model QuotaOverride {
  id              String       @id @default(cuid())
  organizationId  String
  key             String
  limit           Int
  reason          String
  createdByUserId String?
  expiresAt       DateTime?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, key])
}

model StripeEvent {
  id             String        @id
  organizationId String?
  type           String
  processedAt    DateTime      @default(now())
  payload        Json
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([type])
}

/**
 * A Stripe webhook whose side-effect processing threw (E28 admin health).
 * The full event payload is stored so an admin can replay it later — replays
 * re-run the SAME processing path with this stored payload (signature
 * verification is skipped by design: the payload came from our own store, not
 * the network). `resolvedAt` is set when a replay (or Stripe's own retry)
 * succeeds; unresolved rows feed the /admin/stripe "Failed webhooks" table.
 */
model StripeWebhookFailure {
  id         String    @id @default(cuid())
  eventId    String    @unique
  type       String
  payload    Json
  attempts   Int       @default(1)
  lastError  String
  failedAt   DateTime  @default(now())
  resolvedAt DateTime?

  @@index([resolvedAt, failedAt])
}

model AiConversation {
  id        String      @id @default(cuid())
  projectId String?
  userId    String
  title     String?
  createdAt DateTime    @default(now())
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([projectId])
  @@index([userId])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolCalls      AiToolCall[]
  tokenUsage     AiTokenUsage?

  // listAiMessages runs WHERE conversationId = ? ORDER BY createdAt DESC on the
  // highest-volume table in the product (one row per chat message) on every
  // conversation open — without this it was a full table scan + sort.
  @@index([conversationId, createdAt])
}

model AiToolCall {
  id        String    @id @default(cuid())
  messageId String
  name      String
  input     Json?
  output    Json?
  createdAt DateTime  @default(now())
  message   AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model AiTokenUsage {
  id                 String    @id @default(cuid())
  messageId          String    @unique
  provider           String
  model              String
  inputTokens        Int
  outputTokens       Int
  estimatedCostCents Int       @default(0)
  createdAt          DateTime  @default(now())
  message            AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

// F18 — per-request AI provider outcome, so the admin Providers panel can show a
// REAL p95 latency + 24h error rate per provider (previously metricsAvailable:false
// because no per-request provider metric source existed). Written best-effort on
// BOTH success and failure from the chat completion path; standalone, no FK to a
// message (an errored request may never create one). Indexed on (provider, createdAt)
// for the 24h rolling aggregation. Pruned by the usage-retention cron.
model ProviderRequestMetric {
  id         String   @id @default(cuid())
  provider   String
  model      String?
  latencyMs  Int
  errored    Boolean  @default(false)
  statusCode Int?
  source     String?
  createdAt  DateTime @default(now())

  @@index([provider, createdAt])
  @@index([createdAt])
}

// 👍/👎 a user left on an assistant chat message (2026-07-03). messageId is
// the client-side chat message id — standalone chats keep their transcript in
// browser IndexedDB and never persist an AiMessage row, so this deliberately
// has no AiMessage FK. One row per (userId, messageId): repeat votes upsert,
// retracting a vote (toggling the thumb off) deletes the row.
model AiMessageFeedback {
  id        String   @id @default(cuid())
  userId    String
  messageId String
  chatId    String?
  vote      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([messageId])
}

model AiCostLedger {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String?
  conversationId String?
  messageId      String?
  provider       String
  model          String
  inputTokens    Int
  outputTokens   Int
  costCents      Int
  reason         String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([projectId])
  @@index([conversationId])
}

model AbuseEvent {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  type           String
  severity       String
  metadata       Json?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // evaluateUsageAbuse queries by (organizationId, type) on the usage hot path.
  @@index([organizationId, type, createdAt])
}

model SupportTicket {
  id             String              @id @default(cuid())
  organizationId String?
  userId         String?
  subject        String
  status         SupportTicketStatus @default(OPEN)
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  // I25: real conversation thread. Virtual relation (no column on this table);
  // the FK lives on TicketMessage. Purely additive.
  messages       TicketMessage[]
}

// I25: one message in a support ticket's conversation (the user's replies AND
// admin responses). Additive — no change to SupportTicket's own columns.
enum TicketMessageAuthor {
  USER
  ADMIN
  SYSTEM
}

model TicketMessage {
  id           String              @id @default(cuid())
  ticketId     String
  authorType   TicketMessageAuthor
  authorUserId String?
  body         String
  createdAt    DateTime            @default(now())
  ticket       SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model FeatureFlag {
  id             String        @id @default(cuid())
  organizationId String?
  key            String
  enabled        Boolean       @default(false)
  rules          Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  // The email this token was issued to verify. At consume time the user's
  // CURRENT email must still match, so a token can't verify an address the user
  // changed away from. Nullable for backward-compat with pre-migration tokens.
  email     String?
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One-time-use record of consumed SAML assertion IDs, so a captured assertion
// can't be replayed within its validity window. Pruned by expiresAt.
model SamlAssertion {
  id             String   @id @default(cuid())
  organizationId String
  assertionId    String
  expiresAt      DateTime
  consumedAt     DateTime @default(now())

  @@unique([organizationId, assertionId])
  @@index([expiresAt])
}

// Short-lived, single-use credentials for browser -> API runtime WebSocket
// upgrades. Only a SHA-256 hash is persisted; the raw ticket travels in the
// Sec-WebSocket-Protocol header, never in the URL. The conditional consume in
// PrismaApiStore makes replay protection atomic across API replicas.
model RuntimeWebSocketTicket {
  id                  String    @id @default(cuid())
  tokenHash           String    @unique
  userId              String
  // Exact :workspaceId URL segment. It may be a project-id alias.
  workspaceId         String
  // Authoritative scope resolved server-side when the ticket is minted.
  projectId           String
  resolvedWorkspaceId String
  endpoint            String
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([resolvedWorkspaceId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId])
}

model EnterpriseOrganizationSettings {
  organizationId         String       @id
  ipAllowlist            String[]
  sessionDurationMinutes Int          @default(43200)
  requireMfaForAdmins    Boolean      @default(true)
  dataRetentionDays      Int          @default(365)
  legalHoldEnabled       Boolean      @default(false)
  ssoEnforced            Boolean      @default(false)
  ssoEnforcedAt          DateTime?
  updatedAt              DateTime     @updatedAt
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model VerifiedDomain {
  id                String       @id @default(cuid())
  organizationId    String
  domain            String
  verificationToken String
  verifiedAt        DateTime?
  redirectWww       Boolean      @default(true)
  wildcardEnabled   Boolean      @default(false)
  sslStatus         String       @default("pending_dns")
  createdAt         DateTime     @default(now())
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, domain])
  @@index([domain])
}

model SsoConfiguration {
  id              String       @id @default(cuid())
  organizationId  String
  type            String
  enabled         Boolean      @default(true)
  encryptedConfig String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type])
}

model ScimToken {
  id                String       @id @default(cuid())
  organizationId    String
  name              String
  tokenHash         String       @unique
  lastUsedAt        DateTime?
  createdAt         DateTime     @default(now())
  // F16 — 24h dual-valid rotation: on rotate the old hash moves to
  // previousTokenHash and rotatedAt is stamped; the previous token keeps
  // authenticating until rotatedAt + 24h so an IdP can roll over with no downtime.
  previousTokenHash String?
  rotatedAt         DateTime?
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([previousTokenHash])
}

model CustomRole {
  id             String       @id @default(cuid())
  organizationId String
  key            String
  name           String
  permissions    String[]
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

model SiemWebhook {
  id               String       @id @default(cuid())
  organizationId   String
  url              String
  secretHash       String
  secretCiphertext String
  enabled          Boolean      @default(true)
  lastDeliveredAt  DateTime?
  // Secondary keyset cursor paired with lastDeliveredAt so same-millisecond
  // audit rows beyond a batch boundary are not silently skipped on delivery.
  lastDeliveredId  String?
  createdAt        DateTime     @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, lastDeliveredAt])
}

model ApiKey {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  name           String
  keyHash        String        @unique
  keyPrefix      String?
  scopes         String[]
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

model OAuthConnection {
  id          String   @id @default(cuid())
  userId      String
  provider    String
  externalId  String
  accessHash  String
  refreshHash String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([userId])
}

enum McpDomain {
  AI_AGENTS
  CODE_EXECUTION
  DATABASES
  DEVOPS
  DEVELOPER_TOOLS
  COMMUNICATION
  PRODUCTIVITY
  KNOWLEDGE
  WEB_BROWSING
  SEARCH
  CLOUD
  SECURITY
  FILESYSTEM
  VERSION_CONTROL
  MONITORING
  OTHER
}

enum McpTransport {
  STDIO
  SSE
  STREAMABLE_HTTP
}

model McpCatalogEntry {
  id                  String       @id @default(cuid())
  slug                String       @unique
  name                String
  nameFr              String?
  description         String
  descriptionFr       String?
  domain              McpDomain
  tags                String[]
  tagsFr              String[]     @default([])
  author              String
  homepageUrl         String?
  iconUrl             String?
  version             String
  transport           McpTransport
  configTemplate      Json
  configSchema        Json         @default("{}")
  configSchemaFr      Json         @default("{}")
  installCount        Int          @default(0)
  featured            Boolean      @default(false)
  verified            Boolean      @default(false)
  featuredForIdePanel Boolean      @default(false)
  // Global admin kill-switch. false = hidden from the catalog, new installs
  // blocked, and existing installs soft-disabled (reversible on re-enable —
  // nothing is deleted). Defaults true so every existing row stays available.
  enabled             Boolean      @default(true)
  publishedAt         DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  installs            McpInstall[]

  @@index([domain])
  @@index([featured, verified])
  @@index([featuredForIdePanel])
  @@index([enabled])
}

model McpInstall {
  id             String          @id @default(cuid())
  catalogEntryId String
  userId         String
  organizationId String?
  alias          String
  configJson     Json
  enabled        Boolean         @default(true)
  installedAt    DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  catalogEntry   McpCatalogEntry @relation(fields: [catalogEntryId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, alias])
  @@index([organizationId])
  @@index([catalogEntryId])
}

// Server-side persistence for the MCP "Configuration" tab (manually authored
// `{ mcpServers: { … } }` JSON + the max sequential-LLM-step count). Replaces
// the previous localStorage-only storage (audit H5) so the chat/agent runtime
// can read a user's manually-configured servers — alongside their marketplace
// installs — when assembling the live MCP tool set. One row per user.
model McpUserConfig {
  id          String   @id @default(cuid())
  userId      String   @unique
  configJson  Json     @default("{}")
  maxLLMSteps Int      @default(5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Platform-wide (global) MCP policy — one tier ABOVE the per-org policy that
// reuses OrganizationConnectorPolicy. One row per catalog slug; `mode` is
// 'forced' | 'allowed' | 'blocked' (validated in the app, mirroring the org
// policy modes). Install resolution evaluates GLOBAL first, then the org
// policy. Absence of any row = default-open, so this is additive and inert
// until an admin sets a policy.
model McpGlobalPolicy {
  id        String   @id @default(cuid())
  slug      String   @unique
  mode      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mode])
}

// Server-side store for a shared conversation snapshot. Replaces embedding the
// full conversation in the share URL: a share mints a random, HMAC-signed
// token (stored here only as a hash) that the /share view redeems to fetch the
// snapshot. Standalone (no FK) so a share can outlive its project/author.
model ChatShare {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  conversationId String
  projectId      String
  authorUserId   String
  title          String?
  payloadJson    Json
  allowFork      Boolean   @default(false)
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([projectId])
  @@index([authorUserId])
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETE
  PARTIAL
  FAILED
}

enum AgentRunResultStatus {
  COMPLETE
  PARTIAL
  FAILED
}

model AgentRun {
  id             String           @id @default(cuid())
  organizationId String?
  userId         String?
  conversationId String?
  projectId      String?
  mode           String
  status         AgentRunStatus   @default(PENDING)
  reason         String?
  rolesPlanned   Json
  startedAt      DateTime         @default(now())
  completedAt    DateTime?
  metadata       Json             @default("{}")
  results        AgentRunResult[]
  consensus      ConsensusRecord?
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, startedAt])
  @@index([userId, startedAt])
  @@index([conversationId])
}

model AgentRunResult {
  id           String               @id @default(cuid())
  runId        String
  roleId       String
  status       AgentRunResultStatus
  summary      String
  files        Json                 @default("[]")
  risks        Json                 @default("[]")
  verification Json                 @default("[]")
  rawOutput    String?
  errorMessage String?
  startedAt    DateTime             @default(now())
  completedAt  DateTime?
  run          AgentRun             @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, roleId])
  @@index([runId])
}

enum ConsensusAlgorithm {
  QUORUM
  BYZANTINE_PBFT
  WEIGHTED_PLURALITY
}

enum ConsensusOutcome {
  ACCEPTED
  REJECTED
  PARTIAL
  ABSTAINED
}

model ConsensusRecord {
  id             String             @id @default(cuid())
  runId          String             @unique
  algorithm      ConsensusAlgorithm
  threshold      Float
  outcome        ConsensusOutcome
  agreementScore Float
  claimVotes     Json
  conflicts      Json               @default("[]")
  consolidated   Json
  rounds         Int                @default(1)
  durationMs     Int
  createdAt      DateTime           @default(now())
  run            AgentRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
}

/// Runtime/K8s orchestration state owned by services/workspace-manager.
/// Distinct from the user-facing Workspace model (which carries projectId
/// and runtimeMode for the IDE): this row tracks the actual pod, PVC,
/// service and agent-token-secret names allocated to the workspace, plus
/// the lifecycle status and the last-active timestamp used by the GC sweep.
/// The id matches the workspaceId used by services/api and the K8s object
/// names ("workspace-${id}", "pvc-${id}", "agent-token-${id}"), so this row
/// is effectively the canonical state shared between workspace-manager
/// replicas — replacing the file-backed JsonWorkspaceStore.
model WorkspaceRuntime {
  id                   String     @id
  orgId                String
  projectId            String
  plan                 Json
  status               String
  pvcName              String
  podName              String
  serviceName          String
  agentTokenSecretName String
  error                String?
  createdAt            DateTime   @default(now())
  lastActiveAt         DateTime   @default(now())
  // Last time this runtime's active compute was metered to the billing usage
  // ledger (P4 metering emitter). The GC meters the window from here (or
  // createdAt) to lastActiveAt on stop, then advances this marker — idempotent
  // across manager restarts. Null until first metered.
  lastMeteredAt        DateTime?
  /// Durable account-purge barrier. A runtime can be (re)provisioned only when
  /// this flag is false. The plan id + per-attempt token fence every release.
  purgeFrozen          Boolean    @default(false)
  purgePlanId          String?
  purgeFenceToken      String?
  purgeFrozenAt        DateTime?
  updatedAt            DateTime   @updatedAt
  purgePlan            PurgePlan? @relation(fields: [purgePlanId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([projectId])
  @@index([status, lastActiveAt])
  @@index([purgePlanId, purgeFrozen])
}

// --- Integrations panel: connector catalog, user-scoped connections,
// per-project links, enterprise overrides, reconnection alerts,
// integration feature requests. See docs/INTEGRATIONS_MASTER_PLAN.md.

model ConnectorCatalog {
  id          String @id @default(cuid())
  provider    String @unique
  displayName String
  description String
  category    String
  authType    String
  section     String
  logoUrl     String

  defaultClientId        String?
  defaultClientSecretEnc String?
  authorizeUrl           String?
  tokenUrl               String?
  revokeUrl              String?
  userInfoUrl            String?
  defaultScopes          String[]
  availableScopes        String[]

  apiKeyFields       Json?
  apiKeyTestEndpoint String?

  triggersSupported   String[]
  triggerDescriptions Json     @default("{}")

  webhookSupport          Boolean @default(false)
  webhookSignatureScheme  String?
  webhookSigningSecretEnc String?

  minPlanTier         String  @default("free")
  forAgentUse         Boolean @default(true)
  displayOrder        Int     @default(0)
  featuredForIdePanel Boolean @default(false)
  enabled             Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section, enabled])
  @@index([category])
}

model UserConnection {
  id                   String @id @default(cuid())
  userId               String
  provider             String
  externalAccountId    String
  externalAccountLabel String

  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  apiKeyFieldsEncrypted Json?

  scopes            String[]
  tokenExpiresAt    DateTime?
  status            String    @default("active")
  lastUsedAt        DateTime?
  // Cursor for the background token health-check sweep, kept separate from the
  // user-facing lastUsedAt so the sweep no longer clobbers "last used".
  lastHealthCheckAt DateTime?
  forAgentUse       Boolean   @default(true)

  oauthAppSource     String  @default("e_code_default")
  oauthAppOverrideId String?

  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  revokedAt       DateTime?

  user               User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthAppOverride   OrganizationOAuthAppOverride? @relation(fields: [oauthAppOverrideId], references: [id])
  projectLinks       ProjectConnectionLink[]
  reconnectionAlerts ReconnectionAlert[]

  @@unique([userId, provider, externalAccountId])
  @@index([userId, provider])
  @@index([status])
  // Background token-health sweep cursors on lastHealthCheckAt; was a full-scan.
  @@index([lastHealthCheckAt])
}

model ProjectConnectionLink {
  id               String    @id @default(cuid())
  projectId        String
  userConnectionId String
  linkedByUserId   String
  linkedAt         DateTime  @default(now())
  unlinkedAt       DateTime?

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userConnection UserConnection @relation(fields: [userConnectionId], references: [id], onDelete: Cascade)
  linkedByUser   User           @relation("LinkedByUser", fields: [linkedByUserId], references: [id])

  @@unique([projectId, userConnectionId])
  @@index([projectId])
  @@index([userConnectionId])
  // "who linked this" lookups + future user-offboarding scans; was a full-scan.
  @@index([linkedByUserId])
}

model OrganizationOAuthAppOverride {
  id                    String    @id @default(cuid())
  organizationId        String
  provider              String
  clientId              String
  clientSecretEncrypted String
  scopes                String[]
  configuredByUserId    String
  testedAt              DateTime?
  testStatus            String?
  testError             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  configuredByUser User             @relation("ConfiguredByUser", fields: [configuredByUserId], references: [id])
  userConnections  UserConnection[]

  @@unique([organizationId, provider])
}

model OrganizationConnectorPolicy {
  id                String   @id @default(cuid())
  organizationId    String
  provider          String
  enabled           Boolean  @default(true)
  allowedRoleKeys   String[]
  rateLimitOverride Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

model ReconnectionAlert {
  id               String    @id @default(cuid())
  userConnectionId String
  reason           String
  detectedAt       DateTime  @default(now())
  resolvedAt       DateTime?
  notifiedAt       DateTime?

  userConnection UserConnection @relation(fields: [userConnectionId], references: [id], onDelete: Cascade)

  @@index([userConnectionId, resolvedAt])
}

/// Per-user in-app notification feed (2026-07-02). A durable, user-scoped
/// inbox surfaced in the SaaS account area: producers write a row, the user
/// lists unread + recent and marks items read. Distinct from ReconnectionAlert
/// (a connector-domain resolve queue) — this is the general feed. The first
/// real producer is the connector reconnection alert: when one is raised the
/// API also drops a Notification so the feed is non-empty in reality.
model Notification {
  id            String    @id @default(cuid())
  userId        String
  /// Coarse routing/tone bucket, aligned with the preferences surfaces:
  /// "security" | "billing" | "deployments" | "team" | "system".
  category      String    @default("system")
  title         String
  body          String?
  /// Stable i18n descriptor for newly-produced notifications. Nullable keeps
  /// every historical row and older producer compatible with title/body.
  messageKey    String?
  messageParams Json?
  /// Optional in-app link the notification points at (e.g. /account/connections).
  linkUrl       String?
  /// Free-form producer metadata (e.g. the source alert id / provider) so the
  /// feed can be traced back to its origin without extra columns.
  metadata      Json?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Feed query is "this user's rows, unread first / newest first"; the partial
  // shape is covered well enough by the composite index below.
  @@index([userId, readAt, createdAt])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  /// Normalized (lowercased, trimmed) address; unique so re-subscribing is an
  /// idempotent upsert rather than a duplicate row.
  email          String    @unique
  /// Where the subscription came from ("footer", "newsletter-page", ...).
  source         String    @default("footer")
  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
}

/// Sales-contact leads submitted through the public /contact-sales form.
/// The row id doubles as the reference number quoted back to the prospect
/// (first 8 chars, uppercased), so sales can locate the lead from the
/// reference alone.
model ContactRequest {
  id        String   @id @default(cuid())
  email     String
  name      String?
  company   String
  teamSize  String?
  message   String
  /// Marketing page the form was submitted from ("/contact-sales", ...).
  pagePath  String?
  createdAt DateTime @default(now())
}

model IntegrationFeatureRequest {
  id                 String   @id @default(cuid())
  userId             String
  organizationId     String?
  integrationName    String
  useCaseDescription String
  status             String   @default("pending")
  createdAt          DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
}

/// Delivery / bounce / complaint notifications received from transactional
/// email providers. The recipient is stored verbatim (not joined to User) so
/// we can keep history for addresses that don't have an account — password
/// reset and email-verification flows fire before the user exists.
model EmailDeliveryEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String
  type            String
  email           String
  emailMessageId  String?
  subject         String?
  fromAddress     String?
  payload         Json
  receivedAt      DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([email])
  @@index([type])
  @@index([emailMessageId])
}

// ===========================================================================
// Replit-parity billing: credit wallet, effort-based checkpoints, and the
// admin-owned provider/model registry. All additive and dormant until the
// `BILLING_CREDITS_ENABLED` / `MODEL_REGISTRY_DB` flags are turned on, so the
// existing flat-rate Stripe billing path is unaffected. See
// docs/REPLIT_PARITY_SPEC.md.
// ===========================================================================

/// One USD-cent credit balance per organization. `balanceCents` is a
/// materialized cache of the sum of `CreditLedger.deltaCents`; the ledger is
/// the source of truth. `budgetCapCents` null = pay-as-you-go disabled.
model CreditWallet {
  id                        String         @id @default(cuid())
  organizationId            String         @unique
  balanceCents              Int            @default(0)
  currency                  String         @default("usd")
  // Replit "Usage Limit": cap on usage-based spend past included credits.
  budgetCapCents            Int?
  // Replit "Service Shutdown Limit": suspend usage-based services when reached.
  serviceShutdownCents      Int?
  autoTopupCents            Int?
  // Replit usage-based spend alerts (50/80/100%). De-dup marker: the highest
  // alert rung sent in the current billing period, and that period's start, so
  // each rung fires once and the ladder resets every period. Dormant until
  // BILLING_CREDITS_ENABLED. See spend-alerts.ts.
  lastSpendAlertPct         Int?
  lastSpendAlertPeriodStart DateTime?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  organization              Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries                   CreditLedger[]
}

/// Purchased credit pack (Replit). Credits expire 6 months after purchase, are
/// consumed earliest-expiring-first, and do NOT roll over after expiry.
/// `remainingCents` is decremented as the pack is drawn down.
model CreditPack {
  id                    String       @id @default(cuid())
  organizationId        String
  purchasedCents        Int
  remainingCents        Int
  expiresAt             DateTime
  stripePaymentIntentId String?
  createdAt             DateTime     @default(now())
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt])
}

enum CreditEntryKind {
  GRANT
  CONSUMPTION
  PAYG_CHARGE
  REFUND
  ADJUSTMENT
  EXPIRY
}

/// Append-only credit movements. Positive deltas are grants/refunds, negative
/// are consumption/charges. `checkpointId` links a CONSUMPTION to the agent
/// request that produced it. `expiresAt` supports daily/monthly grants that do
/// not roll over (Starter plan).
model CreditLedger {
  id             String          @id @default(cuid())
  walletId       String
  organizationId String
  deltaCents     Int
  kind           CreditEntryKind
  reason         String
  checkpointId   String?
  expiresAt      DateTime?
  metadata       Json?
  createdAt      DateTime        @default(now())
  wallet         CreditWallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // NOTE: a PARTIAL UNIQUE index "CreditLedger_org_checkpoint_payg_key" on
  // (organizationId, checkpointId) WHERE kind='PAYG_CHARGE' is defined in raw SQL
  // (migration 0045) — Prisma's schema can't express a WHERE-filtered unique index.
  // It backs recordPaygCharge's atomic create+catch-P2002 dedup. Do not drop it.

  @@index([organizationId, createdAt])
  @@index([walletId, createdAt])
  @@index([checkpointId])
  @@index([kind, expiresAt])
  // Org-scoped credit-expiry sweep filters organizationId + kind + expiresAt
  // together; the kind/expiresAt-only index wasn't org-scoped.
  @@index([organizationId, kind, expiresAt])
}

enum CheckpointStatus {
  PENDING
  COMPLETED
  FAILED
}

/// Effort-based checkpoint: exactly one per agent request. Bundles the real
/// effort (tokens + wall-time + attributed compute) into a single user-visible
/// credit charge (proof-of-work). `creditCents` is always >= the real provider
/// cost (`rawProviderCents`) by the configured margin.
model AgentCheckpoint {
  id               String           @id @default(cuid())
  organizationId   String
  userId           String?
  projectId        String?
  conversationId   String?
  runId            String?
  status           CheckpointStatus @default(PENDING)
  highPowerModel   Boolean          @default(false)
  extendedThinking Boolean          @default(false)
  // Replit Agent build tier (lite | economy | power) and Turbo mode (Pro:
  // ~2.5x faster, up to ~6x cost). Both feed the effort-based estimate.
  buildTier        String           @default("power")
  turboMode        Boolean          @default(false)
  inputTokens      Int              @default(0)
  outputTokens     Int              @default(0)
  wallMs           Int              @default(0)
  computeCents     Int              @default(0)
  rawProviderCents Int              @default(0)
  creditCents      Int              @default(0)
  startedAt        DateTime         @default(now())
  completedAt      DateTime?
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
  @@index([projectId])
  @@index([runId])
}

/// Replit-parity per-user spend limit (Enterprise). An admin can cap an
/// individual member's usage-based spend below the org/workspace default; the
/// per-member override takes precedence over the org budget cap.
model UserSpendLimit {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  limitCents     Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
}

/// Admin-owned AI provider registry. `apiKeySecret` is the *name* of a secret
/// in the platform secret manager — never the key material itself.
model ProviderConfig {
  id           String        @id @default(cuid())
  provider     String        @unique
  displayName  String
  enabled      Boolean       @default(false)
  apiKeySecret String?
  /// Admin-set platform API key for this provider, encrypted with encryptJson
  /// (write-only, never returned). Distinct from `apiKeySecret`, which holds only
  /// the NAME of a secret. Runtime resolves DB-first → *_API_KEY env fallback.
  apiKeyEnc    String?
  baseUrl      String?
  byokAllowed  Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  models       ModelConfig[]
}

/// Admin-owned model registry. Users may only see/use models with
/// `enabled = true` whose `enabledPlans` include their plan. Pricing here drives
/// effort-based credit cost.
model ModelConfig {
  id               String         @id @default(cuid())
  providerConfigId String
  modelId          String
  displayName      String
  enabled          Boolean        @default(false)
  enabledPlans     Json
  isHighPower      Boolean        @default(false)
  supportsThinking Boolean        @default(false)
  inputCentsPerM   Int
  outputCentsPerM  Int
  contextWindow    Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  providerConfig   ProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)

  @@unique([providerConfigId, modelId])
  @@index([enabled])
}

enum DatabaseInstanceStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  FAILED
  DELETED
}

/// Managed Postgres database for a project (Replit "Database" tab). Phase-1
/// scaffold for point-in-time rollback: the row models the instance and its
/// retention window; provisioning + WAL-based PITR are wired in later phases and
/// gated behind DB_ROLLBACK_ENABLED, so this table is dormant until then.
/// `retentionDays` is the plan-derived PITR window (Pro = 28).
model DatabaseInstance {
  id                     String                 @id @default(cuid())
  projectId              String
  organizationId         String
  // P2d dev/prod split: a project has a `development` instance (its workspace
  // DB) and, once published, a separate `production` instance. Existing rows
  // backfill to 'development', preserving the prior one-per-project behaviour.
  environment            String                 @default("development")
  status                 DatabaseInstanceStatus @default(PROVISIONING)
  engine                 String                 @default("postgres")
  region                 String?
  sizeBytes              BigInt                 @default(0)
  retentionDays          Int                    @default(7)
  pitrEnabled            Boolean                @default(false)
  // Durable provisioning lifecycle. A request is never allowed to remain
  // PROVISIONING past this deadline; FAILED keeps a stable, non-secret reason
  // and can be atomically claimed for a retry.
  provisioningDeadlineAt DateTime?
  lastErrorCode          String?
  lastErrorAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  project                Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshots              DatabaseSnapshot[]
  restores               DatabaseRestore[]
  remixJobsAsTarget      RemixJob[]             @relation("RemixJobTargetDatabase")

  @@unique([projectId, environment])
  @@index([organizationId])
  @@index([status])
  @@index([status, provisioningDeadlineAt])
}

/// A recovery point for a DatabaseInstance — either a scheduled automatic
/// snapshot or a user-requested manual one. `lsn` records the Postgres WAL
/// position so a restore can target an exact point in time; `expiresAt` is the
/// retention horizon (older snapshots are pruned). Dormant until PITR ships.
model DatabaseSnapshot {
  id                 String           @id @default(cuid())
  databaseInstanceId String
  kind               String           @default("auto")
  label              String?
  lsn                String?
  sizeBytes          BigInt           @default(0)
  storageKey         String?
  createdByUserId    String?
  createdAt          DateTime         @default(now())
  expiresAt          DateTime?
  databaseInstance   DatabaseInstance @relation(fields: [databaseInstanceId], references: [id], onDelete: Cascade)

  @@index([databaseInstanceId, createdAt])
  @@index([expiresAt])
}

enum DatabaseRestoreStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// A point-in-time restore request for a DatabaseInstance. Targets either a
/// specific snapshot or an arbitrary `targetTimestamp` within the retention
/// window (true PITR). Status moves PENDING → RUNNING → COMPLETED/FAILED. The
/// restore executor is a later phase; rows can be created dormant for the UI.
model DatabaseRestore {
  id                 String                @id @default(cuid())
  databaseInstanceId String
  snapshotId         String?
  targetTimestamp    DateTime?
  status             DatabaseRestoreStatus @default(PENDING)
  requestedByUserId  String?
  error              String?
  createdAt          DateTime              @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  databaseInstance   DatabaseInstance      @relation(fields: [databaseInstanceId], references: [id], onDelete: Cascade)

  @@index([databaseInstanceId, createdAt])
  @@index([status])
  // "restores requested by user" lookups; was a full-scan (no FK on this column).
  @@index([requestedByUserId])
}

/// Fenced, resumable schema migration executed before a production publish.
/// The SQL itself stays in project storage; only the immutable name/hash plan is
/// persisted so recovery can reconcile the target without retaining user SQL.
model DBMigrationExecution {
  id                       String    @id @default(cuid())
  projectId                String
  organizationId           String
  environment              String
  state                    String    @default("LOCK_ACQUIRED")
  idempotencyKey           String
  requestHash              String
  activeLock               String?   @unique
  ownerToken               String?
  version                  Int       @default(0)
  leaseExpiresAt           DateTime?
  attempt                  Int       @default(1)
  plan                     Json
  statementsSha256         String
  statementCount           Int       @default(0)
  appliedStatements        Int       @default(0)
  backwardCompatible       Boolean
  forwardCompatible        Boolean
  backupId                 String?
  backupVerifiedAt         DateTime?
  backupVerificationMethod String?
  deploymentId             String?
  createdByUserId          String?
  errorCode                String?
  startedAt                DateTime  @default(now())
  completedAt              DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@unique([projectId, idempotencyKey])
  @@index([projectId, environment, state])
  @@index([activeLock, leaseExpiresAt])
}

// ---------------------------------------------------------------------------
// Scheduled tasks (cron). Backs BOTH the Workflows panel schedules AND the
// Replit-parity "Scheduled" deployment type: a command that runs on a cron,
// exits, and is billed for its RUN TIME (duration x machine size) rather than
// 24/7. Before this, cron expressions were validated and a nextRunAt was
// computed, but nothing ever fired them — the feature was dead.
// ---------------------------------------------------------------------------

enum ScheduledTaskKind {
  /// Runs an existing Workflows-panel workflow (its ordered steps).
  WORKFLOW
  /// Replit "Scheduled Deployment": one shell command, on a cron.
  DEPLOYMENT
}

enum ScheduledTaskRunStatus {
  RUNNING
  SUCCESS
  FAILED
  TIMED_OUT
  /// The previous run was still RUNNING when this tick fired (concurrencyPolicy=FORBID).
  SKIPPED
  CANCELED
}

/// One cron-scheduled unit of work owned by a project. `nextRunAt` is the claim
/// token: the scheduler advances it inside a conditional UPDATE, so exactly one
/// api replica can ever own a given tick (no distributed lock needed).
model ScheduledTask {
  id              String             @id @default(cuid())
  organizationId  String
  projectId       String
  kind            ScheduledTaskKind  @default(DEPLOYMENT)
  name            String
  /// Shell command for DEPLOYMENT tasks (run as `sh -lc <command>` in the project sandbox).
  command         String             @default("")
  /// For WORKFLOW tasks: the workflow id inside VIBECORE_WORKFLOWS_STATE.
  workflowId      Int?
  /// 5-field cron expression, already normalized.
  cron            String
  /// IANA timezone the cron fields are interpreted in.
  timezone        String             @default("UTC")
  /// Machine size key. The size catalogue itself is owned elsewhere; this is the field only.
  machineSize     String             @default("shared-0.5")
  enabled         Boolean            @default(true)
  /// Hard kill after this many seconds.
  timeoutSeconds  Int                @default(900)
  /// FORBID (skip if the previous run is still going) | ALLOW.
  concurrency     String             @default("FORBID")
  /// Replit parity: a failed scheduled run is NOT retried by default.
  maxRetries      Int                @default(0)
  notifyOnFailure Boolean            @default(true)
  lastRunAt       DateTime?
  lastStatus      String?
  /// Next fire time (UTC). NULL when disabled.
  nextRunAt       DateTime?
  createdByUserId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  /// Tombstone retained until Project permanent deletion so in-flight Pod/Secret
  /// identities remain physically recoverable after a user deletes the task.
  deletedAt       DateTime?
  runs            ScheduledTaskRun[]

  // Active workflow tasks are unique through the partial PostgreSQL index
  // ScheduledTask_projectId_kind_workflowId_key. Prisma cannot model a
  // partial unique index; tombstones deliberately retain the same identity.
  /// The scheduler's hot query: enabled tasks whose nextRunAt is due.
  @@index([enabled, nextRunAt])
  @@index([projectId])
  @@index([projectId, deletedAt])
  @@index([organizationId])
}

/// One execution. Holds the FULL captured stdout+stderr, the real exit code, the
/// real duration, and the billing outcome for that duration.
model ScheduledTaskRun {
  id             String                 @id @default(cuid())
  taskId         String
  organizationId String
  projectId      String
  status         ScheduledTaskRunStatus @default(RUNNING)
  /// "schedule" | "manual"
  trigger        String                 @default("schedule")
  attempt        Int                    @default(1)
  /// The cron instant this run is for (may differ from startedAt under load).
  scheduledFor   DateTime
  startedAt      DateTime               @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  exitCode       Int?
  /// Full captured output (stdout + stderr), not a tail.
  logs           String                 @default("")
  error          String?
  machineSize    String?
  /// Billed compute units for this run (duration x size). NULL until metered.
  computeUnits   Float?
  costCents      Float?
  meteredAt      DateTime?
  task           ScheduledTask          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, startedAt])
  @@index([projectId, startedAt])
  @@index([status])
}

/// Versioned Agent Routing Card: maps agent modes (Lite/Economy/Power) and
/// switches (High effort/Turbo) + the harness classifier to concrete provider
/// models with cost-of-revenue and user pricing. `data` is the serialized
/// AgentRoutingCard document (packages/billing agent-routing.ts). A config
/// change inserts a NEW version and closes the previous one (effectiveTo) —
/// never a deployment, never a mutation of history.
model AgentRoutingCard {
  id              String    @id @default(cuid())
  version         Int       @unique
  active          Boolean   @default(false)
  data            Json
  effectiveFrom   DateTime  @default(now())
  effectiveTo     DateTime?
  /// Date the cost-of-revenue figures were sourced from provider pricing.
  sourceDate      String?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  createdBy       User?     @relation("AgentRoutingCardAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([active])
}

/// One row per routed agent LLM call (admin-only, never shown to the client):
/// who called, which mode/switches, whether high-effort escalated, the REAL
/// provider+model used, tokens, cost-of-revenue, credits billed and margin.
/// Cents are stored as millicents (Int) to keep fractional cost exact.
model AgentCallLog {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  userId             String?
  organizationId     String?
  projectId          String?
  /// lite | economy | power
  mode               String
  highEffort         Boolean  @default(false)
  /// true when high-effort actually escalated this call to the escalation line
  escalated          Boolean  @default(false)
  turbo              Boolean  @default(false)
  /// Routing line that priced the call: mode key, high-effort, turbo or classifier.
  lineKey            String
  provider           String
  model              String
  tokensIn           Int      @default(0)
  tokensOut          Int      @default(0)
  /// Coût de revient in millicents (1/1000 cent).
  costMillicents     Int      @default(0)
  /// Credits billed to the user, in cents (0 when billedToUser=false).
  creditCents        Int      @default(0)
  /// creditCents*1000 - costMillicents (negative = platform absorbed cost).
  marginMillicents   Int      @default(0)
  billedToUser       Boolean  @default(true)
  routingCardVersion Int
  /// chat | classifier | continuation…
  source             String   @default("chat")

  @@index([createdAt])
  @@index([lineKey, createdAt])
  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
}

/// Checkpoint PROJET coordonné (plan §15, CTR-CHECKPOINT) : barrière logique
/// + snapshots par composant (FILES/DATABASE/POD optionnel) + manifeste visible
/// seulement une fois TOUT vérifié sous la même barrière. Rien à voir avec
/// AgentCheckpoint (facturation par requête agent).
model ProjectCheckpoint {
  id                String    @id @default(cuid())
  projectId         String
  state             String    @default("PREPARING")
  logicalBarrierId  String?
  /// crash-consistent | UNKNOWN. `application-consistent` is NOT emitted: it
  /// would require quiescing the in-pod writers (dev server, terminal, agent),
  /// which the API-level barrier cannot reach. See CHECKPOINT_CONTRACT §Cohérence.
  consistencyLevel  String?
  /// { components: [{componentKind, snapshotId, hash, verified, …}], restoreCompatibility, dependenciesDeclared }
  manifest          Json?
  error             String?
  expiresAt         DateTime?
  createdByUserId   String?
  /// Stable retry identity. A repeated key is accepted only when requestHash
  /// matches; a different request with the same key is refused.
  idempotencyKey    String?   @unique
  requestHash       String?
  /// Non-null only while this row owns the one active barrier for its project.
  /// The unique constraint is the durable per-project singleton; an expired
  /// owner is cleared under the same project lock before a successor acquires.
  barrierProjectId  String?   @unique
  barrierOwnerToken String?
  barrierFence      Int       @default(0)
  /// Barrier lease deadline. The write barrier is read from THIS COLUMN, not from
  /// process memory: the API runs 2..6 replicas (values-prod.yaml), so an
  /// in-process barrier is invisible to the other replicas and freezes nothing.
  /// A past/NULL value means thawed — expiry IS the guaranteed thaw, even if the
  /// process holding the checkpoint dies mid-flight.
  barrierExpiresAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ProjectCheckpointCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([barrierProjectId, barrierExpiresAt])
  @@index([state, createdAt])
}

/// A secure project remix (fork) run. Tracks the normative state machine
/// (PENDING → SNAPSHOT_PINNED → CREDENTIALS_DETACHED → SOURCE_SANITIZED
/// → CLONING → SCANNING → STORAGE_PINNED → STORAGE_POLICY_APPLIED
/// → DATABASE_PINNED → DB_FORKING → INDEXING → COMPLETED) so the
/// credentials-detached-before-cloning invariant is auditable. `detachedKeys`
/// holds ONLY secret/env KEYS (references) — never a value. `scanFindings`
/// records materialized-secret hits (key + location, never the value).
model RemixJob {
  id                       String             @id @default(cuid())
  sourceProjectId          String
  targetProjectId          String?
  organizationId           String
  actorUserId              String?
  state                    String             @default("PENDING")
  /// Tenant-scoped retry key. Legacy rows may be null; every new API job has one.
  idempotencyKey           String?
  /// SHA-256 of the non-secret, authorization-relevant request shape.
  requestHash              String?
  /// Optimistic-concurrency fence for state/ownership transitions.
  version                  Int                @default(0)
  /// Fencing token and renewable lease held by the current executor.
  operationToken           String?
  operationExpiresAt       DateTime?
  /// IMMUTABLE source release the clone reproduces. When set, CLONING reads the
  /// files from this pinned ProjectSnapshot archive (not the live source), so a
  /// gallery remix is reproducible from the exact published release. NULL for a
  /// legacy live-source remix. This is the provenance pin (I-RMX-PIN).
  sourceSnapshotId         String?
  /// SHA-256 of the pinned ProjectSnapshot archive bytes.
  sourceSnapshotHash       String?
  /// The gallery listing this remix was launched from, if any (provenance).
  sourceListingId          String?
  /// { secretKeys: string[], envVarKeys: string[] } — references only.
  detachedKeys             Json?
  /// DETACH | CLONE | SHARE_WITH_CONSENT
  storagePolicy            String             @default("DETACH")
  /// Versioned explicit consent for SHARE_WITH_CONSENT; null for other policies.
  storageConsentVersion    String?
  /// Redacted per-object source/target verification facts (key,size,generation,hash).
  storageInventory         Json?
  /// Read-only source binding created for SHARE_WITH_CONSENT.
  storageShareId           String?
  /// SecretScanFinding[] { path, secretKey, line } — never the value.
  scanFindings             Json?
  /// Verified target ProjectIdeState staged while the target remains hidden.
  /// It becomes canonical only in the same transaction as COMPLETED + reveal.
  targetIdeState           Json?
  /// Canonical SHA-256 pin for targetIdeState (guards JSONB/retry tampering).
  targetIdeStateDigest     String?
  /// Count of value-lines scrubbed out of the clone during CLONING.
  scrubbedCount            Int                @default(0)
  /// VERSIONED license captured at remix time from the source listing —
  /// { licenseId, licenseTextSha256, sourceListingId, capturedAt }. Immutable on
  /// the job: later edits to the listing's license never rewrite what THIS remix
  /// was accepted under (I-RMX-3, P0-V3-05). Null for a same-org self-remix.
  licenseSnapshot          Json?
  /// Version of the remix consent text the REMIXER explicitly accepted before
  /// the clone ran (REMIX_CONSENT_VERSION at accept time). Null = no consent
  /// captured (same-org self-remix only — a gallery remix REQUIRES it).
  consentVersion           String?
  /// PiiFinding[] { path, kind, line } — kind of PII masked, never the value.
  piiFindings              Json?
  /// Count of PII spans masked out of the clone during SOURCE_SANITIZED.
  piiMaskedCount           Int                @default(0)
  /// Honest marker: was a physical isolated DB provisioned, or deferred?
  dbForked                 Boolean            @default(false)
  /// { instanceId, environment, targetTime, lsn? } — never a connection URI.
  sourceDatabasePin        Json?
  /// Target DatabaseInstance row while the isolated CNPG recovery is running.
  targetDatabaseInstanceId String?
  /// Desired terminal state while physical cleanup is in progress.
  cleanupTerminalState     String?
  /// Stable public code; `error` remains a redacted user-facing message.
  errorCode                String?
  error                    String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  targetProject            Project?           @relation("RemixJobTarget", fields: [targetProjectId], references: [id], onDelete: SetNull)
  targetDatabaseInstance   DatabaseInstance?  @relation("RemixJobTargetDatabase", fields: [targetDatabaseInstanceId], references: [id], onDelete: SetNull)
  storageShare             RemixStorageShare? @relation("RemixJobStorageShare", fields: [storageShareId], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([sourceProjectId])
  @@index([organizationId, createdAt])
  @@index([targetProjectId])
  @@index([state, operationExpiresAt])
}

/// Explicit read-only object-storage sharing created by a remix. The source
/// bucket is never inferred from project lineage: without this durable,
/// versioned consent row, a target project cannot read source objects.
model RemixStorageShare {
  id                   String       @id @default(cuid())
  sourceProjectId      String
  targetProjectId      String       @unique
  sourceOrganizationId String
  targetOrganizationId String
  consentVersion       String
  consentedByUserId    String?
  consentedAt          DateTime     @default(now())
  sourceInventory      Json
  state                String       @default("ACTIVE")
  revokedAt            DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  sourceProject        Project      @relation("RemixStorageShareSourceProject", fields: [sourceProjectId], references: [id], onDelete: Cascade)
  targetProject        Project      @relation("RemixStorageShareTargetProject", fields: [targetProjectId], references: [id], onDelete: Cascade)
  sourceOrganization   Organization @relation("RemixStorageShareSourceOrganization", fields: [sourceOrganizationId], references: [id], onDelete: Cascade)
  targetOrganization   Organization @relation("RemixStorageShareTargetOrganization", fields: [targetOrganizationId], references: [id], onDelete: Cascade)
  consentedBy          User?        @relation("RemixStorageShareConsentedBy", fields: [consentedByUserId], references: [id], onDelete: SetNull)
  remixJobs            RemixJob[]   @relation("RemixJobStorageShare")

  @@index([sourceProjectId])
  @@index([sourceOrganizationId])
  @@index([targetOrganizationId])
}

/// A secure project import run (DOMAIN_MODEL §2). Tracks the normative state
/// machine (RECEIVED → STAGING_ISOLATED → SCANNING → QUARANTINED →
/// AWAITING_USER_ACTION → COMMITTING → COMMITTED, with ROLLING_BACK / EXPIRED /
/// CANCELLED cleanup branches). `findings` holds REDACTED secret findings only
/// (never a raw value); `consent` records the per-finding keep/redact decision.
/// `targetProjectId` is assigned while the unique COMMITTING claimant creates
/// its target. It may therefore identify a partial target while cleanup is
/// pending; COMMITTED is the only state in which that target is user-visible.
model ImportJob {
  id                   String    @id @default(cuid())
  organizationId       String
  actorUserId          String?
  /// Client key, unique inside its tenant. This is the durable create authority.
  idempotencyKey       String
  /// SHA-256 of the non-secret request shape. Rejects key reuse for another input.
  requestHash          String
  /// One of the 12 hub tiles (github|bitbucket|vercel|figma|claude|bolt|lovable|base44|zip|spreadsheet|previous-agent-export|empty)
  provider             String
  state                String    @default("RECEIVED")
  sourceRef            String?
  /// ImportSecretFinding[] { path, line, kind, preview } — redacted, no value.
  findings             Json?
  /// ConsentDecision { "path:line": "keep"|"redact" }.
  consent              Json?
  /// Set by the COMMITTING claimant; cleared after verified rollback cleanup.
  targetProjectId      String?
  /// Disposable, server-only staging. Never returned by the public job endpoint.
  stagedFiles          Json?
  /// Whitelisted connector facts only; credentials and tokens are never stored.
  connectorPreview     Json?
  stagedFileCount      Int       @default(0)
  redactedCount        Int       @default(0)
  /// E-CODE DECISION (not Replit parity): idempotent credit reservation marker.
  creditsReserved      Boolean   @default(false)
  /// Optimistic concurrency fence for every state transition.
  version              Int       @default(0)
  /// Fencing token held by a commit/cleanup claimant across replicas.
  operationToken       String?
  /// Reaper may steal an orphaned claim only after this durable lease expires.
  operationExpiresAt   DateTime?
  /// Terminal state to publish after CLEANUP_PENDING has really removed its target.
  cleanupTerminalState String?
  error                String?
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization  Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor         User?                    @relation("ImportJobActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetProject Project?                 @relation("ImportJobTarget", fields: [targetProjectId], references: [id], onDelete: SetNull)
  /// Rolling-upgrade compatibility only. New imports reserve through LedgerReservation.
  reservation   ImportCreditReservation?

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([targetProjectId])
  @@index([state])
}

/// Legacy import credit hold retained only so jobs created before migration 0095
/// can finish or clean up during a rolling deployment. New imports use the
/// canonical double-entry LedgerReservation/Transaction/Entry lifecycle.
model ImportCreditReservation {
  id              String    @id @default(cuid())
  organizationId  String
  key             String
  importJobId     String    @unique
  reservedCredits Int
  debitedCredits  Int       @default(0)
  /// RESERVED | SETTLED | COMPENSATED
  state           String    @default("RESERVED")
  version         Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  importJob       ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
}

/// A curated public Gallery listing (TPL-02). Mirrors the CONFIRMED
/// replit.com/gallery surface: a browsable grid of published apps with an
/// author, public stats (views / uses), a category, a detail page, an outbound
/// "View App" link, and a Remix CTA.
///
/// CURATION, NOT SELF-SERVICE. Per DEC-GALLERY-NO-SELF-PUBLISH (Replit's
/// "Submit your App" is an external Typeform → human intake), rows are created
/// by a curator/seed, never by an in-product self-service Publish button. The
/// `status` gate is the curation boundary; only PUBLISHED rows are shown.
///
/// `sourceSnapshotId` pins the IMMUTABLE release a Remix reproduces — a
/// ProjectSnapshot archive of the source project taken at curation time. Remix
/// clones from THAT snapshot, so what a user forks matches the published
/// listing regardless of later edits to the source project.
model GalleryListing {
  id                  String    @id @default(cuid())
  slug                String    @unique
  title               String
  description         String
  category            String
  /// Free-form display tags (["react","stripe"]). Not a taxonomy.
  tags                String[]  @default([])
  /// PUBLISHED (visible) | PENDING_REVIEW (curated, not yet live) | UNPUBLISHED.
  status              String    @default("PUBLISHED")
  featured            Boolean   @default(false)
  sourceProjectId     String
  /// Immutable release pin — the ProjectSnapshot a Remix reproduces.
  sourceSnapshotId    String
  /// Curated author display (denormalized so a listing survives author changes).
  authorName          String
  authorUserId        String?
  /// Outbound "View App" link to the deployed app (may be null pre-deploy).
  appUrl              String?
  /// Card preview image (a real rendered screenshot). Root-relative static
  /// asset (/gallery-apps/<id>/thumbnail.png) or an https URL; null renders
  /// the text-only card.
  thumbnailUrl        String?
  /// FAIL-CLOSED (directive 20/07) : un projet publié ordinaire est
  /// ALL_RIGHTS_RESERVED, non-remixable. remixAllowed ne passe true qu'avec
  /// une licence EXPLICITE + confirmation des droits + politique PII acceptée.
  remixAllowed        Boolean   @default(false)
  /// License identifier declared at curation (e.g. an SPDX id like "MIT").
  /// Null = the author declared no license (surfaced as such — never invented).
  licenseId           String?
  /// VERSIONED license text snapshot captured at curation. What a remixer
  /// accepts is THIS text, pinned by its sha256 onto the RemixJob.
  licenseText         String?
  /// sha256 of licenseText — the version pin recorded on every remix.
  licenseTextSha256   String?
  /// Version of the PII-sharing consent the AUTHOR explicitly gave at curation
  /// (data ships unmasked). Null = no consent → PII is masked on every remix.
  piiConsentVersion   String?
  /// TRACE AUDITABLE des confirmations exigées pour rendre un listing remixable
  /// (P0-V3-05, réserve #8). Avant la migration 0081 elles étaient validées à la
  /// curation puis JAMAIS écrites : la confirmation des droits par le curateur
  /// était inauditable a posteriori. Horodatage + acteur (userId de l'admin qui
  /// a curé). Null = jamais confirmé.
  rightsConfirmedAt   DateTime?
  rightsConfirmedBy   String?
  piiPolicyAcceptedAt DateTime?
  piiPolicyAcceptedBy String?
  viewCount           Int       @default(0)
  useCount            Int       @default(0)
  createdAt           DateTime  @default(now())
  publishedAt         DateTime?

  sourceProject Project @relation("ProjectGalleryListings", fields: [sourceProjectId], references: [id], onDelete: Cascade)
  author        User?   @relation("UserGalleryListings", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([status, category])
  @@index([status, featured])
  @@index([status, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// CANONICAL DOUBLE-ENTRY LEDGER (C1 / P0-V3-12)
// Supersedes the single-entry CreditWallet.balanceCents "porte-monnaie". Every
// posted transaction balances per currency (Σ debits == Σ credits); posted
// transactions + entries are IMMUTABLE (DB triggers in migration 0078) — a
// correction is a NEW reversing transaction, never a mutation. Amounts are exact
// integer minor units (BigInt); FX is exact rational (num/den). No relation to
// Organization is declared (plain organizationId, like UsageReservation) to keep
// the migration self-contained.
// ─────────────────────────────────────────────────────────────────────────────

enum LedgerAccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
  EQUITY
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

enum LedgerReservationStatus {
  ACTIVE
  COMMITTED
  COMPENSATED
  RELEASED
  EXPIRED
}

enum LedgerReconciliationStatus {
  OK
  DISCREPANCY
}

model LedgerAccount {
  id             String            @id @default(cuid())
  organizationId String
  /// Stable account key: user_credits | reserved | revenue | provider_cost |
  /// fx_clearing | fx_rounding | tax_payable | refunds | budget_hold ...
  key            String
  type           LedgerAccountType
  currency       String
  createdAt      DateTime          @default(now())
  entries        LedgerEntry[]

  @@unique([organizationId, key, currency])
  @@index([organizationId])
}

model LedgerTransaction {
  id              String              @id @default(cuid())
  organizationId  String
  reason          String
  /// Idempotency key (unique per org when set). NULL rows are not deduped.
  idempotencyKey  String?
  /// Compensation: points at the original transaction this one reverses.
  reversalOfId    String?
  rateCardVersion Int?
  postedAt        DateTime            @default(now())
  metadata        Json?
  entries         LedgerEntry[]
  reversalOf      LedgerTransaction?  @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals       LedgerTransaction[] @relation("LedgerReversal")

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, postedAt])
  @@index([reversalOfId])
}

model LedgerEntry {
  id            String               @id @default(cuid())
  transactionId String
  accountId     String
  direction     LedgerEntryDirection
  /// Exact positive integer minor units (e.g. USD cents / micro-credits).
  amountMinor   BigInt
  currency      String
  transaction   LedgerTransaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account       LedgerAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([accountId, currency])
}

model LedgerReservation {
  id                      String                   @id @default(cuid())
  organizationId          String
  userId                  String?
  /// Idempotency key, unique per org: a replay returns the SAME reservation.
  idempotencyKey          String
  /// SHA-256 of the normalized business request. Reusing the key with another
  /// amount, tenant, user, operation, rate card or import job fails closed.
  requestHash             String?
  operation               String
  status                  LedgerReservationStatus  @default(ACTIVE)
  /// Optimistic fencing generation, incremented on every lifecycle transition.
  version                 Int                      @default(0)
  currency                String                   @default("usd")
  /// Authorized ceiling (hold, not a debit).
  maxAmountMinor          BigInt
  /// Actually settled at COMMIT (≤ maxAmountMinor).
  committedMinor          BigInt?
  rateCardVersion         Int?
  importJobId             String?
  /// Correlated ledger transactions across the lifecycle.
  reserveTxId             String?
  settleTxId              String?
  compensateTxId          String?
  expiresAt               DateTime
  committedAt             DateTime?
  releasedAt              DateTime?
  releaseReason           String?
  metadata                Json?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  reservedVmDeployment    Deployment?              @relation("DeploymentReservedVmBillingReservation")
  reservedVmOperation     ReservedVmOperation?     @relation("ReservedVmOperationBillingReservation")
  reservedVmBillingPeriod ReservedVmBillingPeriod? @relation("ReservedVmBillingPeriodLedgerReservation")

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([status, expiresAt])
  @@index([importJobId])
}

model LedgerFxRate {
  id           String    @id @default(cuid())
  fromCurrency String
  toCurrency   String
  /// Exact rational rate = rateNum / rateDen (no float).
  rateNum      BigInt
  rateDen      BigInt
  effectiveAt  DateTime
  /// Exclusive upper bound this rate is valid for (cutoff).
  cutoffAt     DateTime?
  createdAt    DateTime  @default(now())

  @@index([fromCurrency, toCurrency, effectiveAt])
}

model LedgerReconciliationRun {
  id               String                     @id @default(cuid())
  organizationId   String?
  /// GCP | STRIPE | LEDGER — the external source compared against the ledger.
  source           String
  status           LedgerReconciliationStatus
  discrepancyCount Int                        @default(0)
  discrepancies    Json?
  runAt            DateTime                   @default(now())
  metadata         Json?

  @@index([source, runAt])
}

// BLOCKER #5 — honest preview readiness. The in-preview reporter script detects a
// blank DOM / console error the server can never see and beacons it. Persisting
// it (vs the old fire-and-forget log) lets `/ports` readiness be honest across
// API replicas: a fresh blank/error beacon vetoes `ready` even when the port
// probe passed. `status`: 'ok' | 'blank' | 'error'. One row per (workspace,port),
// upserted; readiness only honours beacons newer than a short TTL.
model PreviewReadinessBeacon {
  id          String    @id @default(cuid())
  workspaceId String
  port        Int
  status      String
  detail      String?
  reportedAt  DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, port])
  @@index([workspaceId])
}

// BLOCKER #6 — timestamped workspace lifecycle machine. Append-only trail of
// PENDING->STARTING->RUNNING->STOPPING->STOPPED/FAILED transitions so a workspace
// that died can be reconstructed after the fact (vs Workspace.status, a single
// overwritten value). `state` is a WorkspaceLifecycleState; transitions are
// validated by assertWorkspaceLifecycleTransition before write.
model WorkspaceLifecycleEvent {
  id          String    @id @default(cuid())
  workspaceId String
  state       String
  reason      String?
  detail      Json?
  at          DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, at])
}

// BLOCKER #6 — post-mortem snapshot captured when a workspace stops/fails: the
// last-known ports, processes, Problems (beacons/diagnostics) and a tail of the
// runtime logs, frozen at shutdown. Append-only (one per stop), so a support
// operator can see WHY a preview was blank/dead after the pod is gone.
model WorkspacePostMortem {
  id          String    @id @default(cuid())
  workspaceId String
  reason      String
  finalState  String
  ports       Json?
  processes   Json?
  problems    Json?
  logsTail    String?
  capturedAt  DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, capturedAt])
}

// ─── CloudTenant / Project Factory / Platform IAM ────────────────────────────
// These rows are the durable control-plane record. External GCP effects are
// always driven through CloudOperation, whose DB-clock lease and fencing token
// make retries and takeover safe across API replicas.

enum CloudTenantBoundaryType {
  PERSON
  WORKSPACE
  LEGAL_ENTITY
  BILLING_ACCOUNT
}

enum CloudTenantLifecycle {
  PROVISIONING
  ACTIVE
  SUSPENDED
  MERGED
  CLOSED
}

enum CloudProjectBindingRole {
  PRIMARY
  REGION_SHARD
  QUOTA_SHARD
  MIGRATION_TARGET
}

enum CloudProjectBindingState {
  REQUESTED
  CREATING
  BILLING_LINKED
  APIS_ENABLING
  SERVICE_AGENTS_READY
  IAM_BOUND
  EDGE_READY
  ACTIVE
  BILLING_SUSPENDED
  QUOTA_EXHAUSTED
  DRIFT_DETECTED
  DELETE_REQUESTED
  RECOVERY_WINDOW
  RESTORING
  PURGING
  PURGED
}

enum CloudTenantTransferState {
  REQUESTED
  REVOKING
  REVOKED
  REGRANTING
  COMPLETED
  FAILED
}

enum CloudOperationKind {
  TENANT_CREATE
  PROJECT_BIND
  TENANT_SUSPEND
  TENANT_RESTORE
  TENANT_MERGE
  TENANT_SPLIT
  TENANT_TRANSFER
  PROJECT_ADVANCE
  TEARDOWN_REQUEST
  TEARDOWN_EXECUTE
  TEARDOWN_VERIFY
  PROJECT_RESTORE
  PROJECT_PURGE
  IAM_ENSURE
}

enum CloudOperationStatus {
  PENDING
  RUNNING
  WAITING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum CloudTeardownStatus {
  INVENTORYING
  DELETING
  VERIFYING
  COMPLETE
  ORPHANS_DETECTED
  FAILED
}

enum PlatformIamIdentityKind {
  BUILD
  PROMOTION
  RUNTIME
}

enum PlatformIamComplianceStatus {
  UNKNOWN
  COMPLIANT
  KEY_DRIFT
  DISABLED
}

model CloudTenant {
  id                   String                  @id @default(cuid())
  // Direct product-domain link. Null is reserved for platform/system tenants;
  // customer tenants are created with an Organization id by the admin API.
  organizationId       String?                 @unique
  customerBoundaryType CloudTenantBoundaryType
  ownerPrincipalId     String
  billingPrincipalId   String
  billingAccountId     String
  legalEntityId        String?
  residencyPolicy      String                  @default("eu")
  lifecycle            CloudTenantLifecycle    @default(ACTIVE)
  suspensionReason     String?
  suspensionEvidence   Json?
  // Version fences every topology mutation; ownershipVersion changes only
  // when ownership itself changes (transfer/merge/split provenance).
  version              Int                     @default(1)
  ownershipVersion     Int                     @default(1)
  mergedIntoTenantId   String?
  splitFromTenantId    String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  organization      Organization?         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  mergedInto        CloudTenant?          @relation("CloudTenantMerge", fields: [mergedIntoTenantId], references: [id], onDelete: Restrict)
  mergedSources     CloudTenant[]         @relation("CloudTenantMerge")
  splitFrom         CloudTenant?          @relation("CloudTenantSplit", fields: [splitFromTenantId], references: [id], onDelete: Restrict)
  splitChildren     CloudTenant[]         @relation("CloudTenantSplit")
  bindings          CloudProjectBinding[]
  transfers         CloudTenantTransfer[]
  operations        CloudOperation[]      @relation("CloudOperationTenant")
  relatedOperations CloudOperation[]      @relation("CloudOperationRelatedTenant")

  @@index([lifecycle])
  @@index([ownerPrincipalId])
}

model CloudProjectBinding {
  id                   String                   @id @default(cuid())
  cloudTenantId        String
  // Optional direct link to the published Vibecore project. A project can be
  // attached to at most one GCP binding, and the service verifies that its
  // Organization matches the tenant before committing the link.
  projectId            String?                  @unique
  gcpProjectId         String                   @unique
  gcpProjectNumber     String?                  @unique
  role                 CloudProjectBindingRole
  region               String
  state                CloudProjectBindingState @default(REQUESTED)
  parentFolderId       String?
  quotas               Json?
  billingLabels        Json?
  capacityPolicy       Json?
  reconciliationStatus String                   @default("UNKNOWN")
  recoveryWindowEndsAt DateTime?
  version              Int                      @default(1)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  tenant     CloudTenant                @relation(fields: [cloudTenantId], references: [id], onDelete: Restrict)
  project    Project?                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  events     CloudProjectFactoryEvent[]
  teardowns  CloudTeardownRecord[]
  identities PlatformIamIdentity[]
  operations CloudOperation[]

  @@index([cloudTenantId, state])
  @@index([state])
  @@index([parentFolderId])
}

model CloudProjectFactoryEvent {
  id          String   @id @default(cuid())
  bindingId   String
  operationId String?
  fromState   String?
  toState     String
  actorUserId String?
  detail      Json?
  createdAt   DateTime @default(now())

  binding   CloudProjectBinding @relation(fields: [bindingId], references: [id], onDelete: Restrict)
  operation CloudOperation?     @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@index([bindingId, createdAt])
  @@index([operationId])
}

model CloudOperation {
  id                String               @id @default(cuid())
  idempotencyKey    String               @unique
  requestHash       String
  kind              CloudOperationKind
  status            CloudOperationStatus @default(PENDING)
  tenantId          String?
  relatedTenantId   String?
  bindingId         String?
  actorUserId       String?
  reauthenticatedAt DateTime?
  step              String               @default("REQUESTED")
  payload           Json
  checkpoint        Json?
  result            Json?
  leaseOwner        String?
  leaseExpiresAt    DateTime?
  fence             Int                  @default(0)
  version           Int                  @default(0)
  attempts          Int                  @default(0)
  nextAttemptAt     DateTime             @default(now())
  lastErrorCode     String?
  lastErrorMessage  String?
  completedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  tenant            CloudTenant?               @relation("CloudOperationTenant", fields: [tenantId], references: [id], onDelete: Restrict)
  relatedTenant     CloudTenant?               @relation("CloudOperationRelatedTenant", fields: [relatedTenantId], references: [id], onDelete: Restrict)
  binding           CloudProjectBinding?       @relation(fields: [bindingId], references: [id], onDelete: Restrict)
  actor             User?                      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  events            CloudOperationEvent[]
  transfer          CloudTenantTransfer?
  factoryEvents     CloudProjectFactoryEvent[]
  requestedTeardown CloudTeardownRecord?

  @@index([status, nextAttemptAt])
  @@index([tenantId, createdAt])
  @@index([relatedTenantId, createdAt])
  @@index([bindingId, createdAt])
}

model CloudOperationEvent {
  id          String   @id @default(cuid())
  operationId String
  fence       Int
  type        String
  detail      Json?
  createdAt   DateTime @default(now())

  operation CloudOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@index([operationId, createdAt])
}

model CloudTenantTransfer {
  id                       String                   @id @default(cuid())
  operationId              String                   @unique
  cloudTenantId            String
  expectedOwnershipVersion Int
  fromPrincipalId          String
  toPrincipalId            String
  grantRoles               Json
  state                    CloudTenantTransferState @default(REQUESTED)
  revokeEvidence           Json?
  revokeVerifiedAt         DateTime?
  regrantEvidence          Json?
  version                  Int                      @default(0)
  errorCode                String?
  errorMessage             String?
  completedAt              DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  operation CloudOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  tenant    CloudTenant    @relation(fields: [cloudTenantId], references: [id], onDelete: Restrict)

  @@index([cloudTenantId, createdAt])
  @@index([state])
}

model CloudTeardownRecord {
  id                 String              @id @default(cuid())
  bindingId          String
  requestOperationId String              @unique
  status             CloudTeardownStatus @default(INVENTORYING)
  resourceInventory  Json?
  erasureProof       Json?
  orphans            Json?
  version            Int                 @default(0)
  startedAt          DateTime            @default(now())
  completedAt        DateTime?

  binding          CloudProjectBinding @relation(fields: [bindingId], references: [id], onDelete: Restrict)
  requestOperation CloudOperation      @relation(fields: [requestOperationId], references: [id], onDelete: Restrict)

  @@index([bindingId, startedAt])
}

model PlatformIamIdentity {
  id                     String                      @id @default(cuid())
  bindingId              String?
  kind                   PlatformIamIdentityKind
  app                    String                      @default("")
  environment            String                      @default("")
  privilegeBoundary      String
  gcpProjectId           String
  gcpServiceAccountEmail String                      @unique
  persistentKeys         Int                         @default(0)
  complianceStatus       PlatformIamComplianceStatus @default(UNKNOWN)
  revisionsServed        Int                         @default(0)
  version                Int                         @default(0)
  lastRotatedAt          DateTime?
  lastUsedAt             DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  binding        CloudProjectBinding?            @relation(fields: [bindingId], references: [id], onDelete: Restrict)
  impersonations PlatformIamImpersonationAudit[]

  @@unique([kind, app, environment, privilegeBoundary, gcpProjectId])
  @@index([gcpProjectId, kind])
  @@index([bindingId])
}

model PlatformIamImpersonationAudit {
  id                   String   @id @default(cuid())
  identityId           String
  actorPrincipal       String
  purpose              String
  tokenLifetimeSeconds Int
  createdAt            DateTime @default(now())

  identity PlatformIamIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)

  @@index([identityId, createdAt])
}

/// Durable, resumable execution plan for one account purge. The row deliberately
/// has no User foreign key: the receipt and effect history must outlive the
/// subject's anonymisation. Only one plan can ever target a subject.
model PurgePlan {
  id                  String             @id @default(cuid())
  userId              String             @unique
  ownerToken          String             @unique
  status              String             @default("ACTIVE")
  version             Int                @default(0)
  leaseExpiresAt      DateTime
  requestedAt         DateTime
  purgeDueAt          DateTime
  topologyFingerprint String
  inventory           Json
  correlationId       String?
  lastErrorCode       String?
  startedAt           DateTime           @default(now())
  completedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  freezes             PurgeFreeze[]
  effects             PurgeEffect[]
  receipt             PurgeReceipt?
  workspaceRuntimes   WorkspaceRuntime[]

  @@index([status, leaseExpiresAt])
  @@index([correlationId])
}

/// Per-plan ownership of topology freezes. A resource remains frozen while any
/// active plan owns a row for it; releasing one plan never thaws another.
model PurgeFreeze {
  id           String    @id @default(cuid())
  planId       String
  resourceType String
  resourceId   String
  createdAt    DateTime  @default(now())
  plan         PurgePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([resourceType, resourceId, planId])
  @@index([resourceType, resourceId])
  @@index([planId])
}

/// Durable idempotency receipt for every physical side effect. A succeeded key
/// is never executed twice by a resumed/reclaimed plan; failed effects retain a
/// bounded diagnostic and can be retried safely.
model PurgeEffect {
  id            String    @id @default(cuid())
  planId        String
  effectKey     String
  resourceType  String
  resourceId    String
  status        String    @default("PENDING")
  attempt       Int       @default(0)
  receipt       Json?
  lastErrorCode String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  plan          PurgePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, effectKey])
  @@index([planId, status])
  @@index([resourceType, resourceId])
}

/// Immutable proof written in the same transaction as the account tombstone.
/// Queue removal is allowed only after this row exists.
model PurgeReceipt {
  userId    String    @id
  planId    String    @unique
  purgedAt  DateTime
  proof     Json
  createdAt DateTime  @default(now())
  plan      PurgePlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([purgedAt])
}
