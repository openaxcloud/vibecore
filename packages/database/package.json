{
  "name": "@vibecore/database",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "prisma generate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "test": "echo \"database package tests are covered by services/api\"",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"database package lint covered by root\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
