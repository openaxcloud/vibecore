{
  "name": "E-Code.ai",
  "short_name": "E-Code",
  "lang": "en",
  "description": "AI-powered coding platform with governed workspaces, real runtimes, and deployment controls.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
