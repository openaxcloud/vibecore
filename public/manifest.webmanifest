{
  "name": "E-Code.ai",
  "short_name": "E-Code",
  "description": "AI-powered coding platform with governed workspaces, real runtimes, and deployment controls.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "background_color": "#0D0D0D",
  "theme_color": "#F26207",
  "orientation": "any",
  "icons": [
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/ecode-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "url": "/dashboard"
    },
    {
      "name": "Projects",
      "url": "/projects"
    },
    {
      "name": "New project",
      "url": "/projects/new"
    }
  ]
}
