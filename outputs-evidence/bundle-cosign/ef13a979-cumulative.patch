   HELM_NAMESPACE: vibecore
 
 jobs:
+  # B6 — gates that must pass BEFORE anything is built or rolled out.
+  #
+  # security.yaml already runs gitleaks on push/PR, but that is a *separate*
+  # workflow: a red run there does not stop this one, so a secret could still
+  # ride into production. This job puts the same check on the deploy path
+  # itself, where failing it actually prevents the rollout.
+  preflight-gates:
+    name: Preflight gates (secrets + pipeline policy, blocking)
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Install gitleaks
