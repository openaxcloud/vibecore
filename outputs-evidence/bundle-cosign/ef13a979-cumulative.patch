+            | tar -xz -C /tmp gitleaks
+          sudo install /tmp/gitleaks /usr/local/bin/gitleaks
+          gitleaks version
+
+      - name: Secret scan (blocking)
+        run: |
+          set -euo pipefail
+          gitleaks detect \
+            --no-git \
+            --source . \
+            --config .gitleaks.toml \
+            --redact \
+            --no-banner \
+            --exit-code 1
+
+      # Policy gate: the image-signing steps are what make the Kyverno admission
+      # policy satisfiable. If someone deletes or renames them, builds keep
+      # succeeding and the failure only surfaces later as pods refused at
+      # admission — during a rollout, at the worst possible moment. Assert here
+      # instead, where the error is obvious and cheap.
+      # The validator parses the step structure rather than grepping it. A
+      # line-range grep here is actively dangerous: an awk range like
+      # /id: sign-image/,/^  - id: [^s]/ never closes when the following step
+      # also starts with "s" (scan-images), so it swallows that step's
+      # `allowFailure: true` and the gate fails on a perfectly good tree.
+      # The validator is HERMETIC — pure Python 3 stdlib, no PyYAML — so the gate
+      # never depends on a dependency that happens to be preinstalled on the
+      # runner. --self-test first proves the parser itself before it is trusted.
+      - name: Pipeline policy — image signing must still be wired
+        run: |
+          set -euo pipefail
+          python3 scripts/validate-image-signing-wired.py --self-test
+          python3 scripts/validate-image-signing-wired.py
+
