+        digest_ref="$(docker inspect --format='{{index .RepoDigests 0}}' "$ref")"
+        bash scripts/cosign-sign-images.sh "$digest_ref"
+
+  # ---- 4. vulnerability scan (non-blocking) ----
   - id: scan-image
     name: gcr.io/google.com/cloudsdktool/cloud-sdk:slim
     waitFor: ['build-workspace-agent']
