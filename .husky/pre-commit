#!/bin/sh

echo "🔍 Running pre-commit hook to check the code looks good... 🔍"

# Load NVM if available (useful for managing Node.js versions)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# Ensure `pnpm` is available
echo "Checking if pnpm is available..."
if ! command -v pnpm >/dev/null 2>&1; then
    echo "❌ pnpm not found! Please ensure pnpm is installed and available in PATH."
    exit 1
fi

# ── Secret gate (fail fast, before the slow checks) ─────────────────────────
# 1) Never commit a real .env* file — only *.example templates are allowed.
echo "Scanning staged changes for secrets..."
staged_env="$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '(^|/)\.env($|\.)' \
  | grep -vE '\.example$' || true)"
if [ -n "$staged_env" ]; then
    echo "❌ Refusing to commit environment file(s) that may hold secrets:"
    echo "$staged_env" | sed 's/^/     - /'
    echo "   Only *.example templates belong in git. Unstage them:"
    echo "     git rm --cached <file>   # keeps your local copy"
    exit 1
fi

# 2) Run gitleaks on the staged diff when available (hard block on findings).
#    Not every machine has gitleaks installed; when absent we warn (CI has a
#    blocking gitleaks job as the backstop) rather than block the commit.
if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks protect --staged --redact --no-banner --config .gitleaks.toml; then
        echo "❌ gitleaks found a potential secret in your staged changes."
        echo "   Remove it (and rotate the credential if it was ever real) before committing."
        exit 1
    fi
else
    echo "⚠️  gitleaks not installed — skipping local secret scan (CI will still block)."
    echo "   Install: https://github.com/gitleaks/gitleaks#installing (e.g. 'brew install gitleaks')."
fi

# Run typecheck — scoped to the tiers whose files are actually staged, so a commit
# touching only e.g. services/api no longer pays for the ~10-min web-app type-check
# (which timed out under load and forced --no-verify). CI runs the FULL `pnpm
# typecheck` across every tier, so cross-tier breaks are still caught before merge.
echo "Running typecheck (staged tiers)..."
if ! pnpm typecheck:changed; then
    echo "❌ Type checking failed! Please review TypeScript types."
    echo "Once you're done, don't forget to add your changes to the commit! 🚀"
    exit 1
fi

# Run lint
echo "Running lint..."
if ! pnpm lint; then
    echo "❌ Linting failed! Run 'pnpm lint:fix' to fix the easy issues."
    echo "Once you're done, don't forget to add your beautification to the commit! 🤩"
    exit 1
fi

echo "👍 All checks passed! Committing changes..."
